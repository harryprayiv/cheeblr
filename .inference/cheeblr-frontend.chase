  , paymentApproved          :: Boolean
  , paymentAuthorizationCode :: Maybe String
  }

type RefundTransaction =
  { refundId                     :: UUID
  , refundCreated                :: DateTime
  , refundCompleted              :: DateTime
  , refundCustomerId             :: Maybe UUID
  , refundEmployeeId             :: UUID
  , refundRegisterId             :: UUID
  , refundLocationId             :: UUID
  , refundItems                  :: Array Item
  , refundPayments               :: Array Payment
  , refundSubtotal               :: RefundMoney
  , refundDiscountTotal          :: RefundMoney
  , refundTaxTotal               :: RefundMoney
  , refundTotal                  :: RefundMoney
  , refundReferenceTransactionId :: UUID
  , refundReason                 :: String
  , refundNotes                  :: Maybe String
  }

%decision RefundMoneyNegativeRefundQuantityNot
  what:    Refund amounts are RefundMoney (zero or negative cents); refund line quantities are RefundQuantity (zero or more)
  why:     The backend negates every money field of the sale and keeps each line's quantity and unit price as they were. itemPricePerUnit is SaleMoney for that reason. test/Wire.purs decodes a backend-shaped refund.

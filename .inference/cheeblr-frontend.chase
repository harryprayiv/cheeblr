%untested urlRe

type Parser a = String -> Either String a

anyText :: Parser String
  ~ called by: UI.Inventory.ItemForm.menuItemForm

trimmed :: Parser String
  ~ no callers in scanned roots

required :: Parser String
  ! trims; Left "Required" when blank

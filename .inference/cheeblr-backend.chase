=== BEGIN DB/Auth.hs ===

%file /home/bismuth/git/cheeblr/backend/src/DB/Auth.hs
%mod DB.Auth

%ext DataKinds, DisambiguateRecordFields, OverloadedStrings, ScopedTypeVariables

%uses Crypto.Error
%uses qualified Crypto.KDF.Argon2 as Argon2
%uses Data.ByteArray.Encoding
%uses Data.ByteString
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses Data.Time
%uses Data.UUID
%uses Data.UUID.V4
%uses qualified Hasql.Session as Session
%uses Rel8
%uses System.Entropy
%uses DB.Database
%uses DB.Schema
%uses Types.Auth
%uses Types.Location
%uses Types.Primitives.Token

data NewUser = NewUser
  { newUserName    :: Text
  , newDisplayName :: Text
  , newEmail       :: Maybe Text
  , newRole        :: UserRole
  , newLocationId  :: Maybe LocationId
  , newPassword    :: Text
  }

argonOpts :: Argon2.Options
  ! iterations=3, memory=64MiB, parallelism=4, Argon2id v1.3
  ! tuning is deliberate; lowering requires re-running threat model
  ? no test references

argonOutputLen :: Int
  ? no test references

b64Enc :: ByteString -> Text
  ! standard base64 with trailing '=' stripped
  ! asymmetric with b64Dec, which re-pads on decode
  ? no test references

b64Dec :: Text -> Either String ByteString
  ? no test references

buildPHC :: ByteString -> ByteString -> Text
  ! PHC format: $argon2id$v=19$m=...,t=...,p=...$<salt>$<hash>
  ! params come from argonOpts at hash time; mixing old hashes with new param sets requires migration since verifyPassword does NOT read params from PHC
  ? no test references

hashPassword :: Text -> IO Text
  ! intent: Hash plaintext with Argon2id and return PHC-formatted output
  ! effects: Entropy, IO
  ! 16-byte salt from getEntropy (kernel-backed CSPRNG)
  ! throws via throwCryptoErrorIO on argon2 failure; no Maybe path
  ! synchronous, ~100ms+ on commodity hardware (do not call on hot paths)
  ! spec: h <- hashPassword "hunter2"; verifyPassword h "hunter2" => True
  ! spec: h <- hashPassword "hunter2"; verifyPassword h "wrong" => False
  > consumed by: DB.Auth.createUser (initial credential)
  > consumed by: Server.Auth.createUserHandler (admin user creation)
  > consumed by: app/Bootstrap.hs (one-shot admin)
  ? no test references

verifyPassword :: Text -> Text -> Bool
  ! intent: Pure: parse PHC, recompute Argon2id with embedded salt and project's argonOpts, compare to embedded hash
  ! comparison via ByteString Eq; not explicitly time-hardened
  ! returns False silently on malformed PHC string; no exception
  ! returns False on argon2 failure; no exception
  ! parameters are NOT read from the PHC string. argonOpts is fixed at module level. Changing argonOpts invalidates all existing hashes.
  > consumed by: Server.Auth.loginHandler (only password verifier in production)
  ? no test references

userRowToAuthUser :: UserRow Result -> AuthenticatedUser
  ? no test references

createAuthTables :: DBPool -> IO ()
  ! intent: Idempotent DDL for users, sessions, login_attempts
  ! effects: DBPool, IO
  ! CREATE TABLE IF NOT EXISTS, CREATE INDEX IF NOT EXISTS
  ! ALTER TABLE for token_rotated_at runs on every startup including fresh DBs (no-op then)
  ! creates partial index on token_hash WHERE NOT revoked
  ! no cleanup index on login_attempts; that table grows unbounded
  > consumed by: App.runWithEnv (called on every startup)
  ? no test references

createUser :: DBPool -> NewUser -> IO UUID
  ! intent: Insert a new user with a hashed password
  ! effects: DBPool, Entropy, IO
  ! calls hashPassword (synchronous Argon2; ~100ms+)
  ! Abort on conflict: throws if username already exists
  ! no email uniqueness constraint at DB level
  ! newPassword is plaintext in NewUser; do not log it
  > consumed by: Server.Auth.createUserHandler
  > consumed by: app/Bootstrap.hs
  ? no test references

lookupUserByUsername :: DBPool -> Text -> IO (Maybe (UserRow Result))
  ! filters on isActive; deactivated users are invisible to login
  ! returns Nothing for 0 rows OR multiple rows (defensive against duplicate-row scenarios)
  > consumed by: Server.Auth.loginHandler (called BEFORE password verification)
  ? no test references

createSession ::
  DBPool ->
  UUID ->
  Maybe UUID ->
  Text ->
  Text ->
  IO (SessionToken, UTCTime)
  ! intent: Create a new session row with an 8h expiry, return raw token
  ! effects: DBPool, Entropy, IO
  ! 32 random bytes via Types.Primitives.Token.generateSessionToken (getEntropy underneath)
  ! expires_at = now + 8h, HARDCODED; cfgSessionTtlSeconds is NOT consulted here
  ! raw SessionToken returned to caller; only sessionTokenHashText (SHA-256 base64url) stored in DB
  ! tokenRotatedAt initialized to now
  ! spec: createSession pool uid Nothing "agent" "1.2.3.4" => (token, now + 8h)
  > consumed by: Server.Auth.loginHandler (called on successful credential verification, response carries Set-Cookie cheeblr_session)
  ? no test references

lookupSession ::
  DBPool ->
  SessionToken ->
  IO (Maybe (SessionRow Result, UserRow Result))
  ! intent: Resolve a raw SessionToken to (SessionRow, UserRow) and bump last_seen_at
  ! effects: DBPool, IO
  ! hashes the supplied SessionToken via Types.Primitives.Token.hashSessionToken before lookup
  ! SIDE EFFECT: updates last_seen_at on every successful lookup (write-on-read)
  ! returns Nothing on multi-row result (defensive against hash collision)
  ! filters on NOT revoked AND expires_at > now AND user.isActive
  ! called on every authenticated request via cookieAuthMiddleware; budget the write accordingly
  ! spec: lookupSession pool validToken => Just (sessRow, userRow)
  ! spec: lookupSession pool revokedToken => Nothing
  ! spec: lookupSession pool expiredToken => Nothing
  ! spec: lookupSession pool malformedToken => Nothing
  > consumed by: App.cookieAuthMiddleware (every authenticated request — hot path)
  > consumed by: Server.Auth.meHandler
  > consumed by: Server.Auth.logoutHandler
  > consumed by: Server.Admin.buildSessionInfos via SessionInfo.siLastSeen rendered in admin sessions panel
  > consumed by: the last_seen_at write specifically: any worker reading idle sessions for revocation
  ? no test references

getSessionRotatedAt :: DBPool -> SessionToken -> IO (Maybe (UUID, UTCTime))
  ! read-only check of when a session's token was last rotated
  ! does NOT update last_seen_at (lookupSession owns that)
  ! exists separately from lookupSession to avoid write amplification on every rotation check
  > consumed by: App.checkAndRotate (decides whether to rotate without re-bumping last_seen_at)
  ? no test references

rotateSessionToken :: DBPool -> UUID -> IO (SessionToken, UTCTime)
  ! intent: Mint a new opaque token for an existing session, invalidate the old one immediately
  ! effects: DBPool, Entropy, IO
  ! issues new 8h expiry, HARDCODED; cfgSessionTtlSeconds ignored here too
  ! old token hash overwritten; old token invalid immediately
  ! race: concurrent rotation requests may collide on tokenHash UNIQUE constraint; not handled
  > consumed by: App.checkAndRotate (called from cookieAuthMiddleware)
  > consumed by: the new token is written to the response as Set-Cookie cheeblr_session
  ? no test references

cleanupExpiredSessions :: DBPool -> IO ()
  ! deletes expired sessions AND revoked sessions older than 24h
  ! the 24h grace window is HARDCODED, not driven by config
  ! called from sessionCleanupWorker in App.hs
  > consumed by: App.sessionCleanupWorker (forked thread, runs every cfgSessionCleanupIntervalHours)
  ? no test references

revokeSession :: DBPool -> UUID -> Maybe UUID -> IO ()
  ! soft-delete: sets revoked=true; row remains for audit
  ! actual deletion happens in cleanupExpiredSessions after 24h grace
  > consumed by: Server.Auth.logoutHandler
  ? no test references

revokeAllUserSessions :: DBPool -> UUID -> IO ()
  ! one Rel8 update on sessionSchema setting sessRevoked = True and sessRevokedAt = getCurrentTime
  ! updateWhere skips rows whose sessRevoked is already True, so earlier sessRevokedAt timestamps are preserved
  > consumed by: no current handler calls this; intended for future password-change/admin-disable flows
  ? no test references

recordLoginAttempt :: DBPool -> Text -> Text -> Bool -> IO ()
  ! inserts one loginAttemptSchema row per call, with attemptId from nextRandom and attemptedAt from getCurrentTime; onConflict = Abort
  ! nothing deletes these rows, so the table grows with every login attempt
  > consumed by: Server.Auth.loginHandler (success AND failure paths)
  > consumed by: DB.Auth.recentFailedAttempts reads what this writes
  > consumed by: DB.Auth.recentFailedAttemptsByIp reads what this writes
  ? no test references

recentFailedAttempts :: DBPool -> Text -> Text -> NominalDiffTime -> IO Int
  ! counts failed attempts where username AND ip both match within window
  ! different from recentFailedAttemptsByIp (ip-only)
  > consumed by: Server.Auth.checkLoginRateLimit (per-credential tier)
  ? no test references

recentFailedAttemptsByIp :: DBPool -> Text -> NominalDiffTime -> IO Int
  > consumed by: Server.Auth.checkLoginRateLimit (per-IP tier)
  ? no test references

getSessionById :: DBPool -> UUID -> IO (Maybe (SessionRow Result))
  ? no test references

listActiveSessions :: DBPool -> IO [(SessionRow Result, UserRow Result)]
  ? no test references

clearRateLimitForIp :: DBPool -> Text -> IO ()
  ! DELETE, not soft delete
  ! wipes ALL attempts for the IP including successful ones (loses audit data)
  ! admin-only operation; bypasses limits by removing data, not by whitelisting
  ? no test references

%decision OpaqueRotatingSessionTokens
  what:    PostgreSQL-backed opaque tokens with per-request rotation check
  why:     JWTs cannot be revoked without a denylist, defeating their statelessness benefit. PostgreSQL is already in the stack, so opaque server-side tokens add no infrastructure. Rotation is lazy: cookieAuthMiddleware checks token_rotated_at on every authenticated request and rotates if older than cfgTokenRotationSecs. Old token is invalidated immediately on rotation; no grace window. Concurrent in-flight requests race; acceptable for POS where retries are immediate.
  affects: createSession, lookupSession, rotateSessionToken, getSessionRotatedAt

%decision Argon2idWithFixedParameters
  what:    Argon2id m=65536 t=3 p=4, 32-byte output, 16-byte salt, PHC-encoded
  why:     OWASP-recommended default for new password hashing. Parameters tuned for Raspberry Pi 5 + Postgres production target. Parameters are NOT read from the PHC string at verify time. argonOpts is a global constant; changing it silently invalidates every existing hash.
  affects: argonOpts, hashPassword, verifyPassword, buildPHC

%decision HardcodedSessionTtl
  what:    8h expiry hardcoded in createSession AND rotateSessionToken
  why:     AppConfig.cfgSessionTtlSeconds is loaded but never threaded here. Setting SESSION_TTL_SECS env var has no effect on actual session lifetime. Either thread the config through (preferred) or delete the dead config key.
  affects: createSession, rotateSessionToken



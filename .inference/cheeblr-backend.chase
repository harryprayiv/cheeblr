  ! sale id and created timestamp are generated here; totals start at zero; saleKind is StandardSale
  > consumed by: Server.SaleCommand POST /pos/sale
  ~ called by: Server.SaleCommand.saleCommandServer
  ? tested by: Test.Service.SaleSpec.spec

addItem ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EffInv.InventoryDb :> es
  , TaxRules :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  AddItemRequest ->
  Eff es Sale.SaleTransaction
  ! intent: Price a line on the server and add it to the sale
  ! effects: TransactionDb, StockDb, InventoryDb, TaxRules, EventEmitter, Clock, GenUUID, Error ServerError
  ! the request carries the quantity to add; the whole line is repriced at the CURRENT menu price and the tax rules in force NOW, for all its units
  ! 404 unknown sale or SKU; 400 bad quantity or insufficient stock; 409 closed sale; 500 undecodable tax rule
  ! the first nextUUID call is the id a new line would take (Test.Service.SaleSpec relies on this)
  > consumed by: Server.SaleCommand POST /pos/sale/item
  ~ called by: Server.SaleCommand.saleCommandServer
  ? tested by: Test.Service.SaleSpec.afterAdd, Test.Service.SaleSpec.spec


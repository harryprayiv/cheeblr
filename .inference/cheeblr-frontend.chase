%uses Prelude
%uses Data.Either

%untested fromEither

data RemoteData a
  = NotAsked
  | Loading
  | Failure String
  | Success a

derive instance Eq a => Eq (RemoteData a)

derive instance Functor RemoteData

fromEither :: forall a. Either String a -> RemoteData a
  ~ no callers in scanned roots

%decision OneRemoteDataType
  what:    RemoteData a = NotAsked | Loading | Failure String | Success a replaces the per-page SnapshotStatus, ActivityStatus and ReportStatus ADTs
  why:     Failure carries text. UI.Remote.useRemote fills it with API.Request.describe of the error. Pages.CreateTransaction keeps its own status type because it has extra cases. fromEither has no caller now.
  affects: fromEither



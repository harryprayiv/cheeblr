  UUID ->
  Text ->
  Eff es (Either InventoryException Sale.SaleTransaction)
  ~ called by: Service.Transaction.voidTx
  ? tested by: Test.Service.TransactionSpec.spec

writeRefund ::
  (TransactionDb :> es) =>
  Refund.RefundTransaction ->
  Eff es (Either InventoryException Refund.RefundTransaction)
  ~ called by: Service.Transaction.refundTx

clearSale :: (TransactionDb :> es) => UUID -> Eff es (Either InventoryException ())
  ~ called by: Service.Sale.clear
  ? tested by: Test.Service.TransactionSpec.spec

finalizeSale ::
  (TransactionDb :> es) =>
  UUID ->
  Eff es (Either InventoryException Sale.SaleTransaction)
  ~ called by: Service.Transaction.finalizeTx
  ? tested by: Test.Service.TransactionSpec.spec

addSaleItem ::
  (TransactionDb :> es) =>
  SaleLineAdd ->
  Eff es (Either InventoryException SaleLineAdded)
  ~ called by: Service.Transaction.addItem
  ? tested by: Test.Service.TransactionSpec.spec

deleteSaleItem ::
  (TransactionDb :> es) =>
  UUID ->
  Eff es (Either InventoryException ())
  ~ called by: Service.Transaction.removeItem
  ? tested by: Test.Service.TransactionSpec.spec


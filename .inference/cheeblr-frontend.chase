  ! Defined as SaleQuantity 1 for ergonomic comparison; the most common single-unit cart addition value.
  ~ no callers in scanned roots

addSaleQuantity :: SaleQuantity -> SaleQuantity -> SaleQuantity
  ~ called by: Types.Primitives.Quantity.sumSaleQuantity

subtractSaleQuantity :: SaleQuantity -> SaleQuantity -> Maybe SaleQuantity
  ! Returns Maybe SaleQuantity; subtracting more than available yields Nothing.
  ! Use case: removing items from a cart line cannot reduce qty below zero.
  ~ no callers in scanned roots


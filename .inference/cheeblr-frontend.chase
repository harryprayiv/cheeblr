%untested registerKey, chosenRegisterId, chooseRegister, newRegister

registerKey :: String
  ~ called by: Services.RegisterService.chosenRegisterId, Services.RegisterService.chooseRegister

chosenRegisterId :: Effect (Maybe UUID)
  ! Nothing when the key is absent or does not parse as a UUID.
  ! Does not check that the register is known to the backend; Pages.CreateTransaction.load does.
  ~ called by: Pages.CreateTransaction.load, Pages.Registers.page

chooseRegister :: UUID -> Effect Unit
  ~ called by: Pages.Registers.page

newRegister :: String -> UUID -> Effect Register
  ! Builds a closed register with a fresh id and zero drawer amounts for API.Register.createRegister. Makes no request.
  ~ called by: Pages.Registers.page

%decision RegisterIdInLocalStorage
  what:    The id of the register this browser sells on is kept in localStorage under the key 'register_id'
  why:     A till is identified by the device, not by who is signed in. The id is written only by chooseRegister, from the 'Use on this device' button on Pages.Registers. Nothing generates one. The key is the one the app has always used, so a browser that already had a register keeps it.
  affects: chosenRegisterId, chooseRegister



%mod Types.Primitives.Token

%ext DerivingStrategies, GeneralizedNewtypeDeriving, OverloadedStrings

%uses Crypto.Hash
%uses Data.ByteArray
%uses qualified Data.ByteArray.Encoding as BAE
%uses Data.ByteString
%uses qualified Data.ByteString as BS

%abstract SessionToken  hidden: SessionToken  made by: generateSessionToken, mkSessionToken
%abstract SessionTokenHash  hidden: SessionTokenHash  made by: hashSessionToken, unsafeSessionTokenHash

%untested generateSessionToken, hashSessionToken, sessionTokenHashText, unsafeSessionTokenHash, stripPad, rePad

newtype SessionToken = SessionToken ByteString
  deriving stock (Eq)

instance Show SessionToken where

newtype SessionTokenHash = SessionTokenHash Text
  deriving stock (Eq)
  deriving newtype (Ord)

instance Show SessionTokenHash where

generateSessionToken :: IO SessionToken
  ~ literals: 32
  ~ called by: DB.Auth.createSession, DB.Auth.rotateSessionToken

mkSessionToken :: Text -> Maybe SessionToken
  ~ literals: 32
  ~ called by: Auth.Session.resolveSession, App.extractCookieToken
  ? tested by: Test.Server.CookieSpec.sampleToken1, Test.Server.CookieSpec.sampleToken2, Test.App.MiddlewareSpec.sampleToken

revealSessionToken :: SessionToken -> Text
  ~ clause: (SessionToken bs)
  ~ called by: Server.Cookie.sessionCookie, App.cookieAuthMiddleware
  ? tested by: Test.Server.CookieSpec.sampleTokenText1, Test.App.MiddlewareSpec.sampleTokenText

hashSessionToken :: SessionToken -> SessionTokenHash
  ~ clause: (SessionToken bs)
  ~ called by: DB.Auth.createSession, DB.Auth.lookupSession, DB.Auth.getSessionRotatedAt, DB.Auth.rotateSessionToken

sessionTokenHashText :: SessionTokenHash -> Text
  ~ clause: (SessionTokenHash h)
  ~ called by: DB.Auth.createSession, DB.Auth.lookupSession, DB.Auth.getSessionRotatedAt, DB.Auth.rotateSessionToken

unsafeSessionTokenHash :: Text -> SessionTokenHash
  ~ no callers in scanned roots

stripPad :: Text -> Text
  ~ literals: '='
  ~ called by: Types.Primitives.Token.revealSessionToken

rePad :: Text -> Text
  ~ literals: 4, "="
  ~ called by: Types.Primitives.Token.mkSessionToken



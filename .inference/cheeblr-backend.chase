%file /home/bismuth/git/cheeblr/backend/src/App.hs
%mod App

%ext OverloadedStrings, ScopedTypeVariables

%uses Control.Concurrent
%uses Control.Concurrent.STM
%uses Control.Exception
%uses qualified Data.ByteString.Builder as B
%uses qualified Data.ByteString.Char8 as B8
%uses qualified Data.CaseInsensitive as CI
%uses qualified Data.Map.Strict as Map
%uses Data.Maybe
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses Data.Time
%uses Katip
%uses Network.HTTP.Types.Header
%uses Network.HTTP.Types.Method
%uses Network.HTTP.Types.Status
%uses Network.TLS
%uses Network.Wai
%uses qualified Network.Wai.Handler.Warp as Warp
%uses Network.Wai.Handler.WarpTLS
%uses Network.Wai.Middleware.Cors
%uses Servant
%uses System.Directory
%uses System.IO
%uses Web.Cookie
%uses Config.App
%uses Config.BuildInfo
%uses DB.Auth
%uses DB.Database
%uses DB.Events
%uses DB.Stock
%uses DB.TaxRule
%uses DB.Transaction
%uses Infrastructure.AvailabilityRelay
%uses Infrastructure.AvailabilityState
%uses Infrastructure.Broadcast
%uses Logging
%uses Logging.BroadcastScribe
%uses Server
%uses Server.Cookie
%uses Server.Env
%uses Server.Metrics
%uses Server.Middleware.Tracing
%uses Types.Events.Availability
%uses Types.Events.Domain
%uses Types.Events.Log
%uses Types.Events
%uses Types.Location
%uses Types.Primitives.Token
%uses Types.Public.AvailableItem

%untested run, buildEnv, runWithEnv, checkAndRotate, sessionCleanupWorker, securityHeadersMiddleware, handleOptionsMiddleware, reflectOriginMiddleware
%untested toDBConfig

run :: IO ()
  ~ no callers in scanned roots

buildEnv :: AppConfig -> IO AppEnv
  ! intent: Allocate runtime resources (broadcasters, metrics, log env, DB pool, availability state)
  ! effects: IO
  ! creates 4 broadcasters, 1 metrics record, 1 availability TVar
  ! initializes Katip BEFORE the DB pool; smoke-test failures predate broadcast scribe registration
  ! envLogNS = mempty at construction; per-component namespaces added at log call sites
  > consumed by: App.run (called once at startup)
  ~ called by: App.run

runWithEnv :: AppEnv -> IO ()
  ! intent: Wire the WAI middleware stack and run Warp with optional TLS
  ! effects: IO
  ! creates ALL DB tables on every startup (idempotent)
  ! registers broadcast scribe AFTER initLogging; first startup messages do not reach the broadcaster
  ! forks AvailabilityRelay; if it dies, prints to stderr and continues degraded
  ! forks sessionCleanupWorker; first cleanup runs after intervalHours, NOT immediately
  ! TLS fallback is silent: USE_TLS=true with missing cert/key drops to HTTP and continues
  ~ literals: "broadcast", "s", "x-requested-with", "x-user-id", 86400, "*"
  ~ called by: App.run

cookieAuthMiddleware :: DBPool -> Data.Time.NominalDiffTime -> Middleware
  ! intent: Lift cheeblr_session cookie to Authorization: Bearer header, lazily rotate stale tokens
  ! effects: DBPool, IO
  ! synthesizes Authorization: Bearer <token> BEFORE calling the inner app
  ! if the token rotates mid-request, prepends Set-Cookie to the response
  ! called on EVERY request, including OPTIONS and unauthenticated routes
  ! no-op when no cheeblr_session cookie is present
  ! blindly overwrites any client-supplied Authorization header
  ! spec: request without cookie => passes through unchanged
  ! spec: request with fresh cookie => Authorization: Bearer <token> injected, no Set-Cookie
  ! spec: request with stale cookie => Authorization: Bearer <newToken> injected, Set-Cookie: cheeblr_session=<newToken>
  > consumed by: ALL Servant routes that use the existing Maybe Text bearer extraction
  > consumed by: downstream handlers see Authorization: Bearer; they cannot tell whether it came from a header or a cookie
  ~ literals: "Set-Cookie"
  ~ called by: App.runWithEnv
  ? tested by: Test.App.MiddlewareSpec.noCookieMiddleware

extractCookieToken :: Request -> Maybe SessionToken
  ! reads from Cookie request header only (not query string, not body)
  ! tolerates other cookies in the same header; cheeblr_session selected by name
  > consumed by: App.cookieAuthMiddleware (only caller)
  ~ literals: "Cookie", "cheeblr_session"
  ~ called by: App.cookieAuthMiddleware
  ? tested by: Test.App.MiddlewareSpec.spec

checkAndRotate
  :: DBPool
  -> Data.Time.NominalDiffTime
  -> SessionToken
  -> IO (Maybe (SessionToken, Data.Time.UTCTime))
  ! issues a new token if (now - tokenRotatedAt) > threshold
  ! does NOT update last_seen_at (lookupSession owns that)
  ! returns Nothing if the session is missing (caller treats as 'no rotation needed')
  ! race: two concurrent requests can both rotate; second wins, first response carries a stale token
  > consumed by: App.cookieAuthMiddleware (only caller)
  ~ called by: App.cookieAuthMiddleware

sessionCleanupWorker :: DBPool -> Int -> IO ()
  ! first iteration waits intervalHours then cleans; never runs at startup
  ! exceptions caught and printed to stderr; loop continues
  ! intervalHours is in HOURS; multiplied by 3600 internally
  ~ literals: 3600, 1000000
  ~ called by: App.runWithEnv

buildCsp :: T.Text -> Maybe T.Text -> T.Text
  ! intent: Pure: build the Content-Security-Policy header value
  ! default-src/script-src/style-src all 'self' (no inline, no eval)
  ! img-src defaults to 'https:' if cfgImgSrcDomain is Nothing
  ! rewrites https:// to wss:// (and http:// to ws://) for connect-src
  ! frame-ancestors 'none' (cannot be embedded as iframe)
  ! spec: buildCsp "https://api.example.com" Nothing => ...connect-src 'self' https://api.example.com wss://api.example.com...
  ! spec: buildCsp "http://localhost:8080" (Just "https://cdn.example.com") => ...img-src 'self' data: https://cdn.example.com...
  > consumed by: App.securityHeadersMiddleware
  ~ literals: "https:", "https://", "wss://", 8, "http://", "ws://", +1 more
  ~ called by: App.securityHeadersMiddleware
  ? tested by: Test.App.CspSpec.spec

securityHeadersMiddleware :: T.Text -> Maybe T.Text -> Middleware
  ! appends headers via response header list (<>); does not overwrite if already present
  ! HSTS, X-Content-Type-Options, X-Frame-Options DENY, Referrer-Policy, CSP all set unconditionally
  ! HSTS max-age=1y with includeSubDomains; do NOT enable in production until the domain is final
  ~ literals: "nosniff", "X-Frame-Options", "DENY", "Referrer-Policy"
  ~ called by: App.runWithEnv

handleOptionsMiddleware :: Maybe T.Text -> Middleware
  ! short-circuits OPTIONS with status 200 BEFORE reaching application logic
  ! Access-Control-Allow-Origin reflected from request Origin if cfgAllowedOrigin is Nothing
  ! Allow-Methods and Allow-Headers are HARDCODED; route-specific CORS is not supported
  ! Max-Age=86400 (24h) hardcoded
  ~ literals: "*", "text/plain", "true", "86400"
  ~ called by: App.runWithEnv

reflectOriginMiddleware :: Middleware
  ! strips Access-Control-Allow-{Origin,Credentials} from response, then re-adds with reflected request Origin
  ! runs on EVERY response, including non-CORS requests
  ! Allow-Credentials is always 'true'; downstream cannot opt out
  ~ literals: "true"
  ~ called by: App.runWithEnv

toDBConfig :: AppConfig -> DBConfig
  ~ called by: App.buildEnv

%decision HttpOnlyCookiesNotLocalStorage
  what:    HttpOnly + Secure + SameSite=Strict cookie, lifted to bearer in middleware
  why:     localStorage tokens are readable by any XSS payload; HttpOnly cookies are not. Cookie carries SameSite=Strict + Secure + Path=/ + Max-Age=28800. cookieAuthMiddleware translates the cookie into Authorization: Bearer so existing Servant Maybe Text bearer extraction works unchanged. Middleware blindly overwrites any client-supplied Authorization header. Intentional but reconsider if a non-browser client ever needs to send its own bearer.
  affects: cookieAuthMiddleware, extractCookieToken, checkAndRotate

%decision MiddlewareStackOrderMatters
  what:    tracing > securityHeaders > handleOptions > reflectOrigin > cookieAuth > corsApp
  why:     OPTIONS short-circuits before auth (browsers preflight without cookies). reflectOrigin is the LAST CORS-touching layer, so it has the final say on Allow-Origin. cookieAuth is innermost so it sees a clean request and can prepend Set-Cookie that survives outer layers. In production, ALLOWED_ORIGIN must be set; the reflect path is for development only.
  affects: runWithEnv, cookieAuthMiddleware, handleOptionsMiddleware, reflectOriginMiddleware, securityHeadersMiddleware

%decision BackgroundWorkersForkedAtStartup
  what:    AvailabilityRelay and sessionCleanupWorker forked unsupervised
  why:     If either thread dies, the parent does not notice until the next cleanup interval (or never, for the relay). Acceptable for a single-tenant POS where the operator restarts on visible failure. Replace with a supervisor tree if multi-tenant.
  affects: runWithEnv, sessionCleanupWorker



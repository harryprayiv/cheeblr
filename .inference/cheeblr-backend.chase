%uses Types.Events.Domain
%uses Types.Location
%uses Types.Trace

%untested runEventEmitterProd

data EventEmitter :: Effect where
  Emit :: DomainEvent -> EventEmitter m ()

emit :: (EventEmitter :> es) => DomainEvent -> Eff es ()
  ~ called by: Service.Stock.transition, Service.Register.openRegister, Service.Register.closeRegister, Service.Stock.cancelPull, Service.Transaction.createStockPull, Service.Stock.addMessage, Service.Transaction.createSaleSvc, Service.Transaction.addItem, +6 more
  ? tested by: Test.Effect.EventEmitterSpec.spec

runEventEmitterNoop :: Eff (EventEmitter : es) a -> Eff es a
  ! interprets Emit as pure (): no DB.Events insert and no Broadcaster publish, unlike runEventEmitterProd
  ! Test.Service.TransactionSpec.runTest and Test.Service.SaleSpec.runTest use it; runEventEmitterCollect is the variant that records events in an IORef
  > consumed by: test-only
  ~ no callers in scanned roots
  ? tested by: Test.Effect.EventEmitterSpec.spec, Test.Service.StockSpec.runTest, Test.Service.RegisterSpec.runTest, Test.Service.TransactionSpec.runTest, Test.Service.SaleSpec.runTest

runEventEmitterCollect ::
  (IOE :> es) =>
  IORef [DomainEvent] ->
  Eff (EventEmitter : es) a ->
  Eff es a
  ! collects events into an IORef in REVERSE order (cons onto front)
  ! callers wanting chronological order must reverse the list
  > consumed by: test/spec runners that assert on emitted events
  ~ no callers in scanned roots
  ? tested by: Test.Effect.EventEmitterSpec.spec, Test.Service.StockSpec.runTestWithEvents, Test.Service.RegisterSpec.runTestWithEvents, Test.Service.TransactionSpec.runTestWithEvents

runEventEmitterProd ::
  (IOE :> es) =>
  DBPool ->
  Broadcaster DomainEvent ->
  Maybe TraceId ->
  Maybe UUID -> -- actor
  Maybe LocationId -> -- location
  Eff (EventEmitter : es) a ->
  Eff es a
  ! intent: Production interpreter: persist to domain_events AND publish to broadcaster
  ! effects: DBPool, IO
  ! ORDER: insertDomainEvent first, then publish
  ! the two writes are sequential and NOT transactional
  ! if publish succeeds and the DB write fails (or vice versa), subscribers see a divergence from the audit log
  ! trace, actor, and location are bound at interpreter setup time; one interpreter per request scope
  > consumed by: Service.Transaction.* (every state change emits)
  > consumed by: Service.Stock.* (pull lifecycle)
  > consumed by: Service.Register.* (open/close)
  > consumed by: App.Server initialization (one interpreter per request via App env)
  ~ called by: Server.SaleCommand.runSaleEff, Server.Transaction.runTxEff, Server.Stock.runStockEff, Server.Transaction.runRegEff



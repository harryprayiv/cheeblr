%uses Config.Network
%uses Data.Either
%uses Data.Maybe
%uses Effect.Aff
%uses Types.Inventory
%uses Types.Location
%uses Types.Stock
%uses Types.UUID

%untested pullUrl, getQueue, cancelPull, acceptPull, startPull, fulfillPull, retryPull, reportIssue
%untested getMessages, sendMessage, queueStreamUrl

pullUrl :: UUID -> String -> String
  ~ called by: API.Stock.cancelPull, API.Stock.acceptPull, API.Stock.startPull, API.Stock.fulfillPull, API.Stock.retryPull, API.Stock.reportIssue, API.Stock.getMessages, API.Stock.sendMessage

getQueue :: Maybe LocationId -> Aff (Either ApiError (Array PullRequest))
  ! Pages.Stock.Interface passes Just (LocationId dummyLocationId) so it sees only the configured location's queue. See Config.Entity.DummyIdsUsedInProductionCodePaths.
  ! With no locationId and no location on the user account the backend answers 400.
  ~ called by: Pages.Stock.Interface.page

cancelPull :: UUID -> String -> Aff (Either ApiError MutationResponse)
  ! POST with body {irNote: reason}; the backend records the reason as the cancellation note.
  ! Cancellation is terminal; the pull cannot be reopened, only a fresh pull request created.
  ~ called by: Pages.Stock.Interface.page

acceptPull :: UUID -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

startPull :: UUID -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

fulfillPull :: UUID -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

retryPull :: UUID -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

reportIssue :: UUID -> String -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

getMessages :: UUID -> Aff (Either ApiError (Array PullMessage))
  ~ called by: Pages.Stock.Interface.page

sendMessage :: UUID -> String -> Aff (Either ApiError MutationResponse)
  ~ called by: Pages.Stock.Interface.page

queueStreamUrl :: String
  ! The stream URL with no credential in it. Utils.SSE opens it with credentials. The backend requires capCanFulfillOrders.
  ~ called by: Pages.Stock.Interface.page

%decision StockCallsUseTheSharedRequestCore
  what:    Every stock call goes through API.Request; the module's own fetch helpers are gone
  why:     The pull actions with no data (accept, start, fulfill, retry) use Request.postEmpty. The backend routes take no request body. cancel and issue post {irNote}; message posts {nmMessage}.
  affects: acceptPull, startPull, fulfillPull, retryPull, cancelPull, reportIssue, sendMessage



feedServerImpl :: AppEnv -> Server FeedAPI
  ? no test references

feedSubscribeApp :: AppEnv -> Maybe Int64 -> Tagged Handler Application
  ! WAI Tagged Application that upgrades to WebSocket or 400s if the client did not request upgrade
  ! fallback responds 400 with body 'WebSocket connection required'
  ? no test references

wsHandler :: AppEnv -> Maybe Int64 -> WS.ServerApp
  ! intent: WebSocket handler for app.cheeblr.feed.subscribe
  ! effects: WebSockets, STM, DBPool, IO
  ! ORDER: acceptRequest, replay-or-snapshot, subscribe, withPingThread, loop
  ! with cursor: replays Seq.filter (seq > cursor) from history, then live
  ! without cursor: emits SYNTHETIC snapshot frames, all sharing currentSeq value, then live
  ! snapshot frames are NOT in history and CANNOT be replayed by a re-subscribing client without cursor
  ! ping thread is 30s
  ! loop catches ConnectionException only; other exceptions kill the connection thread but not the server
  ! spec: connect with cursor=Just 100 => frames where seq > 100, then live updates
  ! spec: connect with cursor=Nothing => snapshot of all current items at currentSeq, then live updates
  > consumed by: Servant route /xrpc/app.cheeblr.feed.subscribe (WebSocket)
  ? no test references

feedStatusHandler :: AppEnv -> Handler FeedStatus
  ! reads bHistory directly via readTVarIO; not a method on Broadcaster (slight encapsulation leak)
  ! oldestSeq comes from listToMaybe on the history Seq; Nothing iff history is empty
  ! inStockCount filters allAvailableItems by aiInStock
  ? no test references

feedSnapshotHandler :: AppEnv -> Handler [AvailableItem]
  ! reads envAvailabilityState with readTVarIO and returns allAvailableItems st now in a single response; it never queries Postgres
  ! the result is only as fresh as what Infrastructure.AvailabilityRelay last wrote into that TVar
  ? no test references

lexiconsApp :: Tagged Handler Application
  ! lexicon JSON is INLINED as Haskell ByteString literals
  ! vendored deliberately to avoid a runtime asset path dependency; ugly but self-contained
  ! 404 for any path under /lexicons that is not one of the three known names
  > consumed by: Servant route /lexicons/app.cheeblr.*
  ? no test references

availableItemLexicon :: LBS.ByteString
  ? no test references

subscribeLexicon :: LBS.ByteString
  ? no test references

statusLexicon :: LBS.ByteString
  ? no test references

%decision AtprotoStyleSubscription
  what:    WebSocket subscription with monotonic seq cursor, modeled on com.atproto.sync.subscribeRepos
  why:     Public consumers (compliance reporting, third-party menu sites) need an audit-friendly event log, not snapshot polling. The subscribe protocol is intentionally familiar to ATProto implementers. Lexicons are served at /lexicons/app.cheeblr.* so consumers can introspect the schema.
  affects: wsHandler, feedSubscribeApp, lexiconsApp

%decision SyntheticSnapshotFramesShareSeq
  what:    When a client connects without a cursor, every snapshot frame carries currentSeq
  why:     Snapshot frames are not in the broadcaster's history and have no real seq of their own. Clients must tolerate non-strictly-monotonic seq across the snapshot block, then strictly monotonic from the first live event. Documented in the lexicon, but easy to miss.
  affects: wsHandler



  AppEnv ->
  SessionContext ->
  Text ->
  (UserCapabilities -> Bool) ->
  Handler ()
  ! 403 with body 'Forbidden: <name> required' unless the role's capabilities satisfy the predicate; the denial is logged with the capability name
  ~ called by: Server.SaleCommand.saleCommandServer, Server.Transaction.saleServer, Server.Transaction.registerServer


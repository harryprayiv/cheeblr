  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

uuid :: Parser UUID
  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

commaList :: Parser (Array String)
  ! splits on ",", trims each entry and filters out ""; always Right, so "a,, ,b" gives ["a","b"] and "" gives []
  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

%decision ParseDontValidateAtTheInputBoundary
  what:    A field parser is String -> Either String a; it returns the typed value or the hint text. There is no separate Boolean validity rule and no second parse at submit.
  why:     The old kit had a ValidationRule (String -> Boolean), a separate error string, and validateMenuItem re-parsing at submit; the three could disagree. String-returning parsers chain with >=>.
  affects: required, cents, percentage, commaList, uuid, optional



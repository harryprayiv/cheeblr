%file /home/bismuth/git/cheeblr/backend/src/Service/Transaction.hs
%mod Service.Transaction

%ext FlexibleContexts, OverloadedStrings, ScopedTypeVariables, TypeOperators

%uses Control.Monad
%uses qualified Data.ByteString.Lazy as LBS
%uses Data.List
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses Data.Time
%uses Data.UUID
%uses qualified Data.Vector as V
%uses Effectful
%uses Effectful.Error.Static
%uses Servant
%uses DB.Transaction
%uses Effect.Clock
%uses Effect.EventEmitter
%uses Effect.GenUUID
%uses qualified Effect.InventoryDb as EffInv
%uses qualified Effect.StockDb as StockDb
%uses Effect.TransactionDb
%uses State.SaleTransactionMachine
%uses State.StockPullMachine
%uses Types.Primitives.Quantity
%uses qualified Types.Transaction.Refund as Refund
%uses qualified Types.Transaction.Sale as Sale
%uses Types.Transaction.Conversion
%uses Types.Events.Domain
%uses Types.Events
%uses Types.Inventory
%uses qualified Types.Inventory as TI
%uses Types.Stock

loadSale ::
  (TransactionDb :> es, Error ServerError :> es) =>
  UUID ->
  Eff es Sale.SaleTransaction
  ! throws err404 on TypedNotFound; err500 on TypedDecodeFailed; err409 on TypedWrongKind (refund row addressed as a sale)
  ! single source of truth for sale loading in the service layer; never returns Nothing
  ? no test references

guardSaleTxEvent :: (Error ServerError :> es) => SaleTxEvent -> Eff es ()
  ! translates InvalidTxCommand to err409 with reason in the body
  ! all other SaleTxEvent variants fall through silently
  ? no test references

requireTxId ::
  (Error ServerError :> es) =>
  (UUID -> Eff es (Maybe UUID)) ->
  LBS.ByteString ->
  UUID ->
  Eff es UUID
  ! wraps a Maybe-returning lookup (getTxIdByItemId / getTxIdByPaymentId) into err404 + supplied body
  ! used to resolve item/payment id -> parent tx id BEFORE issuing deletes
  ? no test references

failText :: (Error ServerError :> es) => ServerError -> Text -> Eff es a
  ? no test references

refuseWrite :: (Error ServerError :> es) => InventoryException -> Eff es a
  ! the ONLY mapping from InventoryException to HTTP: ItemNotFound 404, InsufficientInventory 400 with both numbers, SaleNotOpen 409 'The sale is no longer open', LineRejected 400 with the pricing message, FinalizeRefused 409 with the reasons joined by '; '
  ! exported; Service.Sale.clear uses it
  ? no test references

createStockPull ::
  ( StockDb.StockDb :> es
  , EffInv.InventoryDb :> es
  , EventEmitter :> es
  , GenUUID :> es
  ) =>
  Sale.SaleTransaction ->
  Sale.Item ->
  Int ->
  UTCTime ->
  Eff es ()
  ! BEST-EFFORT: failure to insert is SILENTLY ignored (Left _ -> pure ())
  ! looks up item name from inventory snapshot; falls back to UUID-as-text if missing
  ! emits PullRequestCreated only on successful insert
  > consumed by: Service.Transaction.addItem (called after each successful item add)
  > consumed by: downstream PullRequestCreated event is consumed by stockroom dashboard SSE
  ? no test references

createSaleSvc ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  ) =>
  Sale.SaleTransaction ->
  Eff es Sale.SaleTransaction
  ! thin wrapper: createSale then emit TransactionCreated (via saleToLegacyTransaction for the event payload)
  ! no state machine guard; new sales are always valid
  > consumed by: Service.Sale.startSale (only production caller; builds the empty sale server-side)
  ? no test references

addItem ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EffInv.InventoryDb :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  SaleLineAdd ->
  Eff es Sale.Item
  ! intent: Add a quantity of one sku to a sale and return the line as stored
  ! effects: TransactionDb, StockDb, InventoryDb, EventEmitter, Clock, GenUUID, Error ServerError
  ! takes a SaleLineAdd: sale, sku, quantity TO ADD, an id for a new line, and a pricing function
  ! ORDER: loadSale, reject quantity <= 0 with 400, price a provisional line for the state machine, state guard, addSaleItem, emit TransactionItemRemoved for each replaced line, emit TransactionItemAdded, createStockPull for the added quantity
  ! never computes a quantity from the sale it loaded; addSaleItem does that under the lock
  ! a refused add changes nothing, status included
  ! createStockPull failures do not undo the add
  ! spec: addItem on Created sale => Right item, status -> InProgress, ItemAdded + PullRequestCreated emitted
  ! spec: addItem on Completed sale => err409
  ! spec: addItem with unknown sku => err404 Item not found
  ! spec: addItem with qty > available => err400 Insufficient inventory
  > consumed by: Service.Sale.addItem (only production caller; its pricing function uses Domain.Pricing)
  ? tested by: Test.Service.SaleSpec.afterAdd, Test.Service.TransactionSpec.spec, Test.Service.SaleSpec.spec

removeItem ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es ()
  ! ORDER: resolve sale from line id (404 if unknown), loadSale, state guard, capture the line for the event, deleteSaleItem, then on success emit TransactionItemRemoved, cancel pulls for (sale, sku), emit PullRequestCancelled per pull that was open
  ! a refusal from deleteSaleItem goes through refuseWrite (409) and emits nothing
  > consumed by: Service.Sale.removeItem
  ? tested by: Test.Service.TransactionSpec.spec, Test.Service.SaleSpec.spec

addPayment ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  Sale.Payment ->
  Eff es Sale.Payment
  ! state guard against the loaded status, then addSalePayment, which re-checks under the lock
  ! does NOT finalize even if amount equals total; finalize is a separate explicit command
  ! does not compare the amount with what is still owed
  > consumed by: Service.Sale.addPayment (only production caller; change and approval are set on the server)
  ? tested by: Test.Service.TransactionSpec.spec, Test.Service.SaleSpec.spec

removePayment ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es ()
  ! resolves the sale from the payment id BEFORE deletion; 404 if unknown
  ! deleteSalePayment re-checks the status under the lock
  > consumed by: Service.Sale.removePayment
  ? tested by: Test.Service.TransactionSpec.spec, Test.Service.SaleSpec.spec

finalizeTx ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es Sale.SaleTransaction
  ! intent: Complete a sale
  ! state guard for an early 409 on the wrong status; whether the sale has lines and is paid is decided ONLY by finalizeSale under the lock
  ! FinalizeRefused becomes 409 with every reason
  ! emits TransactionFinalized after the write
  ! spec: finalizeTx on a paid InProgress sale => Right sale{status=Completed}, inventory decremented, TransactionFinalized emitted
  ! spec: finalizeTx on Created sale => err409
  ! spec: finalizeTx on an underpaid sale => err409 naming the shortfall
  > consumed by: Service.Sale.finalize (which is exactly this function)
  ? tested by: Test.Service.TransactionSpec.spec

voidTx ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Text ->
  Eff es Sale.SaleTransaction
  ! intent: Void a sale (valid from Created, InProgress or Completed) and cancel its open stock pulls
  ! ORDER: loadSale, state guard, getPullsByTransaction, voidSale, then on success emit TransactionVoided, cancelPullsForTransaction, emit PullRequestCancelled per non-terminal pull
  ! a Refunded or Voided sale is refused with 409
  ! whether stock goes back for a Completed sale is the interpreter's StockPolicy; this function does not know
  ! the event's actor is the sale's employee, not the user who voided
  ! spec: voidTx on Created sale => Right sale{status=Voided}, TransactionVoided + PullRequestCancelled emitted
  ! spec: voidTx on Voided sale => err409
  ! spec: voidTx on Refunded sale => err409
  > consumed by: Server.Transaction POST /sale/void/:id
  > consumed by: Server.Manager.overrideVoidHandler POST /manager/override/void/:id
  ? tested by: Test.Service.TransactionSpec.spec

refundTx ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Text ->
  Eff es Refund.RefundTransaction
  ! GENERATES the refund id and one id per line and per payment at the service layer
  ! builds the typed refund via toRefundTransaction; err500 if that fails
  ! state guard: only a Completed sale; a second refund is stopped here or, in a race, by writeRefund under the lock
  ! SaleNotOpen from writeRefund becomes 409 'The sale cannot be refunded: it is not completed or was already refunded'
  ! emits TransactionRefunded only on success; its actor is the sale's employee, not the user who refunded
  ! always the whole sale
  > consumed by: Server.Transaction POST /sale/refund/:id
  ? tested by: Test.Service.TransactionSpec.spec

%decision EventEmissionAfterPersistence
  what:    Domain events are emitted AFTER the corresponding DB write succeeds
  why:     If the DB write fails, the event is never emitted (no orphan events). If the emit fails after DB success, downstream consumers miss the event but DB state is correct. Asymmetric and acceptable for a POS that prioritizes books-and-records integrity over event-stream completeness.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx, createSaleSvc

%decision StockPullsAreBestEffort
  what:    createStockPull silently swallows insertion errors; the transaction proceeds either way
  why:     Loss of a stock pull means the cashier falls back to a verbal pull request. Failing the transaction-item add to prevent that loss would be worse for the cashier under load. Recovery is manual.
  affects: addItem, createStockPull

%decision EarlyStateMachineCheckThenLockedCheck
  what:    Each operation loads the sale and runs the crem state machine for an early 409 with a clear message, then calls the effect, which checks the status again under the sale row lock
  why:     The state machine check alone was the old design and is a read-then-act race. The locked check is the one that protects the data. The early check only makes the common case's message better. A refused write emits no event and cancels no stock pull. Because either check can answer, which message a caller sees for a closed sale depends on timing.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx, refuseWrite

%decision RefundIsANewTransaction
  what:    A refund is a new Transaction row of type RETURN pointing at the original via reference_transaction_id; the original sale's status becomes REFUNDED
  why:     Original sale and refund are both visible and auditable. refundId and the refund's line and payment ids are generated at the SERVICE layer so the domain event and the rows share them. One refund per sale, enforced under the sale row lock in DB.Transaction.Refund.writeTypedRefund.
  affects: refundTx

%decision ServiceSaleIsTheOnlyEntryForSaleBuilding
  what:    HTTP handlers do not call the sale-building operations here directly; Service.Sale wraps every one
  why:     This module trusts the Sale.Item and Sale.Payment it is given. Service.Sale constructs those values on the server, so no client-computed money reaches this layer. voidTx is called from Server.Transaction and from Server.Manager.overrideVoidHandler. refundTx is called from Server.Transaction.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, createSaleSvc



%file /home/bismuth/git/cheeblr/backend/src/DB/Events.hs
%mod DB.Events

%ext OverloadedStrings

%uses qualified Data.Aeson as Aeson
%uses qualified Data.ByteString.Lazy as LBS
%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Text
%uses qualified Data.Text.Encoding as TE
%uses Data.Time
%uses Data.UUID
%uses Data.UUID.V4
%uses qualified Hasql.Decoders as Decoders
%uses qualified Hasql.Encoders as Encoders
%uses qualified Hasql.Session as Session
%uses qualified Hasql.Statement as Statement
%uses DB.Database
%uses Types.Admin
%uses qualified Types.Events.Domain as D
%uses Types.Events
%uses qualified Types.Inventory as TI
%uses Types.Location
%uses Types.Stock
%uses Types.Trace
%uses qualified Types.Transaction as TT

%untested createEventsTables, insertDomainEvent, insertStmt, queryDomainEvents, queryStmt, eventMeta, invMeta, txMeta
%untested regMeta, sessMeta, stockMeta

type Row = (UUID, Text, UUID, Maybe UUID, Maybe UUID, Maybe UUID, Text, UTCTime)

type QueryRow = (Maybe UUID, Maybe Text, Maybe Int64, Int64)

createEventsTables :: DBPool -> IO ()
  ! creates domain_events with seq BIGSERIAL PK, aggregate_id, trace_id, actor_id, location_id, payload JSONB
  ! creates four indexes: (aggregate_id, seq), (type, seq), trace_id (partial), (location_id, seq) (partial), occurred_at
  ! creates RULES domain_events_no_update / domain_events_no_delete that turn UPDATE/DELETE into NOTHING
  ! the rules are guarded by IF NOT EXISTS via DO $$ ... END $$ so re-running the DDL is safe
  ~ called by: App.runWithEnv

insertDomainEvent ::
  DBPool ->
  Maybe TraceId ->
  Maybe UUID ->
  Maybe LocationId ->
  D.DomainEvent ->
  IO ()
  ! intent: Append-only insert of one DomainEvent
  ! effects: DBPool, IO
  ! encodes the DomainEvent as JSON via Aeson, casts $7 from text to jsonb in SQL
  ! id, type, aggregate_id derived via eventMeta dispatching on the event variant
  ! occurred_at is the application clock at insert time, NOT a DB now()
  > consumed by: Effect.EventEmitter.runEventEmitterProd (every domain event in production goes here first)
  ~ called by: Effect.EventEmitter.runEventEmitterProd

insertStmt :: Statement.Statement Row ()
  ~ called by: DB.Events.insertDomainEvent

queryDomainEvents ::
  DBPool ->
  Maybe UUID ->
  Maybe Text ->
  Maybe Int64 ->
  Int ->
  IO [DomainEventRow]
  ! DESCENDING order by seq with LIMIT; cursor is exclusive (seq > $3)
  ! all three filter params are OPTIONAL (null aware via SQL null comparison)
  > consumed by: Server.Admin domain events viewer (cursor-based pagination)
  > consumed by: fallback for SSE/WS clients whose cursor is older than the broadcaster's bounded history
  ~ called by: Server.Admin.transactionDetailHandler, Server.Admin.domainEventsHandler

queryStmt :: Statement.Statement QueryRow [DomainEventRow]
  ~ called by: DB.Events.queryDomainEvents

eventMeta :: D.DomainEvent -> (Text, UUID)
  ! extracts (type-string, aggregate-id) for indexing
  ! type strings follow dot.case e.g. 'transaction.created', 'inventory.item_updated'
  ! aggregate_id is the natural identifier of the affected aggregate (txId, sku, regId)
  ~ clause: (D.InventoryEvt ie)
  ~ clause: (D.TransactionEvt te)
  ~ clause: (D.RegisterEvt re)
  ~ clause: (D.SessionEvt se)
  ~ clause: (D.StockEvt se)
  ~ called by: DB.Events.insertDomainEvent

invMeta :: InventoryEvent -> (Text, UUID)
  ~ clause: ItemCreated {ieItem = item}
  ~ clause: ItemUpdated {ieNewItem = item}
  ~ clause: ItemDeleted {ieSku = u}
  ~ clause: QuantityChanged {ieItemSku = u}
  ~ called by: DB.Events.eventMeta

txMeta :: TransactionEvent -> (Text, UUID)
  ~ clause: TransactionCreated {teTx = tx}
  ~ clause: TransactionItemAdded {teTxId = u}
  ~ clause: TransactionItemRemoved {teTxId = u}
  ~ clause: TransactionPaymentAdded {teTxId = u}
  ~ clause: TransactionPaymentRemoved {teTxId = u}
  ~ clause: TransactionFinalized {teTxId = u}
  ~ clause: TransactionVoided {teTxId = u}
  ~ clause: TransactionRefunded {teTxId = u}
  ~ literals: "transaction.created", "transaction.voided", "transaction.refunded"
  ~ called by: DB.Events.eventMeta

regMeta :: RegisterEvent -> (Text, UUID)
  ~ clause: RegisterOpened {reRegId = u}
  ~ clause: RegisterClosed {reRegId = u}
  ~ literals: "register.opened", "register.closed"
  ~ called by: DB.Events.eventMeta

sessMeta :: SessionEvent -> (Text, UUID)
  ~ clause: SessionCreated {sesUserId = u}
  ~ clause: SessionExpired {sesUserId = u}
  ~ clause: SessionRevoked {sesUserId = u}
  ~ literals: "session.created", "session.expired", "session.revoked"
  ~ called by: DB.Events.eventMeta

stockMeta :: StockEvent -> (Text, UUID)
  ~ clause: PullRequestCreated {sePull = pr}
  ~ clause: PullStatusChanged {sePullId = u}
  ~ clause: PullMessageAdded {sePullId = u}
  ~ clause: PullRequestCancelled {sePullId = u}
  ~ literals: "stock.pull_created", "stock.status_changed", "stock.message_added", "stock.pull_cancelled"
  ~ called by: DB.Events.eventMeta

%decision AppendOnlyDomainEventsWithDbRules
  what:    domain_events with INSTEAD NOTHING rules + JSONB payload + indexed (aggregate_id, type, trace_id, location_id)
  why:     Compliance requires an immutable audit log for every transaction lifecycle step. Application-level append-only is bypassable; PostgreSQL RULE-based UPDATE/DELETE blockers are not. JSONB payload preserves the full event for replay; structured columns support efficient querying for the admin UI.
  affects: createEventsTables, insertDomainEvent



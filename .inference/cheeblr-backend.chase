  ~ called by: Service.Sale.loadSale, Service.Transaction.loadSale, Server.Transaction.requireSaleWriter, Server.Transaction.saleServer
  ? tested by: Test.Service.SaleSpec.afterAdd, Test.Service.TransactionSpec.spec


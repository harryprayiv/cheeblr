%file /home/bismuth/git/cheeblr/backend/src/Service/Stock.hs
%mod Service.Stock

%ext FlexibleContexts, OverloadedStrings, TypeOperators

%uses qualified Data.ByteString.Lazy as LBS
%uses Data.Text
%uses qualified Data.Text.Encoding as TE
%uses Data.UUID
%uses Effectful
%uses Effectful.Error.Static
%uses Servant
%uses Effect.Clock
%uses Effect.EventEmitter
%uses Effect.GenUUID
%uses Effect.StockDb
%uses State.StockPullMachine
%uses Types.Events.Domain
%uses Types.Events
%uses Types.Stock

%untested loadPull, guardPullEvent, transition, actorFromCmd, addMessage

loadPull ::
  (StockDb :> es, Error ServerError :> es) =>
  UUID ->
  Eff es (PullRequest, SomePullState)
  ! throws err404 if not found
  ! reconstructs SomePullState from PullVertex via fromVertex
  ~ called by: Service.Stock.transition, Service.Stock.cancelPull, Service.Stock.addMessage

guardPullEvent :: (Error ServerError :> es) => PullEvent -> Eff es ()
  ! translates InvalidPullCmd to err409 with reason in the body
  ~ clause: (InvalidPullCmd msg)
  ~ called by: Service.Stock.transition, Service.Stock.cancelPull

transition ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID ->
  PullCommand ->
  (PullRequest -> PullEvent -> SomePullState -> PullRequest) ->
  Eff es PullRequest
  ! ORDER: load, run command, guard, updatePullStatus, emit PullStatusChanged
  ! carries actorId from the command into the event for audit
  ! if updatePullStatus fails it returns err500 with the DB error text
  > consumed by: Service.Stock.acceptPull, startPulling, fulfillPull, reportIssue, retryPull (all dispatch through here)
  ~ called by: Service.Stock.acceptPull, Service.Stock.startPull, Service.Stock.fulfillPull, Service.Stock.reportIssue, Service.Stock.retryPull

actorFromCmd :: PullCommand -> UUID
  ~ clause: (AcceptCmd a)
  ~ clause: (StartPullCmd a)
  ~ clause: (FulfillCmd a)
  ~ clause: (ReportIssueCmd _ a)
  ~ clause: (RetryCmd a)
  ~ clause: (CancelCmd _ a)
  ~ called by: Service.Stock.transition

acceptPull ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> UUID -> Eff es PullRequest
  ~ called by: Server.Stock.acceptHandler
  ? tested by: Test.Service.StockSpec.spec

startPull ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> UUID -> Eff es PullRequest
  ~ called by: Server.Stock.startHandler
  ? tested by: Test.Service.StockSpec.spec

fulfillPull ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> UUID -> Eff es PullRequest
  ! intent: Mark a pull as Fulfilled (valid only from PullPulling)
  ! spec: fulfillPull pullingId actor => Right pr{status=PullFulfilled}, PullStatusChanged emitted
  ! spec: fulfillPull acceptedId actor => err409 Invalid command in Accepted state
  ! spec: fulfillPull fulfilledId actor => err409 Pull request is fulfilled
  > consumed by: Server.Stock POST /pulls/:id/fulfill (stockroom dashboard)
  ~ called by: Server.Stock.fulfillHandler
  ? tested by: Test.Service.StockSpec.spec

reportIssue ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> Text -> UUID -> Eff es PullRequest
  ~ called by: Server.Stock.issueHandler
  ? tested by: Test.Service.StockSpec.spec

retryPull ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> UUID -> Eff es PullRequest
  ~ called by: Server.Stock.retryHandler
  ? tested by: Test.Service.StockSpec.spec

cancelPull ::
  (StockDb :> es, EventEmitter :> es, Clock :> es, Error ServerError :> es) =>
  UUID -> Text -> UUID -> Eff es PullRequest
  ! DOES NOT use transition: emits PullRequestCancelled (not PullStatusChanged) with the cancellation reason
  ! valid from any non-terminal vertex; PullCancelled and PullFulfilled are absorbing
  > consumed by: Server.Stock POST /pulls/:id/cancel
  > consumed by: Service.Transaction.voidTx (cascades cancellation), removeItem (per-sku cleanup)
  ~ called by: Server.Stock.cancelHandler
  ? tested by: Test.Service.StockSpec.spec

addMessage ::
  ( StockDb :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  UUID -> UUID -> Text -> Text -> Eff es PullMessage
  ! loads the pull only to assert it exists; message can be added in any state
  ! msgId is generated at the service layer via GenUUID
  ~ called by: Server.Stock.messageHandler



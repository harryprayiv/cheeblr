  ~ no callers in scanned roots

maxLen :: Int -> Parser String
  ~ no callers in scanned roots
  ? tested by: Test.FormParser.spec

nonNegativeInt :: Parser Int
  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

positiveInt :: Parser Int
  ~ no callers in scanned roots
  ? tested by: Test.FormParser.spec

centsRe :: Regex
  ~ called by: UI.Form.Parser.cents

cents :: Parser Int
  ! digit arithmetic only: "19.99" -> 1999. The old path floored a float and produced 1998.
  ! rejects more than two decimals, negatives, blanks, and amounts above 21474835.99 (Int overflow guard)
  ~ called by: Pages.Registers.cashForm, UI.Transaction.PaymentPanel.paymentForm, UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

percentageRe :: Regex
  ~ called by: UI.Form.Parser.percentage

percentage :: Parser String
  ! requires the trailing % and returns the string unchanged, because StrainLineage stores thc/cbg as text with the sign
  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec

measurementUnits :: Array String
  ~ called by: UI.Form.Parser.measurementUnit

measurementUnit :: Parser String
  ~ called by: UI.Inventory.ItemForm.menuItemForm
  ? tested by: Test.FormParser.spec


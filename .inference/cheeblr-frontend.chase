%file /home/bismuth/git/cheeblr/frontend/src/Types/Stock.purs
%mod Types.Stock

%uses Prelude
%uses Data.DateTime
%uses Data.Maybe
%uses Types.UUID

data PullVertex
  = PullPending
  | PullAccepted
  | PullPulling
  | PullFulfilled
  | PullCancelled
  | PullIssue

derive instance eqPullVertex :: Eq PullVertex

derive instance ordPullVertex :: Ord PullVertex

instance showPullVertex :: Show PullVertex where

type PullRequest =
  { prId             :: UUID
  , prTransactionId  :: UUID
  , prItemSku        :: UUID
  , prItemName       :: String
  , prQuantityNeeded :: Int
  , prStatus         :: String
  , prCashierId      :: Maybe UUID
  , prRegisterId     :: Maybe UUID
  , prLocationId     :: UUID
  , prCreatedAt      :: DateTime
  , prUpdatedAt      :: DateTime
  , prFulfilledAt    :: Maybe DateTime
  }

type PullMessage =
  { pmId            :: UUID
  , pmPullRequestId :: UUID
  , pmFromRole      :: String
  , pmSenderId      :: UUID
  , pmMessage       :: String
  , pmCreatedAt     :: DateTime
  }

type PullRequestDetail =
  { pdPullRequest :: PullRequest
  , pdMessages    :: Array PullMessage
  }

data PullAction
  = ActionAccept
  | ActionStart
  | ActionFulfill
  | ActionReportIssue
  | ActionRetry
  | ActionCancel

validActions :: String -> Array PullAction
  ! Returns the list of PullActions the UI should offer for a given prStatus string.
  ! Pattern matches on the EXACT string forms: 'PullPending', 'PullAccepted', 'PullPulling', 'PullIssue'. Other strings (including PullFulfilled and PullCancelled) return [].
  ! Terminal states (Fulfilled, Cancelled) have no valid actions; the UI renders no action buttons for them.
  ! ActionRetry on PullIssue is intended to transition back to PullPulling (reattempt the pull) per the topology, but this is enforced server-side; the action label is just 'Retry'.
  ~ called by: Pages.Stock.Components.PullCard.pullCard
  ? tested by: Test.Stock.spec

actionLabel :: PullAction -> String
  ! Maps PullAction to the human-readable button label.
  ! Total over PullAction; adding a constructor requires updating this function.
  ~ called by: Pages.Stock.Components.PullCard.pullCard
  ? tested by: Test.Stock.spec

statusClass :: String -> String
  ! Maps prStatus string to a CSS class name; used for visual differentiation of pull cards.
  ! Unrecognized status returns empty string (no class applied).
  ~ called by: Pages.Stock.Components.PullCard.pullCard
  ? tested by: Test.Stock.spec

%decision PullVertexAndStringStatusInParallel
  what:    PullVertex is a typed enum but PullRequest.prStatus is a String, and validActions/statusClass dispatch on the String not the enum
  why:     The backend serializes pull request status as a string in the JSON wire format; PullVertex exists for typed code paths but the wire model is the source of truth. validActions and statusClass take String specifically because they are called on prStatus values fresh off the wire with no enum conversion step. Cost: a typo in a status string silently produces an empty action list (no buttons render) rather than a compile error. Mitigation would be a parsePullVertex :: String -> Maybe PullVertex used at the API boundary.
  affects: validActions, statusClass



  { lpEntries    :: Array LogEvent
  , lpNextCursor :: Maybe Number
  , lpTotal      :: Int
  }

type DomainEventRow =
  { derSeq         :: Number
  , derId          :: UUID
  , derType        :: String
  , derAggregateId :: UUID
  , derTraceId     :: Maybe UUID
  , derActorId     :: Maybe UUID
  , derOccurredAt  :: DateTime
  }

type DomainEventPage =
  { depEvents     :: Array DomainEventRow
  , depNextCursor :: Maybe Number
  , depTotal      :: Int
  }

type TransactionPage =
  { tpTransactions :: Array Transaction
  , tpNextCursor   :: Maybe UUID
  , tpTotal        :: Int
  }

data AdminAction
  = RevokeSession       UUID
  | ForceCloseRegister  UUID String
  | ClearRateLimitForIp String
  | SetLowStockThreshold Int
  | TriggerSnapshotExport

instance WriteForeign AdminAction where

%decision AdminActionAsTaggedSumWithPositionalContents
  what:    AdminAction is a sum type (RevokeSession, ForceCloseRegister, ClearRateLimitForIp, SetLowStockThreshold, TriggerSnapshotExport); WriteForeign emits {tag, contents} with constructor-shape-dependent contents
  why:     {tag, contents} matches the backend's expected JSON shape; the tag is the constructor name, contents is the argument(s). ForceCloseRegister has TWO args (uuid, reason) and serializes as a positional array [uuidString, reason]; the backend expects positional args here, not a named object. Adding a third arg to ForceCloseRegister means coordinating with the backend's positional decoder. TriggerSnapshotExport has no args; serializes as just {tag: 'TriggerSnapshotExport'}.
  affects: 

%decision AdminSnapshotIsPointInTimeServerState
  what:    AdminSnapshot is a wide record bundling uptime, sessions, registers, inventory summary, DB pool stats, broadcaster queue depths
  why:     Rendered as the dashboard Overview tab; designed to fit on one screen as a grid of stat cards. Adding a field requires backend coordination since the wire shape is shared. Snapshot is fetched on demand (mount and refresh button); there's no streaming snapshot - bcAvailabilitySeq is the closest thing to a freshness watermark.
  affects: 



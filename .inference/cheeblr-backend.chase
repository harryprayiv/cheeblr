%file /home/bismuth/git/cheeblr/backend/src/Service/Transaction.hs
%mod Service.Transaction

%ext FlexibleContexts, OverloadedStrings, ScopedTypeVariables, TypeOperators

%uses Control.Monad
%uses qualified Data.ByteString.Lazy as LBS
%uses Data.List
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses Data.Time
%uses Data.UUID
%uses qualified Data.Vector as V
%uses Effectful
%uses Effectful.Error.Static
%uses Servant
%uses DB.Transaction
%uses Effect.Clock
%uses Effect.EventEmitter
%uses Effect.GenUUID
%uses qualified Effect.InventoryDb as EffInv
%uses qualified Effect.StockDb as StockDb
%uses Effect.TransactionDb
%uses State.SaleTransactionMachine
%uses State.StockPullMachine
%uses Types.Primitives.Quantity
%uses qualified Types.Transaction.Refund as Refund
%uses qualified Types.Transaction.Sale as Sale
%uses Types.Transaction.Conversion
%uses Types.Events.Domain
%uses Types.Events
%uses Types.Inventory
%uses qualified Types.Inventory as TI
%uses Types.Stock

%untested loadSale, guardSaleTxEvent, requireTxId, failText, refuseWrite, createStockPull, createSaleSvc

loadSale ::
  (TransactionDb :> es, Error ServerError :> es) =>
  UUID ->
  Eff es Sale.SaleTransaction
  ! throws err404 on TypedNotFound; err500 on TypedDecodeFailed; err409 on TypedWrongKind (refund row addressed as a sale)
  ! single source of truth for sale loading in the service layer; never returns Nothing
  ~ called by: Service.Transaction.addItem, Service.Transaction.removeItem, Service.Transaction.addPayment, Service.Transaction.removePayment, Service.Transaction.finalizeTx, Service.Transaction.voidTx, Service.Transaction.refundTx

guardSaleTxEvent :: (Error ServerError :> es) => SaleTxEvent -> Eff es ()
  ! translates InvalidTxCommand to err409 with reason in the body
  ! all other SaleTxEvent variants fall through silently
  ~ clause: (InvalidTxCommand msg)
  ~ called by: Service.Transaction.addItem, Service.Transaction.removeItem, Service.Transaction.addPayment, Service.Transaction.removePayment, Service.Transaction.finalizeTx, Service.Transaction.voidTx, Service.Transaction.refundTx

requireTxId ::
  (Error ServerError :> es) =>
  (UUID -> Eff es (Maybe UUID)) ->
  LBS.ByteString ->
  UUID ->
  Eff es UUID
  ! wraps a Maybe-returning lookup (getTxIdByItemId / getTxIdByPaymentId) into err404 + supplied body
  ! used to resolve item/payment id -> parent tx id BEFORE issuing deletes
  ~ called by: Service.Transaction.removeItem, Service.Transaction.removePayment

failText :: (Error ServerError :> es) => ServerError -> Text -> Eff es a
  ~ called by: Service.Transaction.refuseWrite, Service.Transaction.addItem, Service.Transaction.refundTx

refuseWrite :: (Error ServerError :> es) => InventoryException -> Eff es a
  ! the ONLY mapping from InventoryException to HTTP: ItemNotFound 404, InsufficientInventory 400 with both numbers, SaleNotOpen 409 'The sale is no longer open', LineRejected 400 with the pricing message, FinalizeRefused 409 with the reasons joined by '; '
  ! exported; Service.Sale.clear uses it
  ~ clause: (ItemNotFound missingSku)
  ~ clause: (InsufficientInventory shortSku requested available)
  ~ clause: (SaleNotOpen _)
  ~ clause: (LineRejected message)
  ~ clause: (FinalizeRefused problems)
  ~ called by: Service.Transaction.addItem, Service.Sale.clear, Service.Transaction.removeItem, Service.Transaction.addPayment, Service.Transaction.removePayment, Service.Transaction.finalizeTx, Service.Transaction.voidTx, Service.Transaction.refundTx

createStockPull ::
  ( StockDb.StockDb :> es
  , EffInv.InventoryDb :> es
  , EventEmitter :> es
  , GenUUID :> es
  ) =>
  Sale.SaleTransaction ->
  Sale.Item ->
  Int ->
  UTCTime ->
  Eff es ()
  ! BEST-EFFORT: failure to insert is SILENTLY ignored (Left _ -> pure ())
  ! looks up item name from inventory snapshot; falls back to UUID-as-text if missing
  ! emits PullRequestCreated only on successful insert
  > consumed by: Service.Transaction.addItem (called after each successful item add)
  > consumed by: downstream PullRequestCreated event is consumed by stockroom dashboard SSE
  ~ called by: Service.Transaction.addItem

createSaleSvc ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  ) =>
  Sale.SaleTransaction ->
  Eff es Sale.SaleTransaction
  ! thin wrapper: createSale then emit TransactionCreated (via saleToLegacyTransaction for the event payload)
  ! no state machine guard; new sales are always valid
  > consumed by: Service.Sale.startSale (only production caller; builds the empty sale server-side)
  ~ called by: Service.Sale.startSale

addItem ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EffInv.InventoryDb :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  SaleLineAdd ->
  Eff es Sale.Item
  ! intent: Add a quantity of one sku to a sale and return the line as stored
  ! effects: TransactionDb, StockDb, InventoryDb, EventEmitter, Clock, GenUUID, Error ServerError
  ! takes a SaleLineAdd: sale, sku, quantity TO ADD, an id for a new line, and a pricing function
  ! ORDER: loadSale, reject quantity <= 0 with 400, price a provisional line for the state machine, state guard, addSaleItem, emit TransactionItemRemoved for each replaced line, emit TransactionItemAdded, createStockPull for the added quantity
  ! never computes a quantity from the sale it loaded; addSaleItem does that under the lock
  ! a refused add changes nothing, status included
  ! createStockPull failures do not undo the add
  ! spec: addItem on Created sale => Right item, status -> InProgress, ItemAdded + PullRequestCreated emitted
  ! spec: addItem on Completed sale => err409
  ! spec: addItem with unknown sku => err404 Item not found
  ! spec: addItem with qty > available => err400 Insufficient inventory
  > consumed by: Service.Sale.addItem (only production caller; its pricing function uses Domain.Pricing)
  ~ called by: Service.Sale.addItem
  ? tested by: Test.Service.TransactionSpec.spec

removeItem ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es ()
  ! ORDER: resolve sale from line id (404 if unknown), loadSale, state guard, capture the line for the event, deleteSaleItem, then on success emit TransactionItemRemoved, cancel pulls for (sale, sku), emit PullRequestCancelled per pull that was open
  ! a refusal from deleteSaleItem goes through refuseWrite (409) and emits nothing
  > consumed by: Service.Sale.removeItem
  ~ called by: Service.Sale.removeItem
  ? tested by: Test.Service.TransactionSpec.spec

addPayment ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  Sale.Payment ->
  Eff es Sale.Payment
  ! state guard against the loaded status, then addSalePayment, which re-checks under the lock
  ! does NOT finalize even if amount equals total; finalize is a separate explicit command
  ! does not compare the amount with what is still owed
  > consumed by: Service.Sale.addPayment (only production caller; change and approval are set on the server)
  ~ called by: Service.Sale.addPayment
  ? tested by: Test.Service.TransactionSpec.spec

removePayment ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es ()
  ! resolves the sale from the payment id BEFORE deletion; 404 if unknown
  ! deleteSalePayment re-checks the status under the lock
  > consumed by: Service.Sale.removePayment
  ~ called by: Service.Sale.removePayment
  ? tested by: Test.Service.TransactionSpec.spec

finalizeTx ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es Sale.SaleTransaction
  ! intent: Complete a sale
  ! state guard for an early 409 on the wrong status; whether the sale has lines and is paid is decided ONLY by finalizeSale under the lock
  ! FinalizeRefused becomes 409 with every reason
  ! emits TransactionFinalized after the write
  ! spec: finalizeTx on a paid InProgress sale => Right sale{status=Completed}, inventory decremented, TransactionFinalized emitted
  ! spec: finalizeTx on Created sale => err409
  ! spec: finalizeTx on an underpaid sale => err409 naming the shortfall
  > consumed by: Service.Sale.finalize (which is exactly this function)
  ~ called by: Service.Sale.finalize
  ? tested by: Test.Service.TransactionSpec.spec

voidTx ::
  ( TransactionDb :> es
  , StockDb.StockDb :> es
  , EventEmitter :> es
  , Clock :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Text ->
  Eff es Sale.SaleTransaction
  ! intent: Void a sale (valid from Created, InProgress or Completed) and cancel its open stock pulls
  ! ORDER: loadSale, state guard, getPullsByTransaction, voidSale, then on success emit TransactionVoided, cancelPullsForTransaction, emit PullRequestCancelled per non-terminal pull
  ! a Refunded or Voided sale is refused with 409
  ! whether stock goes back for a Completed sale is the interpreter's StockPolicy; this function does not know
  ! the event's actor is the sale's employee, not the user who voided
  ! spec: voidTx on Created sale => Right sale{status=Voided}, TransactionVoided + PullRequestCancelled emitted
  ! spec: voidTx on Voided sale => err409
  ! spec: voidTx on Refunded sale => err409
  > consumed by: Server.Transaction POST /sale/void/:id
  > consumed by: Server.Manager.overrideVoidHandler POST /manager/override/void/:id
  ~ called by: Server.Transaction.saleServer, Server.Manager.overrideVoidHandler
  ? tested by: Test.Service.TransactionSpec.spec

refundTx ::
  ( TransactionDb :> es
  , EventEmitter :> es
  , Clock :> es
  , GenUUID :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Text ->
  Eff es Refund.RefundTransaction
  ! GENERATES the refund id and one id per line and per payment at the service layer
  ! builds the typed refund via toRefundTransaction; err500 if that fails
  ! state guard: only a Completed sale; a second refund is stopped here or, in a race, by writeRefund under the lock
  ! SaleNotOpen from writeRefund becomes 409 'The sale cannot be refunded: it is not completed or was already refunded'
  ! emits TransactionRefunded only on success; its actor is the sale's employee, not the user who refunded
  ! always the whole sale
  > consumed by: Server.Transaction POST /sale/refund/:id
  ~ called by: Server.Transaction.saleServer
  ? tested by: Test.Service.TransactionSpec.spec

%decision EventEmissionAfterPersistence
  what:    Domain events are emitted AFTER the corresponding DB write succeeds
  why:     If the DB write fails, the event is never emitted (no orphan events). If the emit fails after DB success, downstream consumers miss the event but DB state is correct. Asymmetric and acceptable for a POS that prioritizes books-and-records integrity over event-stream completeness.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx, createSaleSvc

%decision StockPullsAreBestEffort
  what:    createStockPull silently swallows insertion errors; the transaction proceeds either way
  why:     Loss of a stock pull means the cashier falls back to a verbal pull request. Failing the transaction-item add to prevent that loss would be worse for the cashier under load. Recovery is manual.
  affects: addItem, createStockPull

%decision EarlyStateMachineCheckThenLockedCheck
  what:    Each operation loads the sale and runs the crem state machine for an early 409 with a clear message, then calls the effect, which checks the status again under the sale row lock
  why:     The state machine check alone was the old design and is a read-then-act race. The locked check is the one that protects the data. The early check only makes the common case's message better. A refused write emits no event and cancels no stock pull. Because either check can answer, which message a caller sees for a closed sale depends on timing.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx, refuseWrite

%decision RefundIsANewTransaction
  what:    A refund is a new Transaction row of type RETURN pointing at the original via reference_transaction_id; the original sale's status becomes REFUNDED
  why:     Original sale and refund are both visible and auditable. refundId and the refund's line and payment ids are generated at the SERVICE layer so the domain event and the rows share them. One refund per sale, enforced under the sale row lock in DB.Transaction.Refund.writeTypedRefund.
  affects: refundTx

%decision ServiceSaleIsTheOnlyEntryForSaleBuilding
  what:    HTTP handlers do not call the sale-building operations here directly; Service.Sale wraps every one
  why:     This module trusts the Sale.Item and Sale.Payment it is given. Service.Sale constructs those values on the server, so no client-computed money reaches this layer. voidTx is called from Server.Transaction and from Server.Manager.overrideVoidHandler. refundTx is called from Server.Transaction.
  affects: addItem, removeItem, addPayment, removePayment, finalizeTx, createSaleSvc


=== BEGIN State/RegisterMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/RegisterMachine.hs
%mod State.RegisterMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses API.Transaction
%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics

%untested toSomeRegState, regAction

instance RenderableVertices RegVertex where

type RegTopology =
  'Topology
    '[ '( 'RegClosed, '[ 'RegClosed, 'RegOpen])
     , '( 'RegOpen, '[ 'RegOpen, 'RegClosed])
     ]

data RegState (v :: RegVertex) where
  ClosedState :: Register -> RegState 'RegClosed
  OpenState :: Register -> RegState 'RegOpen

data SomeRegState = forall v. SomeRegState (SRegVertex v) (RegState v)

data RegCommand
  = OpenRegCmd UUID Int
  | CloseRegCmd UUID Int
  deriving (Show, Eq, Generic)

data RegEvent
  = RegOpened Register
  | RegWasClosed Register Int
  | InvalidRegCommand Text
  deriving (Show, Eq, Generic)

fromRegister :: Register -> SomeRegState
  ! dispatches on registerIsOpen field to choose ClosedState or OpenState
  ~ clause: reg | registerIsOpen reg
  ~ called by: Service.Register.loadReg
  ? tested by: Test.State.RegisterMachineSpec.spec, Test.ProbeSpec.spec

toSomeRegState :: RegState v -> SomeRegState
  ~ called by: State.RegisterMachine.runRegCommand

regAction :: RegState v -> RegCommand -> ActionResult Identity RegTopology RegState v RegEvent
  ! Closed -> {Open via OpenRegCmd}; CloseRegCmd from Closed is InvalidRegCommand
  ! Open   -> {Closed via CloseRegCmd}; OpenRegCmd from Open  is InvalidRegCommand
  ! OpenRegCmd sets currentDrawer = expectedDrawer = startCash, sets openedBy
  ! CloseRegCmd computes variance = expectedDrawer - countedCash, sets currentDrawer = countedCash
  ~ clause: (ClosedState reg) (OpenRegCmd empId startCash)
  ~ clause: (ClosedState reg) _
  ~ clause: (OpenState reg) (CloseRegCmd _ countedCash)
  ~ clause: (OpenState reg) _
  ~ called by: State.RegisterMachine.runRegCommand

runRegCommand :: SomeRegState -> RegCommand -> (RegEvent, SomeRegState)
  ~ clause: (SomeRegState _ st) cmd
  ~ called by: Service.Register.openRegister, Service.Register.closeRegister
  ? tested by: Test.State.RegisterMachineSpec.spec, Test.Props.StateMachineSpec.spec, Test.ProbeSpec.spec


=== BEGIN State/SaleTransactionMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/SaleTransactionMachine.hs
%mod State.SaleTransactionMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics
%uses qualified Types.Transaction as Legacy
%uses qualified Types.Transaction.Sale as Sale

%untested fromSaleTransaction, toSomeSaleTxState, txAction, runTxCommand, cmdLabel, someTxStatus

instance RenderableVertices SaleTxVertex where

type SaleTxTopology =
  'Topology
    '[ '( 'SaleCreated, '[ 'SaleCreated, 'SaleInProgress, 'SaleVoided])
     , '( 'SaleInProgress, '[ 'SaleInProgress, 'SaleCompleted, 'SaleVoided])
     , '( 'SaleCompleted, '[ 'SaleCompleted, 'SaleVoided, 'SaleRefunded])
     , '( 'SaleVoided, '[ 'SaleVoided])
     , '( 'SaleRefunded, '[ 'SaleRefunded])
     ]

data SaleTxState (v :: SaleTxVertex) where
  CreatedState :: Sale.SaleTransaction -> SaleTxState 'SaleCreated
  InProgressState :: Sale.SaleTransaction -> SaleTxState 'SaleInProgress
  CompletedState :: Sale.SaleTransaction -> SaleTxState 'SaleCompleted
  VoidedState :: Sale.SaleTransaction -> SaleTxState 'SaleVoided
  RefundedState :: Sale.SaleTransaction -> SaleTxState 'SaleRefunded

data SomeSaleTxState = forall v. SomeSaleTxState (SSaleTxVertex v) (SaleTxState v)

data SaleTxCommand
  = AddItemCmd Sale.Item
  | RemoveItemCmd UUID
  | AddPaymentCmd Sale.Payment
  | RemovePaymentCmd UUID
  | FinalizeCmd
  | VoidCmd Text
  | RefundCmd Text UUID
  deriving (Show, Eq, Generic)

data SaleTxEvent
  = ItemAdded Sale.Item
  | ItemRemoved UUID
  | PaymentAdded Sale.Payment
  | PaymentRemoved UUID
  | TxFinalized
  | TxWasVoided Text
  | TxWasRefunded Text UUID
  | InvalidTxCommand Text
  deriving (Show, Eq, Generic)

fromSaleTransaction :: Sale.SaleTransaction -> SomeSaleTxState
  ~ called by: Service.Transaction.addItem, Service.Transaction.removeItem, Service.Transaction.addPayment, Service.Transaction.removePayment, Service.Transaction.finalizeTx, Service.Transaction.voidTx, Service.Transaction.refundTx

toSomeSaleTxState :: SaleTxState v -> SomeSaleTxState
  ~ called by: State.SaleTransactionMachine.runTxCommand

txAction :: SaleTxState v -> SaleTxCommand -> ActionResult Identity SaleTxTopology SaleTxState v SaleTxEvent
  ! Created     -> {InProgress via AddItemCmd, Voided via VoidCmd}; everything else is InvalidTxCommand
  ! InProgress  -> {InProgress via item/payment add+remove, Completed via FinalizeCmd, Voided via VoidCmd}
  ! Completed   -> {Voided via VoidCmd, Refunded via RefundCmd}; item and payment commands are invalid
  ! Voided and Refunded are absorbing; any command yields InvalidTxCommand ('Sale transaction is voided' / 'is refunded')
  ! FinalizeCmd from InProgress is legal here whatever the payments; the paid-in-full rule is not in the machine
  ~ clause: (CreatedState sale) (AddItemCmd item)
  ~ clause: (CreatedState sale) (VoidCmd reason)
  ~ clause: (CreatedState sale) cmd
  ~ clause: (InProgressState sale) (AddItemCmd item)
  ~ clause: (InProgressState sale) (RemoveItemCmd iid)
  ~ clause: (InProgressState sale) (AddPaymentCmd payment)
  ~ clause: (InProgressState sale) (RemovePaymentCmd pid)
  ~ clause: (InProgressState sale) FinalizeCmd
  ~ clause: (InProgressState sale) (VoidCmd reason)
  ~ clause: (InProgressState sale) cmd
  ~ clause: (CompletedState sale) (VoidCmd reason)
  ~ clause: (CompletedState sale) (RefundCmd reason refundId)
  ~ clause: (CompletedState sale) cmd
  ~ clause: (VoidedState sale) _
  ~ clause: (RefundedState sale) _
  ~ called by: State.SaleTransactionMachine.runTxCommand

runTxCommand :: SomeSaleTxState -> SaleTxCommand -> (SaleTxEvent, SomeSaleTxState)
  ! callers look only at the returned event; InvalidTxCommand carries the 409 body
  ! the next state it returns is discarded by every caller
  > consumed by: Service.Transaction.addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx
  ~ clause: (SomeSaleTxState _ st) cmd
  ~ called by: Service.Transaction.addItem, Service.Transaction.removeItem, Service.Transaction.addPayment, Service.Transaction.removePayment, Service.Transaction.finalizeTx, Service.Transaction.voidTx, Service.Transaction.refundTx

cmdLabel :: SaleTxCommand -> Text
  ~ literals: "AddItem", "RemoveItem", "AddPayment", "RemovePayment", "Finalize", "Void", +1 more
  ~ called by: State.SaleTransactionMachine.txAction

someTxStatus :: SomeSaleTxState -> Legacy.TransactionStatus
  ~ clause: (SomeSaleTxState sv _)
  ~ no callers in scanned roots

%decision SaleMachineIsAnEarlyCheckOnly
  what:    The crem machine over Sale.SaleTransaction says which command is legal from which status; Service.Transaction uses it for an early 409 and nothing else
  why:     The authoritative check is the status read under the sale row lock in DB.Transaction. The machine and the locked checks must agree. They are two hand-written statements of one rule; the planned formal model would be the single source for both.
  affects: txAction, runTxCommand, fromSaleTransaction


=== BEGIN State/StockPullMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/StockPullMachine.hs
%mod State.StockPullMachine

%ext DataKinds, DeriveGeneric, EmptyCase, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Aeson
%uses Data.Functor.Identity
%uses Data.OpenApi
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics

%untested toSomePullState, pullAction

instance ToJSON PullVertex

instance FromJSON PullVertex

instance ToSchema PullVertex

instance RenderableVertices PullVertex where

type PullTopology =
  'Topology
    '[ '( 'PullPending, '[ 'PullPending, 'PullAccepted, 'PullCancelled])
     , '( 'PullAccepted, '[ 'PullAccepted, 'PullPulling, 'PullCancelled])
     , '( 'PullPulling, '[ 'PullPulling, 'PullFulfilled, 'PullIssue])
     , '( 'PullFulfilled, '[ 'PullFulfilled])
     , '( 'PullCancelled, '[ 'PullCancelled])
     , '( 'PullIssue, '[ 'PullIssue, 'PullAccepted, 'PullCancelled])
     ]

data PullState (v :: PullVertex) where
  PendingState :: PullState 'PullPending
  AcceptedState :: PullState 'PullAccepted
  PullingState :: PullState 'PullPulling
  FulfilledState :: PullState 'PullFulfilled
  CancelledState :: PullState 'PullCancelled
  IssueState :: PullState 'PullIssue

data SomePullState = forall v. SomePullState (SPullVertex v) (PullState v)

data PullCommand
  = AcceptCmd UUID
  | StartPullCmd UUID
  | FulfillCmd UUID
  | ReportIssueCmd Text UUID
  | RetryCmd UUID
  | CancelCmd Text UUID
  deriving (Show, Eq, Generic)

data PullEvent
  = PullWasAccepted UUID
  | PullingWasStarted UUID
  | PullWasFulfilled UUID
  | IssueWasReported Text UUID
  | PullWasRetried UUID
  | PullWasCancelled Text UUID
  | InvalidPullCmd Text
  deriving (Show, Eq, Generic)

fromVertex :: PullVertex -> SomePullState
  ! rebuilds typed state from a database-loaded PullVertex
  ! lossless: every PullVertex maps to exactly one PullState constructor
  ~ clause: PullPending
  ~ clause: PullAccepted
  ~ clause: PullPulling
  ~ clause: PullFulfilled
  ~ clause: PullCancelled
  ~ clause: PullIssue
  ~ called by: Service.Stock.loadPull
  ? tested by: Test.State.StockPullMachineSpec.step

toPullVertex :: SomePullState -> PullVertex
  ! pattern-matches the singleton inside SomePullState (SPullPending, SPullAccepted, ...) to its PullVertex; inverse of fromVertex
  ! Service.Stock.transition persists this value after runPullCommand
  ~ clause: (SomePullState sv _)
  ~ called by: Service.Stock.transition, Service.Stock.acceptPull, Service.Stock.startPull, Service.Stock.fulfillPull, Service.Stock.reportIssue, Service.Stock.retryPull, Service.Stock.cancelPull
  ? tested by: Test.State.StockPullMachineSpec.step

toSomePullState :: PullState v -> SomePullState
  ~ called by: State.StockPullMachine.runPullCommand

pullAction :: PullState v -> PullCommand -> ActionResult Identity PullTopology PullState v PullEvent
  ! Pending  -> {Accepted via AcceptCmd, Cancelled via CancelCmd}; everything else is InvalidPullCmd
  ! Accepted -> {Pulling via StartPullCmd, Cancelled via CancelCmd}
  ! Pulling  -> {Fulfilled via FulfillCmd, Issue via ReportIssueCmd}; cannot be cancelled directly
  ! Issue    -> {Accepted via RetryCmd, Cancelled via CancelCmd}
  ! Fulfilled and Cancelled are absorbing; any further command yields InvalidPullCmd, no state change
  ~ clause: PendingState (AcceptCmd actor)
  ~ clause: PendingState (CancelCmd reason actor)
  ~ clause: PendingState _
  ~ clause: AcceptedState (StartPullCmd actor)
  ~ clause: AcceptedState (CancelCmd reason actor)
  ~ clause: AcceptedState _
  ~ clause: PullingState (FulfillCmd actor)
  ~ clause: PullingState (ReportIssueCmd note actor)
  ~ clause: PullingState _
  ~ clause: FulfilledState _
  ~ clause: CancelledState _
  ~ clause: IssueState (RetryCmd actor)
  ~ clause: IssueState (CancelCmd reason actor)
  ~ clause: IssueState _
  ~ called by: State.StockPullMachine.runPullCommand

runPullCommand :: SomePullState -> PullCommand -> (PullEvent, SomePullState)
  ! wraps pullAction; existential erasure means callers cannot inspect the new vertex's type
  ! callers pattern-match on the returned PullEvent to know which transition fired
  ! InvalidPullCmd indicates same-state with no transition; the SomePullState is unchanged
  > consumed by: Service.Stock.transition (the only orchestrator that runs commands against this machine)
  ~ clause: (SomePullState _ st) cmd
  ~ called by: Service.Stock.transition, Service.Stock.cancelPull
  ? tested by: Test.State.StockPullMachineSpec.step

%decision StateMachineEnforcedAtTypeLevel
  what:    PullState is GADT-indexed by PullVertex; transitions live in pullAction whose type uses crem ActionResult
  why:     The DSL prevents constructing a transition not in PullTopology. Service.Stock.transition relies on this: it persists the new vertex without re-validating, trusting the machine output. Illegal commands produce a PullEvent with constructor InvalidPullCmd, NOT a Haskell exception, so the service layer can map it to err409.
  affects: pullAction, runPullCommand, fromVertex, toPullVertex


=== BEGIN State/TransactionMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/TransactionMachine.hs
%mod State.TransactionMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics
%uses qualified Types.Transaction as T

%untested toSomeTxState, txAction, cmdLabel, someTxStatus

instance RenderableVertices TxVertex where

type TxTopology =
  'Topology
    '[ '( 'TxCreated, '[ 'TxCreated, 'TxInProgress, 'TxVoided])
     , '( 'TxInProgress, '[ 'TxInProgress, 'TxCompleted, 'TxVoided])
     , '( 'TxCompleted, '[ 'TxCompleted, 'TxVoided, 'TxRefunded])
     , '( 'TxVoided, '[ 'TxVoided])
     , '( 'TxRefunded, '[ 'TxRefunded])
     ]

data TxState (v :: TxVertex) where
  CreatedState :: T.Transaction -> TxState 'TxCreated
  InProgressState :: T.Transaction -> TxState 'TxInProgress
  CompletedState :: T.Transaction -> TxState 'TxCompleted
  VoidedState :: T.Transaction -> TxState 'TxVoided
  RefundedState :: T.Transaction -> TxState 'TxRefunded

data SomeTxState = forall v. SomeTxState (STxVertex v) (TxState v)

data TxCommand
  = AddItemCmd T.TransactionItem
  | RemoveItemCmd UUID
  | AddPaymentCmd T.PaymentTransaction
  | RemovePaymentCmd UUID
  | FinalizeCmd
  | VoidCmd Text
  | RefundCmd Text UUID
  deriving (Show, Eq, Generic)

data TxEvent
  = ItemAdded T.TransactionItem
  | ItemRemoved UUID
  | PaymentAdded T.PaymentTransaction
  | PaymentRemoved UUID
  | TxFinalized
  | TxWasVoided Text
  | TxWasRefunded Text UUID
  | InvalidTxCommand Text
  deriving (Show, Eq, Generic)

fromTransaction :: T.Transaction -> SomeTxState
  ! dispatches on transactionStatus field to choose the correct SomeTxState constructor
  ~ no callers in scanned roots
  ? tested by: Test.State.TransactionMachineSpec.spec, Test.Props.StateMachineSpec.someTxState

toSomeTxState :: TxState v -> SomeTxState
  ~ called by: State.TransactionMachine.runTxCommand

txAction :: TxState v -> TxCommand -> ActionResult Identity TxTopology TxState v TxEvent
  ! Created     -> {InProgress via AddItemCmd, Voided via VoidCmd}; everything else is InvalidTxCommand
  ! InProgress  -> {InProgress via item/payment add+remove, Completed via Finalize, Voided via Void}
  ! Completed   -> {Voided via Void, Refunded via Refund}; further item/payment ops are invalid
  ! Voided and Refunded are absorbing; any further command yields InvalidTxCommand
  ! AddItemCmd from Created sets transactionStatus = InProgress on the carried Transaction value, NOT just the type-level vertex
  ~ clause: (CreatedState tx) (AddItemCmd item)
  ~ clause: (CreatedState tx) (VoidCmd reason)
  ~ clause: (CreatedState tx) cmd
  ~ clause: (InProgressState tx) (AddItemCmd item)
  ~ clause: (InProgressState tx) (RemoveItemCmd iid)
  ~ clause: (InProgressState tx) (AddPaymentCmd payment)
  ~ clause: (InProgressState tx) (RemovePaymentCmd pid)
  ~ clause: (InProgressState tx) FinalizeCmd
  ~ clause: (InProgressState tx) (VoidCmd reason)
  ~ clause: (InProgressState tx) cmd
  ~ clause: (CompletedState tx) (VoidCmd reason)
  ~ clause: (CompletedState tx) (RefundCmd reason refundId)
  ~ clause: (CompletedState tx) cmd
  ~ clause: (VoidedState tx) _
  ~ clause: (RefundedState tx) _
  ~ called by: State.TransactionMachine.runTxCommand

runTxCommand :: SomeTxState -> TxCommand -> (TxEvent, SomeTxState)
  ! no module under src imports State.TransactionMachine any more; Service.Transaction uses State.SaleTransactionMachine, which has the same topology over Sale.SaleTransaction
  ! kept for its tests
  > consumed by: tests only
  ~ clause: (SomeTxState _ st) cmd
  ~ no callers in scanned roots
  ? tested by: Test.State.TransactionMachineSpec.spec, Test.Props.StateMachineSpec.spec

cmdLabel :: TxCommand -> Text
  ! human-readable command names used in InvalidTxCommand error messages
  ! MUST stay in sync with TxCommand constructors; partial functions would silently produce 'Cannot ?' messages
  ~ literals: "AddItem", "RemoveItem", "AddPayment", "RemovePayment", "Finalize", "Void", +1 more
  ~ called by: State.TransactionMachine.txAction

someTxStatus :: SomeTxState -> T.TransactionStatus
  ! extracts TransactionStatus from a SomeTxState by inspecting the singleton tag
  > consumed by: tests only
  ~ clause: (SomeTxState sv _)
  ~ no callers in scanned roots

%decision CremForLifecycleEnforcement
  what:    crem (singletons-based type-level state machines) for transaction, register, and stock-pull lifecycles
  why:     Transaction, register, and stock-pull state transitions are legally significant for cannabis compliance — an unintended Created -> Completed shortcut is a reportable violation. crem encodes the topology in types via singletons + GADTs; any transition not declared in the Topology fails to compile. All three machines pair (SomeXxxState, fromXxx, toSomeXxxState) so callers handle existential states without leaking type-level vertices.
  affects: txAction, runTxCommand, fromTransaction, toSomeTxState, someTxStatus



  ~ no callers in scanned roots

whenRoleAtLeast :: Poll UserRole -> UserRole -> Nut -> Nut
  ! Compares the user's role to a minimum via the Ord instance; relies on Types.Auth.FourRoleHierarchyWithMonotonicCapabilities.
  ! Cleanest gate for 'manager or higher' checks; the per-capability gates are more granular but require knowing the right cap name.
  ~ called by: UI.Components.AuthGuard.whenCashierOrAbove, UI.Components.AuthGuard.whenManagerOrAbove, UI.Components.AuthGuard.whenAdmin

whenCashierOrAbove :: Poll UserRole -> Nut -> Nut
  ~ no callers in scanned roots


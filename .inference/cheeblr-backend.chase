%file /home/bismuth/git/cheeblr/backend/src/Effect/InventoryDb.hs
%mod Effect.InventoryDb

%ext DataKinds, FlexibleContexts, GADTs, LambdaCase, OverloadedStrings, TypeApplications, TypeFamilies, TypeOperators

%uses Control.Exception
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map

%uses Foreign
%uses Yoga.JSON

%untested mkSaleMoney, saleMoneyDiscrete, zeroSale, addSale, subtractSale, scaleSale, sumSale, mkRefundMoney
%untested unsafeMkRefundMoney, refundMoneyDiscrete, zeroRefund, addRefund, scaleRefund, sumRefund, negateToRefund, negateFromRefund
%untested discreteToSaleMoney

newtype SaleMoney = SaleMoney (Discrete USD)

derive instance newtypeSaleMoney :: Newtype SaleMoney _

derive newtype instance eqSaleMoney :: Eq SaleMoney

derive newtype instance ordSaleMoney :: Ord SaleMoney

instance showSaleMoney :: Show SaleMoney where


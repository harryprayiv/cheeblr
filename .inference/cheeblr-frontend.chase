%file /home/bismuth/git/cheeblr/frontend/src/Pages/Admin/Tabs/LogViewer.purs
%mod Pages.Admin.Tabs.LogViewer

%uses Prelude
%uses API.Admin
%uses Data.Array
%uses Data.Maybe
%uses Data.Tuple.Nested
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Listeners as DL
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect
%uses Effect.Class.Console as Console
%uses Effect.Ref as Ref
%uses Pages.Admin.Components.SSEStatus
%uses Types.Admin
%uses UI.Leave
%uses Utils.SSE
%uses Yoga.JSON

%untested maxLogEntries, logViewer, renderEntry

maxLogEntries :: Int
  ~ called by: Pages.Admin.Tabs.LogViewer.logViewer

logViewer :: OnLeave -> Nut
  ! Opens API.Admin.logStreamUrl through Utils.SSE; the session cookie is the credential.
  ! Entries live in a Ref owned by the connection. Each message is put in front and the list is cut to maxLogEntries (500).
  ! Connect does nothing while a connection is held. Disconnect closes it and clears the list.
  ! The connection's close action is registered with onLeave.
  ! A message that does not decode is logged to the console and skipped.
  ~ called by: Pages.Admin.Dashboard.page

renderEntry :: LogEvent -> Nut
  ~ called by: Pages.Admin.Tabs.LogViewer.logViewer

%decision LogStreamUsesSSENotWebSocket
  what:    Logs stream over SSE (Server-Sent Events) rather than WebSocket
  why:     SSE is unidirectional (server -> client) which matches the log streaming use case exactly. SSE has automatic reconnect built in; WebSocket requires manual reconnect logic. SSE works through more proxies and corporate firewalls than WebSocket. Cost: SSE doesn't support binary frames, but logs are text anyway.
  affects: logViewer



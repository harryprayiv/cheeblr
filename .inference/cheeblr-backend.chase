%file /home/bismuth/git/cheeblr/backend/src/State/RegisterMachine.hs
%mod State.RegisterMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses API.Transaction
%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics

instance RenderableVertices RegVertex where

type RegTopology =
  'Topology
    '[ '( 'RegClosed, '[ 'RegClosed, 'RegOpen])
     , '( 'RegOpen, '[ 'RegOpen, 'RegClosed])
     ]

data RegState (v :: RegVertex) where
  ClosedState :: Register -> RegState 'RegClosed
  OpenState :: Register -> RegState 'RegOpen

data SomeRegState = forall v. SomeRegState (SRegVertex v) (RegState v)

data RegCommand
  = OpenRegCmd UUID Int
  | CloseRegCmd UUID Int
  deriving (Show, Eq, Generic)

data RegEvent
  = RegOpened Register
  | RegWasClosed Register Int
  | InvalidRegCommand Text
  deriving (Show, Eq, Generic)

fromRegister :: Register -> SomeRegState
  ! dispatches on registerIsOpen field to choose ClosedState or OpenState
  ? tested by: Test.State.RegisterMachineSpec.spec

toSomeRegState :: RegState v -> SomeRegState
  ? no test references

regAction :: RegState v -> RegCommand -> ActionResult Identity RegTopology RegState v RegEvent
  ! Closed -> {Open via OpenRegCmd}; CloseRegCmd from Closed is InvalidRegCommand
  ! Open   -> {Closed via CloseRegCmd}; OpenRegCmd from Open  is InvalidRegCommand
  ! OpenRegCmd sets currentDrawer = expectedDrawer = startCash, sets openedBy
  ! CloseRegCmd computes variance = expectedDrawer - countedCash, sets currentDrawer = countedCash
  ? no test references

runRegCommand :: SomeRegState -> RegCommand -> (RegEvent, SomeRegState)
  ? tested by: Test.State.RegisterMachineSpec.spec, Test.Props.StateMachineSpec.spec



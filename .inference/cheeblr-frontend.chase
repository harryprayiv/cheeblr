mkSaleMoney :: Int -> Maybe SaleMoney
  ~ called by: Types.Primitives.Money.subtractSale, Types.Primitives.Money.scaleSale, Types.Primitives.Money.discreteToSaleMoney

unsafeMkSaleMoney :: Int -> SaleMoney
  ! Skips the >= 0 check; caller must guarantee non-negativity.
  ! No longer used by the app; only the tests call it.
  ~ no callers in scanned roots
  ? tested by: Test.TransactionModel.payment, Test.TransactionModel.spec

saleMoneyDiscrete :: SaleMoney -> Discrete USD
  ~ called by: UI.Transaction.CartView.money, UI.Transaction.ActionBar.actionBar, Pages.TransactionHistory.page, UI.Transaction.PaymentPanel.paymentPanel

saleMoneyCents :: SaleMoney -> Int
  ~ called by: UI.Transaction.Model.totals, UI.Transaction.Model.paidCents, UI.Transaction.Model.remainingCents
  ? tested by: Test.Wire.spec

zeroSale :: SaleMoney
  ~ called by: Types.Primitives.Money.sumSale

addSale :: SaleMoney -> SaleMoney -> SaleMoney
  ~ called by: Types.Primitives.Money.sumSale

subtractSale :: SaleMoney -> SaleMoney -> Maybe SaleMoney
  ! Returns Maybe SaleMoney; subtracting a larger amount yields Nothing (would violate the non-negative invariant).
  ! Use case: discount application can't reduce a price below zero.
  ~ no callers in scanned roots

scaleSale :: SaleMoney -> Int -> Maybe SaleMoney
  ~ no callers in scanned roots

sumSale :: forall f. Foldable f => f SaleMoney -> SaleMoney
  ~ no callers in scanned roots

mkRefundMoney :: Int -> Maybe RefundMoney
  ~ called by: Types.Primitives.Money.scaleRefund

unsafeMkRefundMoney :: Int -> RefundMoney
  ~ no callers in scanned roots

refundMoneyDiscrete :: RefundMoney -> Discrete USD
  ~ no callers in scanned roots

refundMoneyCents :: RefundMoney -> Int
  ~ no callers in scanned roots
  ? tested by: Test.Wire.spec

zeroRefund :: RefundMoney
  ~ called by: Types.Primitives.Money.sumRefund

addRefund :: RefundMoney -> RefundMoney -> RefundMoney
  ~ called by: Types.Primitives.Money.sumRefund

scaleRefund :: RefundMoney -> Int -> Maybe RefundMoney
  ~ no callers in scanned roots

sumRefund :: forall f. Foldable f => f RefundMoney -> RefundMoney
  ~ no callers in scanned roots

negateToRefund :: SaleMoney -> RefundMoney
  ! Converts SaleMoney -> RefundMoney by negating the cents.
  ! If applied to SaleMoney 0, returns RefundMoney 0 (which is valid in both sign domains).
  ! Inverse: negateFromRefund.
  ~ no callers in scanned roots

negateFromRefund :: RefundMoney -> SaleMoney
  ~ no callers in scanned roots

discreteToSaleMoney :: Discrete USD -> Maybe SaleMoney
  ~ no callers in scanned roots

%decision SaleMoneyNonNegativeRefundMoneyNonPositive
  what:    SaleMoney is a smart-constructor newtype requiring cents >= 0; RefundMoney requires cents <= 0
  why:     Sign convention is enforced at the type level so a refund value cannot accidentally appear in a sale record (and vice versa). negateToRefund / negateFromRefund are the explicit conversion functions when crossing between sale and refund contexts. mkSaleMoney / mkRefundMoney return Maybe; unsafeMkSaleMoney / unsafeMkRefundMoney skip validation (used in pure-computation paths where the sign is structurally guaranteed). ReadForeign uses the safe constructor and fails parsing with a clear error if the sign is wrong; never silently truncates.
  affects: mkSaleMoney, mkRefundMoney, unsafeMkSaleMoney, unsafeMkRefundMoney, negateToRefund, negateFromRefund



  ! interpreter stack for the sale, refund and reservation routes; passes cfgStockPolicy (envConfig env) to runTransactionDbIO
  ! also used by Server.Manager.overrideVoidHandler
  ~ called by: Server.Transaction.requireSaleWriter, Server.Transaction.saleServer, Server.Transaction.refundServer, Server.Transaction.reservationServer, Server.Manager.overrideVoidHandler


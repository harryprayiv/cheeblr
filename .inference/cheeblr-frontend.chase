%file /home/bismuth/git/cheeblr/frontend/src/Pages/Feed/Monitor.purs
%mod Pages.Feed.Monitor

%uses Deku.Core
%uses Pages.Admin.Tabs.FeedMonitor
%uses UI.Leave

%untested page

page :: OnLeave -> Nut

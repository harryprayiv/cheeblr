      , teTx        :: Transaction
      , teTimestamp :: UTCTime
      }
  | TransactionVoided
      { teTxId      :: UUID
      , teReason    :: Text
      , teActorId   :: UUID
      , teTimestamp :: UTCTime
      }
  | TransactionRefunded

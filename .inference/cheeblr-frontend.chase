%file /home/bismuth/git/cheeblr/frontend/src/UI/Form.purs
%mod UI.Form

%uses Prelude
%uses Data.Either
%uses Data.Enum
%uses Data.Foldable
%uses Data.Int as Int
%uses Data.Maybe
%uses Data.Tuple
%uses Data.Tuple.Nested
%uses Data.Validation.Semigroup as V
%uses Data.Validation.Semigroup
%uses Deku.Control
%uses Deku.Core
%uses Deku.Control as DC
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Listeners as DL
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect
%uses FRP.Poll
%uses UI.Form.Parser
%uses Web.Event.Event
%uses Web.HTML.HTMLInputElement as Input
%uses Web.HTML.HTMLSelectElement as Select
%uses Web.HTML.HTMLTextAreaElement as TextArea

%untested defaultStyle, runForm, runFormWith, withStyle, isValid, toV, row, inputField
%untested text, textAutofocus, password, textArea, readOnly, select, choice, section
%untested visibleWhen, dependent

type Built a =
  { view :: Array Nut
  , result :: Poll (V.V (Array String) a)
  , reset :: Effect Unit
  }

-- The CSS classes a form renders with. A page picks one Style when it runs
-- the form, so field definitions carry no presentation.
--   field:     wrapper around one label, control and hint
--   line:      the row inside that wrapper, for single-line controls
--   lineTop:   the same row for a textarea, aligned to the top
--   hint:      the parser message shown beside an invalid field
--   section:   wrapper around a titled group of fields
--   heading:   the title of that group

type Style =
  { field :: String
  , line :: String
  , lineTop :: String
  , label :: String
  , input :: String
  , hint :: String
  , section :: String
  , heading :: String
  }

newtype Form a = Form (Style -> (Built a -> Nut) -> Nut)

instance Functor Form where

instance Apply Form where

instance Applicative Form where

type TextSpec =
  { label :: String
  , placeholder :: String
  , initial :: String
  }

defaultStyle :: Style
  ~ called by: Pages.Login.loginStyle, UI.Transaction.PaymentPanel.paymentStyle, Pages.TransactionHistory.reasonStyle, Pages.Registers.formStyle, UI.Form.runForm

runForm :: forall a. Form a -> (Built a -> Nut) -> Nut
  ~ called by: UI.Inventory.ItemForm.itemForm

runFormWith :: forall a. Style -> Form a -> (Built a -> Nut) -> Nut
  ~ called by: Pages.TransactionHistory.page, Pages.Login.page, Pages.Registers.page, UI.Transaction.CreateTransaction.saleScreen, UI.Form.runForm

withStyle :: forall a. Style -> Form a -> Form a
  ~ no callers in scanned roots

isValid :: forall a. Built a -> Poll Boolean
  ! maps Data.Validation.Semigroup.isValid over Built.result; ItemForm and Login use it to style and disable their submit buttons
  ! a sub-form hidden by visibleWhen yields Nothing and never makes it false
  ~ called by: Pages.Login.page, UI.Inventory.ItemForm.itemForm

toV :: forall a. String -> Either String a -> V.V (Array String) a
  ~ called by: UI.Form.inputField, UI.Form.textArea, UI.Form.readOnly, UI.Form.select

row
  :: forall a
   . Style
  -> String
  -> String
  -> Nut
  -> Poll (Either String a)
  -> Nut
  ~ called by: UI.Form.inputField, UI.Form.textArea, UI.Form.readOnly, UI.Form.select

inputField :: forall a. Boolean -> String -> TextSpec -> Parser a -> Form a
  ! stores untrimmed text; parsers trim. Trimming on every keystroke would eat the space while typing a multi-word value.
  ~ called by: UI.Form.text, UI.Form.textAutofocus, UI.Form.password

text :: forall a. TextSpec -> Parser a -> Form a
  ~ called by: Pages.TransactionHistory.reasonForm, Pages.Registers.nameForm, Pages.Registers.cashForm, UI.Transaction.PaymentPanel.paymentForm, UI.Inventory.ItemForm.menuItemForm

textAutofocus :: forall a. TextSpec -> Parser a -> Form a
  ~ called by: Pages.Login.credentialsForm

password :: forall a. TextSpec -> Parser a -> Form a
  ~ called by: Pages.Login.credentialsForm

textArea :: forall a. TextSpec -> Parser a -> Form a
  ! Deku's textarea row has no value attribute, so the binding uses attributeAtYourOwnRisk "value"
  ~ called by: UI.Inventory.ItemForm.menuItemForm

readOnly :: forall a. { label :: String, value :: String } -> Parser a -> Form a
  ! allocates no useHot cell: result is pure (toV label (parse value)) and reset is pure unit
  ! renders a disabled input with " bg-gray-100" appended to Style.input; ItemForm uses it for the SKU with Parser.uuid
  ~ called by: UI.Inventory.ItemForm.menuItemForm

select
  :: forall a
   . BoundedEnum a
  => { label :: String
     , prompt :: String
     , initial :: Maybe a
     , display :: a -> String
     }
  -> Form a
  ! option values are BoundedEnum indices, not Show strings; the prompt option has value "" and parses to Left
  ~ called by: UI.Inventory.ItemForm.menuItemForm

choice
  :: forall a
   . Eq a
  => { options :: Array { value :: a, label :: String }
     , initial :: a
     , groupClass :: String
     , optionClass :: String
     }
  -> Form a
  ! button group over an explicit list for types that are not BoundedEnum (PaymentMethod has Other String); always valid; ignores Style and takes its classes from the spec
  ~ called by: UI.Transaction.PaymentPanel.paymentForm

section :: forall a. String -> Form a -> Form a
  ~ called by: UI.Inventory.ItemForm.menuItemForm

visibleWhen :: forall a. Poll Boolean -> Form a -> Form (Maybe a)
  ~ called by: UI.Transaction.PaymentPanel.paymentForm

dependent
  :: forall k a
   . Form k
  -> (Poll (Maybe k) -> Form a)
  -> Form (Tuple k a)
  ~ called by: UI.Transaction.PaymentPanel.paymentForm

%decision ApplicativeFormOverDekuHooks
  what:    Form a is a newtype over Style -> (Built a -> Nut) -> Nut with Functor/Apply/Applicative only; each field owns one useHot cell of raw text and validity is the parser mapped over it
  why:     Adding a form field is one line in an ado block plus one name in the result record. Applicative only: the set of fields is static, so reset and error accumulation (V (Array String)) are derivable. There is deliberately no Monad instance. Validity is never stored, so it cannot go stale.
  affects: runForm, runFormWith, text, select, section

%decision StyleSuppliedAtRunSite
  what:    All CSS classes come from a Style record passed to runFormWith; field definitions carry no presentation
  why:     ItemForm uses defaultStyle (Tailwind), Login and the payment form pass their own. Setting hint = "hidden" hides hints for forms that report problems elsewhere.
  affects: defaultStyle, runFormWith, withStyle

%decision DependentFieldsStayMounted
  what:    dependent passes the first form's parsed value as a Poll to a second form built once; visibleWhen hides a sub-form with the 'hidden' class and makes it yield Nothing
  why:     Hidden fields keep their text and do not count against validity. Fields cannot be created dynamically (for example one input per cart line); that needs a different combinator.
  affects: dependent, visibleWhen



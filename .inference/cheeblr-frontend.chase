%file /home/bismuth/git/cheeblr/frontend/src/API/Inventory.purs
%mod API.Inventory

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Config.LiveView
%uses Data.Either
%uses Effect.Aff
%uses Effect.Class
%uses Effect.Exception
%uses Effect.Now
%uses Fetch
%uses Fetch.Yoga.Json
%uses GraphQL.API.Inventory
%uses Types.Inventory

%untested writeInventory, readInventory, updateInventory, deleteInventory, fetchInventoryFromJson, fetchInventoryFromHttp, fetchInventory

writeInventory :: MenuItem -> Aff (Either ApiError MutationResponse)
  ~ called by: UI.Inventory.ItemForm.itemForm

readInventory :: Aff (Either ApiError Inventory)
  ~ called by: Pages.DeleteItem.page, Pages.EditItem.page

updateInventory :: MenuItem -> Aff (Either ApiError MutationResponse)
  ~ called by: UI.Inventory.ItemForm.itemForm

deleteInventory :: String -> Aff (Either ApiError MutationResponse)
  ! The backend answers 404 'Item not found' for an unknown SKU, which arrives as Refused 404.
  ~ called by: UI.Inventory.DeleteItem.deleteItem

fetchInventoryFromJson :: FetchConfig -> Aff (Either ApiError Inventory)
  ! Reads ./inventory.json from the same origin; relative path means it is served by the same web server as the app.
  ! Appends ?t=<currentTimestamp> for cache-busting; the file might be updated out-of-band.
  ! No auth headers; the file is assumed to be public on the same origin.
  ~ called by: API.Inventory.fetchInventory

fetchInventoryFromHttp :: FetchConfig -> Aff (Either ApiError Inventory)
  ~ called by: API.Inventory.fetchInventory

fetchInventory :: FetchConfig -> QueryMode -> Aff (Either ApiError Inventory)
  ! Three-way dispatch on QueryMode; the default is GqlMode per Config.LiveView.defaultViewConfig.
  ! JsonMode and HttpMode are alternatives for development or fallback; the production path is GqlMode.
  ~ called by: Pages.CreateTransaction.load, UI.Transaction.CreateTransaction.saleScreen

%decision QueryModeDispatchInFetchInventory
  what:    fetchInventory dispatches between three data sources by QueryMode: JsonMode (static file), HttpMode (REST API), GqlMode (GraphQL)
  why:     JsonMode reads ./inventory.json from the app's own origin with a cache-busting timestamp and no credentials. HttpMode reads the configured apiEndpoint through API.Request.getAbsolute. GqlMode calls GraphQL.API.Inventory.readInventoryGql and is the default in Config.LiveView.defaultViewConfig. The mode is a source-level setting. No screen changes it.
  affects: fetchInventory, fetchInventoryFromJson, fetchInventoryFromHttp



txDomainToRow :: Transaction -> TransactionRow Expr
  ? no test references

txRowToDomain :: TransactionRow Result -> [TransactionItem] -> [PaymentTransaction] -> Transaction
  ! pure decoder from a Rel8 TransactionRow plus already loaded items and payments to a Types.Transaction
  ! lives here, not in Types.Transaction, so Types.Transaction has no Rel8 or hasql dependency
  > consumed by: DB.Transaction.hydrateTx
  > consumed by: DB.Transaction.getAllTransactions, getTransactionById
  ? no test references

tiDomainToRow :: TransactionItem -> TransactionItemRow Expr
  ? no test references

itemRowToDomain :: TransactionItemRow Result -> [TaxRecord] -> [DiscountRecord] -> TransactionItem
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

taxDomainToRow :: UUID -> UUID -> TaxRecord -> TaxRow Expr
  ? no test references

taxRowToDomain :: TaxRow Result -> TaxRecord
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

discountDomainToRow :: UUID -> UUID -> Maybe UUID -> DiscountRecord -> DiscountRow Expr
  ? no test references

getDiscountPercent :: DiscountType -> Maybe Double
  ? tested by: Test.DB.PureFunctionsSpec.spec

discountRowToDomain :: DiscountRow Result -> DiscountRecord
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

paymentDomainToRow :: PaymentTransaction -> PaymentRow Expr
  ? no test references

paymentRowToDomain :: PaymentRow Result -> PaymentTransaction
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

negateTransactionItem :: TransactionItem -> TransactionItem
  ? tested by: Test.Props.NegateSpec.spec, Test.DB.PureFunctionsSpec.spec

negateDiscountRecord :: DiscountRecord -> DiscountRecord
  ? tested by: Test.Props.NegateSpec.spec, Test.DB.PureFunctionsSpec.spec

negateTaxRecord :: TaxRecord -> TaxRecord
  ? tested by: Test.Props.NegateSpec.spec, Test.DB.PureFunctionsSpec.spec

negatePaymentTransaction :: PaymentTransaction -> PaymentTransaction
  ? tested by: Test.Props.NegateSpec.spec, Test.DB.PureFunctionsSpec.spec

showStatus :: TransactionStatus -> Text
  ? tested by: Test.Props.ParseShowSpec.spec, Test.DB.PureFunctionsSpec.spec

showTransactionType :: TransactionType -> Text
  ? tested by: Test.Props.ParseShowSpec.spec, Test.DB.PureFunctionsSpec.spec

showPaymentMethod :: PaymentMethod -> Text
  ? tested by: Test.Props.ParseShowSpec.spec, Test.DB.PureFunctionsSpec.spec, Test.Integration.JsonContractSpec.spec

showTaxCategory :: TaxCategory -> Text
  ? tested by: Test.Props.ParseShowSpec.spec, Test.DB.PureFunctionsSpec.spec

showDiscountType :: DiscountType -> Text
  ! loses information: PercentOff/AmountOff/Custom all collapse to their tag without the payload
  ! discRowAmount and discRowPercent in the row carry the payload; showDiscountType + getDiscountPercent jointly preserve it
  ? tested by: Test.Props.ParseShowSpec.spec, Test.DB.PureFunctionsSpec.spec

parseDiscountType :: Text -> Maybe Double -> Int -> DiscountType
  ? tested by: Test.Types.TransactionSpec.spec

parseTransactionStatus :: String -> TransactionStatus
  ! LENIENT: an unknown string becomes Created
  ! round-trips against showStatus for the five codes CREATED, IN_PROGRESS, COMPLETED, VOIDED, REFUNDED
  ! since 2026-10-08 a check constraint on transaction.status refuses any other text, so Postgres can no longer store a status this function would misread
  > consumed by: DB.Transaction.Rows.txRowToDomain (decodes the status column on every load)
  ? tested by: Test.Props.ParseShowSpec.spec, Test.Types.TransactionSpec.spec

parseTransactionType :: String -> TransactionType
  ! LENIENT: an unknown string becomes Sale. No constraint backs the transaction_type column.
  ! RETURN is the type of a refund row; Types.Transaction.Conversion.fromLegacyTransaction uses the type, not the status or the refunded flag, to tell a refund from a sale
  ? tested by: Test.Props.ParseShowSpec.spec, Test.Types.TransactionSpec.spec

parsePaymentMethod :: String -> PaymentMethod
  ! case-insensitive for canonical methods; 'OTHER:foo' / 'Other:foo' carries arbitrary text payload
  ! fallback for unrecognized strings is Other s (preserves the original text), NOT a default constructor
  > consumed by: DB.Transaction.Rows.paymentRowToDomain
  ? tested by: Test.Props.ParseShowSpec.spec, Test.Types.TransactionSpec.spec, Test.Integration.JsonContractSpec.spec

parseTaxCategory :: String -> TaxCategory
  ! LENIENT: an unknown string becomes NoTax. Domain.TaxRule has its own strict decoder and does not use this one.
  > consumed by: DB.Transaction.Rows.taxRowToDomain
  ? tested by: Test.Props.ParseShowSpec.spec, Test.Types.TransactionSpec.spec

%decision RowConversionsLiveOutsideTypes
  what:    DB.Transaction.Rows owns the conversions between Rel8 rows and domain values and the text codes for status, type, payment method, tax category and discount type; Types.Transaction stays free of Rel8 and hasql
  why:     Types.Transaction is imported by modules that must not pull in Rel8 or hasql. These functions were split out of DB.Transaction on 2026-10-08 because that file had passed a thousand lines. DB.Transaction re-exports this module, so importers of DB.Transaction see the same names as before. The parsers exist only to round-trip with text columns.
  affects: txRowToDomain, txDomainToRow, parseTransactionStatus, parseTransactionType, parsePaymentMethod, parseTaxCategory, showStatus

%open_issue LenientBoundaryParsers
  what:     parseTransactionStatus, parseTransactionType and parseTaxCategory turn unknown text into a valid value instead of failing
  why:      A damaged or mistyped row is read as a different, valid row. The status column is now protected by a check constraint. The type and tax category columns are not. Planned fix: make each parser return a failure and let it surface as a 500. DB.Transaction.Typed already reports a decode failure for the shapes it checks.
  blocking: trusting any row read from the sale tables
  affects:  parseTransactionStatus, parseTransactionType, parseTaxCategory



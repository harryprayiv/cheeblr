%file /home/bismuth/git/cheeblr/backend/src/DB/Transaction/Refund.hs
%mod DB.Transaction.Refund

%ext DisambiguateRecordFields, OverloadedStrings

%uses Control.Exception
%uses Control.Monad
%uses Control.Monad.IO.Class
%uses Data.Scientific
%uses qualified Data.Text as T
%uses Data.UUID
%uses Data.UUID.V4
%uses qualified Hasql.Decoders as Decoders
%uses qualified Hasql.Encoders as Encoders
%uses qualified Hasql.Session as Session
%uses qualified Hasql.Statement as Statement
%uses Rel8
%uses DB.Database
%uses DB.Schema
%uses qualified DB.Transaction as DBT
%uses Domain.StockPolicy
%uses Types.Primitives.Money
%uses Types.Primitives.Quantity
%uses qualified Types.Transaction as Legacy
%uses Types.Transaction.Conversion
%uses qualified Types.Transaction.Refund as Refund

itemDomainToRow :: Refund.Item -> TransactionItemRow Expr
  ? no test references

itemRowToDomain ::
  TransactionItemRow Result ->
  [Refund.Tax] ->
  [Refund.Discount] ->
  Refund.Item
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

discountDomainToRow ::
  UUID -> UUID -> Maybe UUID -> Refund.Discount -> DiscountRow Expr
  ? no test references

discountRowToDomain :: DiscountRow Result -> Refund.Discount
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

taxDomainToRow :: UUID -> UUID -> Refund.Tax -> TaxRow Expr
  ? no test references

taxRowToDomain :: TaxRow Result -> Refund.Tax
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

paymentDomainToRow :: Refund.Payment -> PaymentRow Expr
  ? no test references

paymentRowToDomain :: PaymentRow Result -> Refund.Payment
  ? tested by: Test.DB.Transaction.SaleSpec.spec, Test.DB.Transaction.RefundSpec.spec

refundTxDomainToRow :: Refund.RefundTransaction -> TransactionRow Expr
  ! DB.Transaction.Rows.txDomainToRow composed with Types.Transaction.Conversion.refundToLegacyTransaction; every refund column goes through that conversion, so a field it drops is dropped from the database
  ? no test references

lockSaleForRefund :: Statement.Statement UUID (Maybe (T.Text, Bool))
  ! SELECT status, is_refunded FROM transaction WHERE id = $1 FOR UPDATE
  ! a row left by older code with status COMPLETED and is_refunded true is refused for refund but would still pass voidTransaction
  ? no test references

writeTypedRefund ::
  DBPool -> RestockPolicy -> Refund.RefundTransaction -> IO Legacy.Transaction
  ! intent: Persist a typed refund and mark the original sale, atomically
  ! effects: DBPool, IO
  ! takes a RestockPolicy argument from configuration
  ! ORDER under the lock: insert refund row, insert each refund line with its taxes and discounts, insert refund payments, set the sale to REFUNDED, then restockSaleS on the ORIGINAL sale id when the policy is ReturnToStock
  ! amounts come from the typed value as computed by Types.Transaction.Conversion.toRefundTransaction; nothing is re-derived
  ! a refund is always of the whole sale; there is no partial refund
  ! throws SaleNotOpen after rollback when the sale is not refundable; Service.Transaction.refundTx turns that into 409
  ! returns refundToLegacyTransaction of its input without re-reading
  > consumed by: Effect.TransactionDb.runTransactionDbIO (WriteRefund)
  ? no test references

%decision RefundIsAtomicLockedAndSingleUse
  what:    writeTypedRefund runs in one SQL transaction under the original sale's row lock and proceeds only when the locked row is (status COMPLETED, is_refunded false)
  why:     Before 2026-10-08 the refund was several separate statements and nothing stopped a second refund: the sale stayed COMPLETED, so the state machine approved every repeat, each paying out the full amount again. The refund row has type RETURN, status COMPLETED, negated amounts and reference_transaction_id = the sale. The original sale's status becomes REFUNDED in the same update that sets is_refunded and refund_reason (owner decision 2026-10-08). A REFUNDED sale can be neither refunded nor voided. Void is for a sale before settlement and refund for one after; they are alternatives (owner: follow banking and retail practice).
  affects: writeTypedRefund, lockSaleForRefund



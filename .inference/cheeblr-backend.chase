  ? tested by: Test.Manager.LogicSpec.spec

buildAlerts :: AppEnv -> [Transaction] -> [Register] -> Inventory -> IO [ManagerAlert]
  ? no test references

buildDayStats :: [Transaction] -> UTCTime -> LocationDayStats
  ! intent: The day's figures from every transaction created on the UTC day of the given time
  ! splits rows by type: a sale (any type but Return) counts when its status is Completed or Refunded; a return counts when its status is Completed
  ! revenue = sale totals + return totals; return totals are negative, so a sale refunded the same day nets to zero
  ! a sale refunded on a later day keeps its revenue on the sale's day; the return lowers the refund's day
  ! transaction count = number of sales; a return row is not counted
  ! average = revenue after returns / number of sales (author's choice, not confirmed by the owner; the alternative is gross sales / count)
  ! refund count = sales with the refunded flag; void count = rows with the voided flag
  ! Before 2026-10-08 it summed every Completed row. Once refunded sales got status REFUNDED that would have subtracted each refund twice.
  ! spec: [refunded sale 1000, its return -1000, completed sale 2000] => revenue 2000, count 2, refunds 1, average 1000
  > consumed by: Server.Manager.activityHandler
  > consumed by: Server.Manager.dailyReportHandler
  ? tested by: Test.Manager.LogicSpec.spec

activityHandler :: AppEnv -> Maybe Text -> Handler ActivitySummary
  ? no test references

activityStreamHandler ::
  AppEnv -> Maybe Text -> Maybe Int64 -> Tagged Handler Application
  ? no test references

alertsHandler :: AppEnv -> Maybe Text -> Handler [ManagerAlert]
  ? no test references

dailyReportHandler ::
  AppEnv -> Maybe Text -> DailyReportRequest -> Handler DailyReportResult
  ? no test references

complianceReportHandler ::
  AppEnv -> Maybe Text -> ComplianceReportRequest -> Handler ComplianceReportResult
  ? no test references

overrideVoidHandler ::
  AppEnv -> UUID -> Maybe Text -> OverrideRequest -> Handler MutationResponse
  ! requires capCanVoidTransaction, then runs Service.Transaction.voidTx through Server.Transaction.runTxEff, the same path as POST /sale/void/:id
  ! Before 2026-10-06 it marked the row voided directly, skipping the state machine, reservation release, pull cancellation and the event
  ! 404 for a missing sale, 409 for one that cannot be voided
  ? no test references

overrideDiscountHandler ::
  AppEnv -> UUID -> Maybe Text -> OverrideRequest -> Handler MutationResponse
  ? no test references

managerServerImpl :: AppEnv -> Server ManagerAPI
  ? no test references

%open_issue DailyReportInventsCashAndCard
  what:     dailyReportHandler reports cash and card each as (count * average) / 2; no sum of payments by method exists behind it
  why:      The total and the transaction count come from buildDayStats and are real. The split is not.
  blocking: showing this report to anyone
  affects:  dailyReportHandler

%open_issue ManagerRoutesLoadEveryTransaction
  what:     activityHandler, alertsHandler and dailyReportHandler each call DB.Transaction.getAllTransactions, which hydrates every sale ever made
  why:      Fine with a hundred sales. The day's figures should be one aggregate query limited to the day.
  blocking: manager screen at real data volume
  affects:  activityHandler, alertsHandler, dailyReportHandler

%open_issue DayIsTheUtcDay
  what:     buildDayStats takes the day from utctDay; a location has no time zone setting
  why:      For a store in Massachusetts the figures roll over at seven or eight in the evening.
  blocking: correct daily figures
  affects:  buildDayStats



%mod Service.Stock

%ext FlexibleContexts, OverloadedStrings, TypeOperators

%uses qualified Data.ByteString.Lazy as LBS
%uses Data.Text
%uses qualified Data.Text.Encoding as TE
%uses Data.UUID
%uses Effectful
%uses Effectful.Error.Static
%uses Servant

  ~ called by: Pages.Registers.page

nameForm :: Form String
  ~ called by: Pages.Registers.page

cashForm :: String -> Form Int
  ! One dollar-amount field parsed by UI.Form.Parser.cents.
  ~ called by: Pages.Registers.page

describeVariance :: Int -> String
  ! Variance is expected minus counted, in cents. Zero matches, positive is short, negative is over.
  ~ called by: Pages.Registers.page

page :: SessionResponse -> Nut
  ! The list comes from API.Register.getRegisters and is read again after every action, accepted or refused.
  ! One request runs at a time; submit buttons are disabled while busy and while the form is invalid.
  ! A user who cannot manage registers and finds none is told to ask a manager.
  ! Every register is created under Config.Entity.dummyLocationId.
  ~ called by: Main.main

submit
  :: forall a
   . Poll Boolean
  -> String
  -> Built a
  -> (a -> Effect Unit)
  -> Nut
  ! Runs the action with the form's value only when the form is valid and no request is running.
  ~ called by: Pages.Registers.page

%decision RegistersAreManagedOnOnePage
  what:    Registers are created, opened, closed and chosen for this device here and nowhere else
  why:     Create is shown with capCanManageRegisters. Owner decision: only a manager or an admin creates a register. The backend enforces it. Open is shown with capCanOpenRegister on a closed register and takes the starting cash. Close is shown with capCanCloseRegister on an open register and takes the counted cash. A new register is closed. Creating and opening are separate steps, so a failed open cannot leave a half-made register behind an error. 'Use on this device' stores the register id through Services.RegisterService. The sale page sells on that register.
  affects: page

%open_issue RegistersPageIsUnstyled
  what:     The page uses class names that have no CSS rules yet
  why:      register-row, register-name, register-state, register-device, register-drawer, register-action, register-create, register-list, registers-page and register-needed.
  affects:  page



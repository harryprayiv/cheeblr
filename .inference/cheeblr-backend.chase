%untested fromLegacyTransaction, fromLegacyToSale, fromLegacyToRefund, saleItemFromLegacy, refundItemFromLegacy, saleDiscountFromLegacy, refundDiscountFromLegacy, saleTaxFromLegacy
%untested refundTaxFromLegacy, salePaymentFromLegacy, refundPaymentFromLegacy, saleMoneyOr, refundMoneyOr, saleQuantityOr, refundQuantityOr, refundToLegacyTransaction
%untested refundItemToLegacy, refundDiscountToLegacy, refundTaxToLegacy, refundPaymentToLegacy, saleToLegacyTransaction, saleDiscountToLegacy, saleTaxToLegacy, saleTypeToLegacy

toRefundItem :: Sale.Item -> Refund.Item
  ~ called by: Types.Transaction.Conversion.toRefundTransaction
  ? tested by: Test.Types.Transaction.ConversionSpec.spec

toRefundDiscount :: Sale.Discount -> Refund.Discount
  ~ called by: Types.Transaction.Conversion.toRefundItem
  ? tested by: Test.Types.Transaction.ConversionSpec.spec

toRefundTax :: Sale.Tax -> Refund.Tax
  ~ called by: Types.Transaction.Conversion.toRefundItem
  ? tested by: Test.Types.Transaction.ConversionSpec.spec

toRefundPayment :: Sale.Payment -> Refund.Payment
  ~ called by: Types.Transaction.Conversion.toRefundTransaction
  ? tested by: Test.Types.Transaction.ConversionSpec.spec

toRefundTransaction
  :: UTCTime
  -> UUID
  -> [UUID]
  -> [UUID]
  -> Text
  -> Sale.SaleTransaction
  -> Either Text Refund.RefundTransaction
  ~ called by: Service.Transaction.refundTx
  ? tested by: Test.ProbeSpec.spec

fromLegacyTransaction
  :: Legacy.Transaction
  -> Either Text (Either Sale.SaleTransaction Refund.RefundTransaction)
  ! decides sale or refund from transactionType alone: Return is a refund, every other type is a sale
  ! a sale converts with any status, including Refunded
  ~ called by: DB.Transaction.Typed.hydrateTxTyped, DB.Transaction.Typed.getTransactionByIdTyped, DB.Transaction.Typed.getAllTransactionsTyped, DB.Transaction.Typed.getTransactionsByLocationTyped, Effect.TransactionDb.expectSaleTx, Effect.TransactionDb.expectRefundTx, Effect.TransactionDb.runTransactionDbPure

fromLegacyToSale
  :: Sale.SaleType
  -> Legacy.Transaction
  -> Either Text Sale.SaleTransaction
  ~ literals: "subtotal", "discountTotal", "taxTotal", "total"
  ~ called by: Types.Transaction.Conversion.fromLegacyTransaction

fromLegacyToRefund :: Legacy.Transaction -> Either Text Refund.RefundTransaction
  ~ fails: "legacy refund missing referenceTransactionId", "legacy refund missing refundReason", "legacy refund missing completed timestamp"
  ~ literals: "subtotal", "discountTotal", "taxTotal", "total"
  ~ called by: Types.Transaction.Conversion.fromLegacyTransaction

saleItemFromLegacy :: Legacy.TransactionItem -> Either Text Sale.Item
  ~ literals: "itemQuantity", "itemPricePerUnit", "itemSubtotal", "itemTotal"
  ~ called by: Types.Transaction.Conversion.fromLegacyToSale, Effect.TransactionDb.expectSaleItem

refundItemFromLegacy :: Legacy.TransactionItem -> Either Text Refund.Item
  ~ literals: "itemQuantity", "itemPricePerUnit", "itemSubtotal", "itemTotal"
  ~ called by: Types.Transaction.Conversion.fromLegacyToRefund

saleDiscountFromLegacy :: Legacy.DiscountRecord -> Either Text Sale.Discount
  ~ literals: "discountAmount"
  ~ called by: Types.Transaction.Conversion.saleItemFromLegacy

refundDiscountFromLegacy :: Legacy.DiscountRecord -> Either Text Refund.Discount
  ~ literals: "discountAmount"
  ~ called by: Types.Transaction.Conversion.refundItemFromLegacy

saleTaxFromLegacy :: Legacy.TaxRecord -> Either Text Sale.Tax
  ~ literals: "taxAmount"
  ~ called by: Types.Transaction.Conversion.saleItemFromLegacy

refundTaxFromLegacy :: Legacy.TaxRecord -> Either Text Refund.Tax
  ~ literals: "taxAmount"
  ~ called by: Types.Transaction.Conversion.refundItemFromLegacy

salePaymentFromLegacy :: Legacy.PaymentTransaction -> Either Text Sale.Payment
  ~ literals: "paymentAmount", "paymentTendered", "paymentChange"
  ~ called by: Types.Transaction.Conversion.fromLegacyToSale, Effect.TransactionDb.expectSalePayment

refundPaymentFromLegacy :: Legacy.PaymentTransaction -> Either Text Refund.Payment
  ~ literals: "paymentAmount", "paymentTendered", "paymentChange"
  ~ called by: Types.Transaction.Conversion.fromLegacyToRefund

saleMoneyOr :: Text -> Int -> Either Text SaleMoney
  ~ fails: "sale "
  ~ called by: Types.Transaction.Conversion.fromLegacyToSale, Types.Transaction.Conversion.saleItemFromLegacy, Types.Transaction.Conversion.refundItemFromLegacy, Types.Transaction.Conversion.saleDiscountFromLegacy, Types.Transaction.Conversion.saleTaxFromLegacy, Types.Transaction.Conversion.salePaymentFromLegacy

refundMoneyOr :: Text -> Int -> Either Text RefundMoney
  ~ fails: "refund "
  ~ called by: Types.Transaction.Conversion.fromLegacyToRefund, Types.Transaction.Conversion.refundItemFromLegacy, Types.Transaction.Conversion.refundDiscountFromLegacy, Types.Transaction.Conversion.refundTaxFromLegacy, Types.Transaction.Conversion.refundPaymentFromLegacy

saleQuantityOr :: Text -> Int -> Either Text SaleQuantity
  ~ fails: "sale "
  ~ called by: Types.Transaction.Conversion.saleItemFromLegacy

refundQuantityOr :: Text -> Int -> Either Text RefundQuantity
  ~ fails: "refund "
  ~ called by: Types.Transaction.Conversion.refundItemFromLegacy

refundToLegacyTransaction :: Refund.RefundTransaction -> Legacy.Transaction
  ! MUST carry every field fromLegacyToRefund requires: referenceTransactionId, refundReason, completed
  ! Before 2026-10-08 it set transactionRefundReason = Nothing. The reason was never stored, converting the written refund back failed with 'legacy refund missing refundReason', and the error call killed the request. Every refund wrote its rows and then crashed, and no stored refund could be read. The refund routes had never worked end to end.
  ~ called by: DB.Transaction.Refund.refundTxDomainToRow, DB.Transaction.Refund.writeTypedRefund, Effect.TransactionDb.runTransactionDbPure

refundItemToLegacy :: Refund.Item -> Legacy.TransactionItem
  ~ called by: Types.Transaction.Conversion.refundToLegacyTransaction

refundDiscountToLegacy :: Refund.Discount -> Legacy.DiscountRecord
  ~ called by: Types.Transaction.Conversion.refundItemToLegacy

refundTaxToLegacy :: Refund.Tax -> Legacy.TaxRecord
  ~ called by: Types.Transaction.Conversion.refundItemToLegacy

refundPaymentToLegacy :: Refund.Payment -> Legacy.PaymentTransaction
  ~ called by: Types.Transaction.Conversion.refundToLegacyTransaction

saleToLegacyTransaction :: Sale.SaleTransaction -> Legacy.Transaction
  ~ called by: Service.Transaction.createSaleSvc, Effect.TransactionDb.runTransactionDbIO, Service.Transaction.finalizeTx, Effect.TransactionDb.runTransactionDbPure

saleItemToLegacy :: Sale.Item -> Legacy.TransactionItem
  ~ called by: Service.Transaction.addItem, Effect.TransactionDb.runTransactionDbIO, Types.Transaction.Conversion.saleToLegacyTransaction, Effect.TransactionDb.runTransactionDbPure
  ? tested by: Test.Service.TransactionSpec.testItem, Test.Service.SaleSpec.saleWithItem, Test.Service.SaleSpec.saleWithItemAndPayment

saleDiscountToLegacy :: Sale.Discount -> Legacy.DiscountRecord
  ~ called by: Types.Transaction.Conversion.saleItemToLegacy

saleTaxToLegacy :: Sale.Tax -> Legacy.TaxRecord
  ~ called by: Types.Transaction.Conversion.saleItemToLegacy

salePaymentToLegacy :: Sale.Payment -> Legacy.PaymentTransaction
  ~ called by: Service.Transaction.addPayment, Effect.TransactionDb.runTransactionDbIO, Types.Transaction.Conversion.saleToLegacyTransaction, Effect.TransactionDb.runTransactionDbPure
  ? tested by: Test.Service.TransactionSpec.testPayment, Test.Service.SaleSpec.saleWithItemAndPayment

saleTypeToLegacy :: Sale.SaleType -> Legacy.TransactionType
  ~ clause: Sale.StandardSale
  ~ clause: Sale.Exchange
  ~ clause: Sale.InventoryAdjustment
  ~ clause: Sale.ManagerComp
  ~ clause: Sale.Administrative
  ~ called by: Types.Transaction.Conversion.saleToLegacyTransaction



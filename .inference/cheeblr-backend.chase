%file /home/bismuth/git/cheeblr/backend/src/DB/Transaction/Tables.hs
%mod DB.Transaction.Tables

%ext OverloadedStrings

%uses Data.ByteString
%uses qualified Hasql.Session as Session
%uses qualified Hasql.Statement as Statement
%uses DB.Database

%untested createTransactionTables, addConstraintOnce, createSaleConstraints

createTransactionTables :: DBPool -> IO ()
  ! idempotent CREATE TABLE IF NOT EXISTS for transaction, register, inventory_reservation, transaction_item, transaction_tax, discount, payment_transaction
  ! ON DELETE CASCADE chains: tx -> items -> taxes/discounts; tx -> payments
  ! no migration support; schema changes require manual ALTER
  ! the constraints are added separately by createSaleConstraints
  ~ no callers in scanned roots

addConstraintOnce :: ByteString -> ByteString -> ByteString -> Statement.Statement () ()
  ! runs a DO block that asks pg_constraint whether a constraint of that name exists and adds it only when it does not
  ! this is what makes createSaleConstraints safe to run on every startup
  ~ called by: DB.Transaction.Tables.createSaleConstraints

createSaleConstraints :: DBPool -> IO ()
  ! intent: Make Postgres refuse the wrong states the code is meant to prevent
  ! unique index on transaction_item (transaction_id, menu_item_sku): one line per sku per sale
  ! partial unique index on inventory_reservation (transaction_id, item_sku) WHERE status = 'Reserved': one live reservation per sku per sale
  ! CHECK menu_items.quantity >= 0
  ! CHECK transaction_item.quantity <> 0. Not > 0, because a refund stores its lines with negated quantities.
  ! CHECK inventory_reservation.quantity > 0
  ! CHECK inventory_reservation.status IN ('Reserved', 'Released', 'Completed')
  ! CHECK transaction.status IN ('CREATED', 'IN_PROGRESS', 'COMPLETED', 'VOIDED', 'REFUNDED')
  ! foreign key inventory_reservation.transaction_id -> transaction
  ! adding these to a database that already holds rows breaking them fails; the dev database had its sale tables emptied on 2026-10-08 for that reason
  ~ literals: "menu_items", "transaction_item", "transaction"
  ~ called by: DB.Transaction.Tables.createTransactionTables

%decision ConstraintsBehindTheCode
  what:    Every rule the sale code relies on that Postgres can express cheaply is also a constraint or unique index
  why:     A bug that would have stored a silent wrong number now fails a statement. The partial unique index on live reservations is what makes the match in DB.Transaction.deleteTransactionItem unique by rule. Deliberately NOT added: a foreign key from transaction_item to menu_items, because what deleting a menu item with sale history should mean is undecided; and a check that total = subtotal - discount + tax, because totals are written by a separate statement in the same transaction and a CHECK is evaluated per statement. nix/sale-checks/rows.sh checks that total rule on every row instead.
  affects: createSaleConstraints, addConstraintOnce



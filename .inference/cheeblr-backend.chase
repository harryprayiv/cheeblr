=== BEGIN DB/Transaction.hs ===

%file /home/bismuth/git/cheeblr/backend/src/DB/Transaction.hs
%mod DB.Transaction

%ext DisambiguateRecordFields, FlexibleContexts, OverloadedStrings, ScopedTypeVariables

%uses Control.Exception
%uses Control.Monad
%uses Control.Monad.IO.Class
%uses Data.Int
%uses Data.List
%uses Data.Text
%uses Data.Time
%uses Data.Typeable
%uses Data.UUID
%uses Data.UUID.V4
%uses qualified Hasql.Decoders as Decoders
%uses qualified Hasql.Encoders as Encoders
%uses qualified Hasql.Session as Session
%uses qualified Hasql.Statement as Statement
%uses Rel8
%uses DB.Database
%uses DB.Schema
%uses DB.Transaction.Rows
%uses DB.Transaction.Tables
%uses Domain.SaleRules
%uses Domain.StockPolicy
%uses Types.Transaction

%untested itemsForTx, taxesForItem, discountsForItem, paymentsForTx, hydrateTx, hydrateItem, getAllTransactions, getTransactionById
%untested lockTransactionRow, lockTransactionStatus, lockMenuItemQuantity, reservedQuantityS, insertItemS, insertPaymentS, releaseReservedForTxS, restockSaleS
%untested updateTotalsS, createTransaction, insertTransactionItem, insertPaymentTransaction, voidTransaction, updateTransactionStatus, clearTransaction, finalizeTransaction
%untested addTransactionItem, deleteTransactionItem, addPaymentTransaction, deletePaymentTransaction, updateTransactionTotals, getTransactionIdByItemId, getTransactionIdByPaymentId, getInventoryAvailability

data InventoryException
  = ItemNotFound UUID
  | InsufficientInventory UUID Int Int
  | SaleNotOpen UUID
  | LineRejected Text
  | FinalizeRefused [Text]
  deriving (Show, Typeable)

instance Exception InventoryException

data AddedLine = AddedLine
  { addedLineItem     :: TransactionItem
  , addedLineReplaced :: [(UUID, Int)]
  }

itemsForTx :: UUID -> Query (TransactionItemRow Expr)
  ~ called by: DB.Transaction.hydrateTx

taxesForItem :: UUID -> Query (TaxRow Expr)
  ~ called by: DB.Transaction.hydrateItem

discountsForItem :: UUID -> Query (DiscountRow Expr)
  ~ called by: DB.Transaction.hydrateItem

paymentsForTx :: UUID -> Query (PaymentRow Expr)
  ~ called by: DB.Transaction.hydrateTx

hydrateTx :: DBPool -> TransactionRow Result -> IO Transaction
  ! intent: Load a Transaction by querying its lines, each line's taxes and discounts, and its payments, then assembling via txRowToDomain
  ! effects: DBPool, IO
  ! N+1: one lines query, then per-line tax and discount queries
  ! each query is a separate runSession; the result is not a snapshot
  > consumed by: DB.Transaction.getTransactionById
  > consumed by: DB.Transaction.getAllTransactions (mapM hydrateTx over rows)
  > consumed by: Service.Transaction.loadSale (transitively, via DB.Transaction.Typed)
  ~ called by: DB.Transaction.Typed.hydrateTxTyped, DB.Transaction.getAllTransactions, DB.Transaction.getTransactionById

hydrateItem :: DBPool -> TransactionItemRow Result -> IO TransactionItem
  ~ called by: DB.Transaction.hydrateTx

getAllTransactions :: DBPool -> IO [Transaction]
  ~ called by: DB.Transaction.Typed.getAllTransactionsTyped, DB.Transaction.Typed.getTransactionsByLocationTyped, Server.Admin.snapshotHandler, Server.Manager.activityHandler, Server.Manager.alertsHandler, Server.Manager.dailyReportHandler, Server.Admin.transactionsHandler

getTransactionById :: DBPool -> UUID -> IO (Maybe Transaction)
  ~ called by: DB.Transaction.Typed.getTransactionByIdTyped, Server.Admin.transactionDetailHandler, DB.Transaction.voidTransaction, DB.Transaction.finalizeTransaction

lockTransactionRow :: Statement.Statement UUID (Maybe UUID)
  ~ no callers in scanned roots

lockTransactionStatus :: Statement.Statement UUID (Maybe Text)
  ! SELECT status FROM transaction WHERE id = $1 FOR UPDATE; Nothing when the sale does not exist
  ! the status text it returns is compared with literals such as "IN_PROGRESS"; callers do not parse it
  ~ called by: DB.Transaction.voidTransaction, DB.Transaction.clearTransaction, DB.Transaction.finalizeTransaction, DB.Transaction.addTransactionItem, DB.Transaction.deleteTransactionItem, DB.Transaction.addPaymentTransaction, DB.Transaction.deletePaymentTransaction

lockMenuItemQuantity :: Statement.Statement UUID (Maybe Int32)
  ~ called by: DB.Transaction.addTransactionItem

reservedQuantityS :: UUID -> Session.Session Int
  ~ literals: "Reserved"
  ~ called by: DB.Transaction.addTransactionItem

insertItemS :: TransactionItem -> Session.Session ()
  ~ called by: DB.Transaction.createTransaction, DB.Transaction.insertTransactionItem, DB.Transaction.addTransactionItem

insertPaymentS :: PaymentTransaction -> Session.Session ()
  ~ called by: DB.Transaction.createTransaction, DB.Transaction.insertPaymentTransaction, DB.Transaction.addPaymentTransaction

releaseReservedForTxS :: UUID -> Session.Session ()
  ~ literals: "Released", "Reserved"
  ~ called by: DB.Transaction.voidTransaction, DB.Transaction.clearTransaction

restockSaleS :: UUID -> Session.Session ()
  ! intent: Add the quantity of every line of a sale back to menu_items.quantity
  ! a Session building block; the caller holds the sale row lock and has established that the sale was COMPLETED, the only status in which its quantities have left stock
  ! updates item rows in ascending sku order
  ! a line whose menu item no longer exists updates nothing
  ! leaves the sale's reservations as Completed; nothing records that a restock happened except the changed quantity
  > consumed by: DB.Transaction.voidTransaction when the policy is ReturnToStock and the sale was COMPLETED
  > consumed by: DB.Transaction.Refund.writeTypedRefund when the policy is ReturnToStock
  ~ called by: DB.Transaction.Refund.writeTypedRefund, DB.Transaction.voidTransaction

updateTotalsS :: UUID -> Session.Session ()
  ~ called by: DB.Transaction.addTransactionItem, DB.Transaction.deleteTransactionItem, DB.Transaction.updateTransactionTotals

createTransaction :: DBPool -> Transaction -> IO Transaction
  ! one SQL transaction (runTransaction_): inserts the transaction row, then its items and payments
  ! totals on the row are taken AS GIVEN by the caller. The only production caller is Service.Sale.startSale via createSaleSvc, which always passes an empty sale with zero totals.
  ~ called by: Effect.TransactionDb.runTransactionDbIO

insertTransactionItem :: DBPool -> TransactionItem -> IO TransactionItem
  ~ no callers in scanned roots

insertPaymentTransaction :: DBPool -> PaymentTransaction -> IO PaymentTransaction
  ! inserts a payment row with NO check on the sale; sale code must use addPaymentTransaction
  ~ no callers in scanned roots

voidTransaction :: DBPool -> RestockPolicy -> UUID -> Text -> IO Transaction
  ! takes a RestockPolicy argument, which comes from configuration via Effect.TransactionDb.runTransactionDbIO
  ! under the sale row lock: proceeds only for CREATED, IN_PROGRESS or COMPLETED; any other status or a missing sale is SaleNotOpen and nothing changes
  ! releases every reservation the sale still holds, then sets status='VOIDED', is_voided=true, void_reason
  ! when the sale was COMPLETED and the policy is ReturnToStock, calls restockSaleS in the same transaction; an open sale never restocks because it never left stock
  ! a REFUNDED sale cannot be voided, so stock goes back at most once
  > consumed by: Service.Transaction.voidTx via Effect.TransactionDb.voidSale; reached from POST /sale/void/:id and from Server.Manager.overrideVoidHandler
  ~ fails: SaleNotOpen
  ~ literals: "CREATED", "IN_PROGRESS", "COMPLETED", "VOIDED"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

updateTransactionStatus :: DBPool -> UUID -> TransactionStatus -> IO ()
  ~ called by: Effect.TransactionDb.runTransactionDbIO

clearTransaction :: DBPool -> UUID -> IO ()
  ! under the sale row lock: proceeds only for CREATED or IN_PROGRESS; otherwise SaleNotOpen
  ! ORDER: release reservations, delete payments, delete items, zero totals, status='CREATED'
  ! preserves the transaction row (id, employee, register) so the cashier resumes on the same sale
  ! does not cancel stock pull requests
  > consumed by: Service.Sale.clear via Effect.TransactionDb.clearSale
  ~ fails: SaleNotOpen
  ~ literals: "CREATED", "IN_PROGRESS"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

finalizeTransaction :: DBPool -> UUID -> IO Transaction
  ! intent: Decide whether a sale may be completed and complete it, in one SQL transaction
  ! effects: DBPool, IO
  ! under the sale row lock: status must be IN_PROGRESS or the result is SaleNotOpen
  ! then reads the line count, the stored total and the sum of payments under the same lock and passes them to Domain.SaleRules.finalizeProblems; a non-empty answer is FinalizeRefused
  ! this is the ONLY place the paid-in-full rule is applied in production; Service.Sale.finalize no longer pre-checks
  ! when allowed: for each Reserved reservation in ascending sku order, decrement menu_items.quantity and mark the reservation Completed; then status='COMPLETED', completed=now
  ! a second finalize waits at the lock and is refused, so stock is reduced once
  ! payments can exceed the total; the excess is recorded nowhere
  > consumed by: Service.Transaction.finalizeTx via Effect.TransactionDb.finalizeSale
  ~ fails: SaleNotOpen, FinalizeRefused
  ~ literals: "IN_PROGRESS", "Reserved", "Completed", "COMPLETED"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

addTransactionItem ::
  DBPool ->
  UUID ->
  UUID ->
  Int ->
  UUID ->
  (UUID -> Int -> Either Text TransactionItem) ->
  IO AddedLine
  ! intent: Add a quantity of one sku to a sale: lock, reprice the whole line, reserve, store, update totals, in one SQL transaction
  ! effects: DBPool, IO
  ! the caller passes the quantity TO ADD and a pricing function, never the line's whole quantity
  ! under the sale row lock: status must be CREATED or IN_PROGRESS, else SaleNotOpen; a CREATED sale moves to IN_PROGRESS in this same transaction, so a refused add leaves the status untouched
  ! locks the menu_items row before the stock check; ItemNotFound if the sku does not exist
  ! a sale holds one line per sku: an existing line is deleted and its reservation released, then one line and one reservation for the whole quantity are inserted; the line keeps its id
  ! the pricing function is called with the line id and the whole quantity; Left becomes LineRejected
  ! available = stock - (all live reservations - this sale's own for the sku); InsufficientInventory carries (sku, wanted, available)
  ! returns AddedLine: the stored line and the id and quantity of each line it replaced
  > consumed by: Service.Transaction.addItem via Effect.TransactionDb.addSaleItem
  ~ fails: SaleNotOpen, ItemNotFound, LineRejected, InsufficientInventory
  ~ literals: "CREATED", "IN_PROGRESS", "Reserved", "Released"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

deleteTransactionItem :: DBPool -> UUID -> IO ()
  ! intent: Remove one line from a sale: release its reservation, delete it, update totals, in one SQL transaction
  ! finds the line's sale without a lock, locks that sale row, reads the status under the lock, then reads the line AGAIN
  ! refused with SaleNotOpen unless the sale is IN_PROGRESS. Before 2026-10-09 it locked the row but never read the status, so a remove racing a finalize could delete a line from a completed sale.
  ! an unknown line id, or a line removed while this call waited, is not an error
  ! releases the one reservation matching sale, sku, Reserved and quantity
  ! removing the last line leaves the sale IN_PROGRESS; clearTransaction sets CREATED. Which is right is undecided.
  > consumed by: Service.Transaction.removeItem via Effect.TransactionDb.deleteSaleItem
  ~ fails: SaleNotOpen
  ~ literals: "IN_PROGRESS", "Reserved", "Released"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

addPaymentTransaction :: DBPool -> PaymentTransaction -> IO PaymentTransaction
  ! one SQL transaction: locks the sale row and inserts the payment only when the status is IN_PROGRESS; otherwise SaleNotOpen
  ! does not touch the sale status and does not compare the amount with what is owed
  ! Before 2026-10-04 it also set status COMPLETED once payments reached the total, which made finalize unreachable for a fully paid sale. Completion happens only in finalizeTransaction.
  ~ fails: SaleNotOpen
  ~ literals: "IN_PROGRESS"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

deletePaymentTransaction :: DBPool -> UUID -> IO ()
  ! one SQL transaction: finds the payment's sale, locks that sale row, deletes the payment only when the status is IN_PROGRESS; otherwise SaleNotOpen
  ! an unknown payment id deletes nothing and is not an error
  ! because finalizeTransaction sums payments under the same lock, a payment cannot be removed between finalize's decision and its write
  ~ fails: SaleNotOpen
  ~ literals: "IN_PROGRESS"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

updateTransactionTotals :: DBPool -> UUID -> IO ()
  ~ no callers in scanned roots

getTransactionIdByItemId :: DBPool -> UUID -> IO (Maybe UUID)
  ~ called by: Effect.TransactionDb.runTransactionDbIO

getTransactionIdByPaymentId :: DBPool -> UUID -> IO (Maybe UUID)
  ~ called by: Effect.TransactionDb.runTransactionDbIO

getInventoryAvailability :: DBPool -> UUID -> IO (Maybe (Int, Int))
  ~ literals: "Reserved"
  ~ called by: Effect.TransactionDb.runTransactionDbIO

%decision EverySaleWriteDecidesUnderTheSaleRowLock
  what:    Each function here that writes to a sale runs in one SQL transaction, takes SELECT ... FOR UPDATE on the sale row first, reads the status under that lock, and decides from what it read
  why:     Before 2026-10-06 the service read the sale, asked the state machine, and wrote in a later statement. A second request could change the sale in between. That one mistake produced lost adds, underpaid completed sales, cleared completed sales and unlimited refunds. Covers addTransactionItem, deleteTransactionItem, addPaymentTransaction, deletePaymentTransaction, finalizeTransaction, clearTransaction, voidTransaction, and DB.Transaction.Refund.writeTypedRefund. Rel8 has no locking clause, so the lock statements are plain Hasql. LOCK ORDER: the sale row first, then menu_items rows in ascending sku order. Every stock write uses that order so two registers cannot deadlock. Verified against Postgres by the dev shell command test-sale. nix/sale-checks/lock-wait.sh holds the row lock from a second connection, changes the status and commits while each write waits; each write must wait and then answer 409. The other check files race two requests for eight rounds.
  affects: lockTransactionStatus, lockTransactionRow, lockMenuItemQuantity, addTransactionItem, deleteTransactionItem, addPaymentTransaction, deletePaymentTransaction, finalizeTransaction, clearTransaction, voidTransaction

%decision RefusalsAreInventoryException
  what:    A refused write is reported by throwing InventoryException after the SQL transaction has rolled back: ItemNotFound, InsufficientInventory, SaleNotOpen, LineRejected, FinalizeRefused
  why:     The decision is made inside runTransaction as an Either, so the transaction ends cleanly before anything is thrown. Effect.TransactionDb.runTransactionDbIO catches the exception with try and returns it as a value. Service.Transaction.refuseWrite is the only place that maps a case to an HTTP status. SaleNotOpen means the sale is missing or its status does not allow this write. FinalizeRefused carries every reason, worded by Domain.SaleRules.finalizeProblems.
  affects: addTransactionItem, deleteTransactionItem, addPaymentTransaction, deletePaymentTransaction, finalizeTransaction, clearTransaction, voidTransaction

%open_issue ReservationMatchedToLineByValues
  what:     deleteTransactionItem finds the reservation to release by sale, sku, Reserved status and quantity; the reservation row has no column naming its line
  why:      One line per sku and one live reservation per sku are both enforced by unique indexes, so the match is unique. A line id column on inventory_reservation, filled on insert, would say it directly. It needs a migration for existing rows.
  blocking: nothing today
  affects:  deleteTransactionItem, addTransactionItem

%open_issue SaleReadIsManyQueriesAndNotASnapshot
  what:     hydrateTx runs one query for lines, two per line for taxes and discounts, and one for payments, each on its own pool connection
  why:      getAllTransactions does that for every row. Server.Manager calls getAllTransactions on every activity, alerts and daily report request. The queries are not in one transaction, so a sale read during a write can mix states.
  blocking: manager screen at real data volume, a consistent read of a sale
  affects:  hydrateTx, hydrateItem, getAllTransactions, getTransactionById


=== BEGIN Domain/Pricing.hs ===

%file /home/bismuth/git/cheeblr/backend/src/Domain/Pricing.hs
%mod Domain.Pricing

%ext DerivingStrategies, OverloadedStrings

%uses Data.Text
%uses Types.Inventory
%uses Types.Transaction

%const_candidate ratePerMillion = 1000000

%abstract TaxRate  hidden: TaxRate  made by: mkTaxRate

newtype TaxRate = TaxRate Int
  deriving stock (Eq, Ord, Show)

data RoundingMode
  = RoundHalfUp
  | RoundHalfEven
  | RoundDown
  deriving stock (Eq, Ord, Show, Read)

data TaxRule = TaxRule
  { ruleItemCategory :: Maybe ItemCategory
  , ruleTaxCategory  :: TaxCategory
  , ruleRate         :: TaxRate
  , ruleRounding     :: RoundingMode
  , ruleDescription  :: Text
  }
  deriving stock (Eq, Show)

data LineTax = LineTax
  { lineTaxCategory    :: TaxCategory
  , lineTaxRate        :: TaxRate
  , lineTaxAmount      :: Int
  , lineTaxDescription :: Text
  }
  deriving stock (Eq, Show)

data LinePricing = LinePricing
  { lineUnitPrice :: Int
  , lineQuantity  :: Int
  , lineSubtotal  :: Int
  , lineTaxes     :: [LineTax]
  , lineTaxTotal  :: Int
  , lineTotal     :: Int
  }
  deriving stock (Eq, Show)

data PricingError
  = NonPositiveQuantity Int
  | NegativeUnitPrice Int
  deriving stock (Eq, Show)

mkTaxRate :: Int -> Maybe TaxRate
  ! Nothing for a negative rate; there is no upper bound
  ~ clause: ppm | ppm >= 0
  ~ called by: DB.TaxRule.decodeTaxRuleRow
  ? tested by: Test.Domain.PricingSpec.rate, Test.Domain.TaxRuleSpec.pricingRule, Test.Domain.PricingSpec.spec, Test.Service.SaleSpec.testRules

taxRatePpm :: TaxRate -> Int
  ~ clause: (TaxRate ppm)
  ~ called by: Service.Sale.toSaleItem
  ? tested by: Test.Domain.PricingSpec.spec

ratePerMillion :: Integer
  ~ literals: 1000000
  ~ called by: Domain.Pricing.taxOn
  ? tested by: Test.Domain.PricingSpec.spec

roundDiv :: RoundingMode -> Integer -> Integer -> Integer
  ! uses quotRem, then compares 2 * remainder with the denominator: RoundHalfUp goes up at >=, RoundHalfEven goes up at > or at == when the quotient is odd, RoundDown keeps the quotient
  ! a negative numerator or a zero denominator is outside its contract; taxOn always passes ratePerMillion as the denominator
  ~ literals: 2
  ~ called by: Domain.Pricing.taxOn
  ? tested by: Test.Domain.PricingSpec.spec

taxOn :: RoundingMode -> TaxRate -> Int -> Int
  ~ clause: mode (TaxRate ppm) baseCents
  ~ called by: Domain.Pricing.priceLine
  ? tested by: Test.Domain.PricingSpec.spec

rulesFor :: ItemCategory -> [TaxRule] -> [TaxRule]
  ! a rule with ruleItemCategory = Nothing applies to every category; order of the input list is preserved
  ~ called by: Domain.Pricing.priceLine
  ? tested by: Test.Domain.PricingSpec.spec

priceLine
  :: [TaxRule]
  -> ItemCategory
  -> Int
  -- ^ unit price in cents
  -> Int
  -- ^ quantity
  -> Either PricingError LinePricing
  ! intent: Turn a unit price, quantity, item category and the active tax rules into the stored amounts for one sale line
  ! pure; Left NonPositiveQuantity for quantity <= 0, Left NegativeUnitPrice for price < 0
  ! one LineTax per applicable rule, in rule order
  ! lineTotal = lineSubtotal + sum of the rounded tax amounts
  ! spec: priceLine [6.25% all, 10.75% Flower] Flower 1999 2 => subtotal 3998, taxes [250, 430], total 4678
  > consumed by: Service.Sale.addItem
  ~ clause: rules category unitPrice quantity | quantity <= 0
  ~ clause: rules category unitPrice quantity | unitPrice < 0
  ~ fails: NonPositiveQuantity, NegativeUnitPrice
  ~ called by: Service.Sale.addItem
  ? tested by: Test.Domain.PricingSpec.spec

%decision IntegerMoneyAndPartsPerMillionRates
  what:    All money is integer cents; tax rates are integer parts per million (6.25% = 62500); no floating point anywhere in pricing
  why:     The browser used to compute tax as floor(subtotal * 0.08) in floating point. Basis points cannot express rates such as 8.875%, so the unit is ppm. Each tax is rounded once to the cent and the rounded amount is stored; totals are sums of stored amounts and are never recomputed from a rate.
  affects: mkTaxRate, taxOn, roundDiv, priceLine

%decision RoundingModeIsPartOfTheRule
  what:    Every TaxRule names its own RoundingMode (RoundHalfUp, RoundHalfEven, RoundDown); RoundHalfUp is what the seed and tests use
  why:     Jurisdictions differ on rounding, so the mode is data and not a constant. The owner has not yet supplied real tax rules; nothing here asserts legal compliance.
  affects: taxOn, roundDiv

%open_issue NoTaxOnTaxAndNoDiscountBase
  what:     priceLine charges every applicable rule on the line subtotal: a tax is never charged on another tax, and discounts do not reduce the taxable base
  why:      Sale.Item carries discounts but nothing in the sale flow creates one yet. If a real rule puts one tax inside another's base, TaxRule needs a field for that.
  blocking: compound taxes, discounts
  affects:  priceLine



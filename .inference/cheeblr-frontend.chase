%file /home/bismuth/git/cheeblr/frontend/src/Types/Register.purs
%mod Types.Register

%uses Data.DateTime
%uses Data.Maybe
%uses Types.UUID
%uses Data.Finance.Currency
%uses Data.Finance.Money

type EntityId = UUID

type CartTotals =
  { subtotal :: Discrete USD
  , taxTotal :: Discrete USD
  , total :: Discrete USD
  , discountTotal :: Discrete USD
  }

type Register =
  { registerId :: UUID
  , registerName :: String
  , registerLocationId :: UUID
  , registerIsOpen :: Boolean
  , registerCurrentDrawerAmount :: Int
  , registerExpectedDrawerAmount :: Int
  , registerOpenedAt :: Maybe DateTime
  , registerOpenedBy :: Maybe UUID
  , registerLastTransactionTime :: Maybe DateTime
  }

-- The employee who opens or closes a register is the session user. Neither
-- request names one. Amounts are cents.

type OpenRegisterRequest =
  { openRegisterStartingCash :: Int
  }

type CloseRegisterRequest =
  { closeRegisterCountedCash :: Int
  }

type CloseRegisterResult =
  { closeRegisterResultRegister :: Register
  , closeRegisterResultVariance :: Int
  }

%decision RegisterWireShapeMirrorsHaskellRecord
  what:    Register is a plain record matching the Haskell backend's Register record field-for-field
  why:     registerIsOpen decides which controls Pages.Registers shows; the backend refuses to open an open register or close a closed one (409). The Maybe fields are Nothing for a register that was never opened. Yoga.JSON leaves a Nothing field out when writing, and the backend accepts that. The variance at close is expected minus counted and is computed by the backend.
  affects: 

%decision RegisterRequestsNameNoEmployee
  what:    OpenRegisterRequest holds only the starting cash and CloseRegisterRequest only the counted cash, both in cents
  why:     The backend takes the acting user from the session. The employee id fields left the wire format on both sides on 2026-10-10.
  affects: 

%open_issue CartTotalsHasNoUser
  what:     CartTotals and EntityId are no longer used by the app
  why:      Their users, Services.TransactionService and Services.Cart, were deleted. Safe to delete after a search of the tests.



  ~ called by: Pages.TransactionHistory.page

reasonForm :: Form String
  ~ called by: Pages.TransactionHistory.page

page :: SessionResponse -> Nut
  ! Lists every sale from API.Sale.getAllSales, newest first, with time (UTC), status, line count, total and id.
  ! One request runs at a time; buttons are disabled while busy and until a reason is typed.
  ! Uses formatStatus and statusClass from UI.Transaction.CreateTransaction.
  ~ called by: Main.main

%decision VoidAndRefundFollowTheBackendRules
  what:    Void is offered with capCanVoidTransaction on a sale UI.Transaction.Model.voidable accepts; refund with capCanRefundTransaction on a sale refundable accepts
  why:     A refunded sale shows as Refunded and offers neither. A cashier sees no action at all. Both need a reason, which is posted as a JSON string. The backend decides. A refusal shows the backend's text, and the list is read again after every attempt, so a sale changed on another screen shows its real status. Whether a void or a refund puts stock back is backend configuration. The page does not say either way.
  affects: page

%open_issue HistoryShowsNoLinesOrRefundRows
  what:     A row shows a line count and a total only; the lines, the payments and the refund row of a refunded sale are not shown
  why:      API.Refund.getAllRefunds and getRefund have no caller. The new CSS classes sale-row, sale-created, sale-lines, sale-total, sale-id, sale-actions, sale-list and sale-history have no rules yet.
  affects:  page


=== BEGIN Route.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Route.purs
%mod Route

%uses Prelude
%uses Data.Array
%uses Data.Generic.Rep
%uses Data.Show.Generic
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Listeners as DL
%uses Deku.Hooks
%uses Effect
%uses FRP.Poll
%uses Routing.Duplex
%uses Routing.Duplex.Generic as G
%uses Routing.Duplex.Generic.Syntax
%uses Services.AuthService
%uses Types.Auth

%untested route, navLinks, nav, navItem

data Route
  = Login
  | LiveView
  | Create
  | Delete String
  | CreateTransaction
  | TransactionHistory
  | Registers
  | Edit String
  | Admin
  | Manager
  | Stock
  | Feed

derive instance Eq Route

derive instance Ord Route

derive instance genericRoute :: Generic Route _

instance Show Route where

type NavLink =
  { route :: Route
  , href :: String
  , label :: String
  , allowed :: UserCapabilities -> Boolean
  }

-- Each link is shown only to a user whose capabilities, as the backend sent
-- them, pass the same check the backend applies to that area. This decides
-- what is shown. The backend decides every request.

route :: RouteDuplex' Route
  ! RouteDuplex' definition: bidirectional parser/printer between Route and URL hash strings.
  ! Registers is /#/register. Edit and Delete take a (string segment) parameter; Pages.EditItem.resolveSku special-cases the slug 'test'.
  ~ called by: Main.main

navLinks :: Array NavLink
  ~ called by: Route.visibleLinks

visibleLinks :: UserCapabilities -> Array NavLink
  ! Pure, and covered by test/Auth.purs for each role.
  ~ called by: Route.nav
  ? tested by: Test.Auth.linksFor

nav :: Poll Route -> Poll AuthState -> Effect Unit -> Nut
  ! Rebuilds on every auth change. Logout calls the signOut action Main passes in.
  ~ called by: Main.main

navItem :: Route -> String -> String -> Poll Route -> Nut
  ~ called by: Route.nav

%decision NavLinksAreShownByCapability
  what:    navLinks pairs each link with the capability check the backend applies to that area; visibleLinks filters by the session's capabilities
  why:     A signed-out browser sees only Login. A signed-in one sees its links, its user name and Logout. The checks: inventory view, create item, process transaction (New Transaction and Sales), open or manage registers, admin dashboard, view reports (Manager), fulfill orders (Stock Room). Feed is shown to everyone signed in. This decides what is shown. The backend decides every request.
  affects: navLinks, visibleLinks, nav


=== BEGIN Services/AuthService.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Services/AuthService.purs
%mod Services.AuthService

%uses Prelude
%uses Data.Maybe
%uses Types.Auth
%uses Types.Session

data AuthState
  = SignedIn SessionResponse
  | SignedOut

instance showAuthState :: Show AuthState where

isSignedIn :: AuthState -> Boolean
  ! True for SignedIn, false for SignedOut.
  ~ no callers in scanned roots
  ? tested by: Test.Auth.spec

session :: AuthState -> Maybe SessionResponse
  ! Just the session when signed in.
  ~ no callers in scanned roots
  ? tested by: Test.Auth.spec

capabilities :: AuthState -> UserCapabilities
  ! The session's own capabilities when signed in, Types.Auth.emptyCapabilities when signed out.
  ~ called by: Services.AuthService.can
  ? tested by: Test.Auth.spec

can :: (UserCapabilities -> Boolean) -> AuthState -> Boolean
  ! Reads one capability; false for every capability when signed out.
  ~ no callers in scanned roots
  ? tested by: Test.Auth.spec

%decision AuthStateHoldsTheBackendSession
  what:    AuthState is SignedIn SessionResponse or SignedOut; the user id, role and capabilities are the ones the backend sent
  why:     It used to hold a dev user chosen by role, with capabilities derived from the role on the client. An unknown role became the admin dev user. The session itself is an HttpOnly cookie. This value decides only what the screens show.
  affects: isSignedIn, session, capabilities, can


=== BEGIN Services/CurrentSale.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Services/CurrentSale.purs
%mod Services.CurrentSale

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses API.Sale as SaleApi
%uses API.SaleCommand as Command
%uses Data.Either
%uses Data.Maybe
%uses Effect
%uses Effect.Aff
%uses Effect.Class
%uses Types.Register
%uses Types.Session
%uses Types.Transaction.Sale as Sale
%uses Types.UUID
%uses UI.Transaction.Model
%uses Web.HTML
%uses Web.HTML.Window
%uses Web.Storage.Storage

%untested saleKey, remembered, remember, forget, start, resume, startOn, startNext

saleKey :: UUID -> String
  ~ called by: Services.CurrentSale.remembered, Services.CurrentSale.remember, Services.CurrentSale.forget

remembered :: UUID -> Effect (Maybe UUID)
  ~ called by: Services.CurrentSale.resume

remember :: UUID -> UUID -> Effect Unit
  ~ called by: Services.CurrentSale.start

forget :: UUID -> Effect Unit
  ~ called by: Services.CurrentSale.resume

start
  :: { registerId :: UUID, locationId :: UUID }
  -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.CurrentSale.startOn, Services.CurrentSale.startNext

resume
  :: SessionResponse
  -> Register
  -> Aff (Either ApiError (Maybe Sale.SaleTransaction))
  ! Sends no write. With nothing remembered for this user it returns Right Nothing without any request.
  ! Right (Just sale) only when UI.Transaction.Model.canResume allows: still open, opened by this user, on this register.
  ! A remembered sale that is gone (404) or can no longer be resumed gives Right Nothing and the remembered id is removed.
  ! Any other failure to read the remembered sale gives Left and keeps the remembered id, because the sale may still be open.
  ! Another user on the same browser has a different key and never reads the first user's sale.
  ~ called by: Pages.CreateTransaction.load

startOn :: Register -> Aff (Either ApiError Sale.SaleTransaction)
  ! Starts a sale on the given register and its location and remembers it. The backend records the session user as the opener.
  ~ called by: Pages.CreateTransaction.begin

startNext
  :: Sale.SaleTransaction
  -> Aff (Either ApiError Sale.SaleTransaction)
  ! Starts a sale on the register and location of the given sale and remembers it. The backend records the session user as the opener.
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

%decision OpenSaleIsRememberedPerUser
  what:    The id of the sale a user is working on is kept in localStorage under 'current_sale_id:<user id>'
  why:     A reload or a later sign-in by the same user continues the same sale. The key used to be 'current_sale_id' for every user. On 2026-10-10 the backend log showed each sign-in reading the previous user's sale (GET /sale/<id>) before starting its own. start remembers each sale under sale.saleEmployeeId, the opener the backend recorded, which is the session user. The old shared key is no longer read or written. A value left under it in a browser is unused.
  affects: resume, startOn, startNext

%decision NothingHereStartsASaleOnItsOwn
  what:    A sale is started only by startOn and startNext, and the pages call both from a button
  why:     resumeOrStart used to start a sale whenever the sale page was opened without a resumable one. On 2026-10-10 that left empty open sales on the backend: one per sign-in, and one after each completed sale that was followed by a sign-out. resumeOrStart was removed. resume only reads; Pages.CreateTransaction shows a Start Sale button when resume finds nothing. Every started sale is an audited row (Transaction created) in the backend compliance log, so a sale nobody asked for is a false record.
  affects: resume, startOn, startNext

%open_issue OpenSaleFoundOnlyInTheSameBrowser
  what:     A sale opened in another browser, or before localStorage was cleared, is not found and stays open on the backend
  why:      The backend has no route that returns a user's open sale; GET /sale returns every sale. Such a sale shows as live in the manager's activity and later as a stale-transaction alert. The user is then offered Start Sale and can open a second sale while the first is still open.
  blocking: never leaving an open sale behind
  affects:  resume

%open_issue StartedSaleCanStillBeLeftEmpty
  what:     A sale started with Start Sale or New Sale and then abandoned stays open and empty until its opener resumes it or a manager voids it
  why:      It is resumed the next time the same user opens the sale page in the same browser on the same register. Wanted on both sides: create the sale with its first item, so that an empty sale cannot exist.
  affects:  startOn, startNext



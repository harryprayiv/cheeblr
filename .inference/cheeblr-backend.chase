%file /home/bismuth/git/cheeblr/backend/src/Domain/TaxRule.hs
%mod Domain.TaxRule

%ext DerivingStrategies, OverloadedStrings

%uses Data.Text
%uses qualified Data.Text as T
%uses Data.Time
%uses Data.UUID
%uses Text.Read
%uses Domain.Pricing
%uses Types.Inventory
%uses Types.Location
%uses Types.Transaction

data StoredTaxRule = StoredTaxRule
  { storedRuleId        :: UUID
  , storedLocation      :: Maybe LocationId
  , storedEffectiveFrom :: UTCTime
  , storedEffectiveTo   :: Maybe UTCTime
  , storedRule          :: TaxRule
  }
  deriving stock (Eq, Show)

inForce :: LocationId -> UTCTime -> StoredTaxRule -> Bool
  ! effective_from is inclusive and effective_to is exclusive; a rule with no location applies at every location
  ? tested by: Test.Domain.TaxRuleSpec.spec

activeRules :: LocationId -> UTCTime -> [StoredTaxRule] -> [TaxRule]
  ! map storedRule . filter (inForce location now); keeps stored order, which becomes the order of Sale.Tax lines on an item
  ! an empty result is valid: Domain.Pricing.priceLine then prices the line with zero tax
  > consumed by: Effect.TaxRules (both interpreters)
  ? tested by: Test.Domain.TaxRuleSpec.spec

roundingCode :: RoundingMode -> Text
  ? tested by: Test.Domain.TaxRuleSpec.spec

parseRoundingCode :: Text -> Either Text RoundingMode
  ? tested by: Test.Domain.TaxRuleSpec.spec

taxCategoryCode :: TaxCategory -> Text
  ? tested by: Test.Domain.TaxRuleSpec.spec

parseTaxCategoryCode :: Text -> Either Text TaxCategory
  ? tested by: Test.Domain.TaxRuleSpec.spec

itemCategoryCode :: ItemCategory -> Text
  ! the constructor name via show, the same text menu_items.category uses
  ? tested by: Test.Domain.TaxRuleSpec.spec

parseItemCategoryCode :: Text -> Either Text ItemCategory
  ? tested by: Test.Domain.TaxRuleSpec.spec

%decision StrictRuleDecoding
  what:    Text codes for rounding mode, tax category and item category decode with Either; an unknown code is an error, never a default
  why:     Skipping or defaulting an unreadable rule would silently charge less tax. DB.Transaction.Rows.parseTaxCategory is lenient (unknown -> NoTax) and is deliberately not reused here.
  affects: parseRoundingCode, parseTaxCategoryCode, parseItemCategoryCode



%file /home/bismuth/git/cheeblr/backend/src/Server/Auth.hs
%mod Server.Auth

%ext OverloadedStrings, ScopedTypeVariables, DataKinds

%uses Control.Monad
%uses Control.Monad.IO.Class
%uses qualified Data.ByteString.Lazy.Char8 as LBS8
%uses Data.Maybe
%uses Data.Text
%uses qualified Data.Text as T
%uses Katip
%uses Servant
%uses API.Auth
%uses Auth.Session
%uses DB.Auth
%uses DB.Database
%uses DB.Schema
%uses Data.Time
%uses Logging
%uses Rel8
%uses Server.Cookie
%uses Types.Auth

perCredentialLimit :: Int
  ! 5 failures per (username, ip) within rateLimitWindow
  ! HARDCODED; AppConfig.cfgRateLimitMax is loaded but not consulted here
  ? no test references

perIpLimit :: Int
  ! 20 failures per ip within rateLimitWindow (any usernames)
  ! HARDCODED; not driven by config
  ? no test references

rateLimitWindow :: NominalDiffTime
  ! 10 minutes; HARDCODED
  ! AppConfig.cfgRateLimitWindow is loaded but ignored here
  ? no test references

checkLoginRateLimit :: DBPool -> Text -> Text -> Handler ()
  ! intent: Pre-flight rate limit before a login attempt; throws err429 with Retry-After: 600
  ! effects: DBPool, Error ServerError
  ! checks per-credential FIRST, then per-ip; first to trip wins
  ! does NOT consume budget; recordLoginAttempt is the only writer
  ! spec: after 5 failures for (alice, 1.2.3.4) => err429 Too many failed login attempts
  ! spec: after 4 failures => ()
  > consumed by: Server.Auth.loginHandler (only caller; runs BEFORE password verification)
  ? no test references

userRowToSummary :: UserRow Result -> UserSummary
  ? no test references

parseRoleText :: Text -> UserRole
  ! case-sensitive; defaults UNKNOWN strings silently to Cashier
  ! 'admin' lowercase becomes Cashier with no error
  ? no test references

loginHandler ::
  DBPool ->
  LogEnv ->
  Maybe Text ->
  Maybe Text ->
  LoginRequest ->
  Handler (Headers '[Header "Set-Cookie" Text] LoginResponse)
  ! intent: Validate credentials, mint a session, set the cheeblr_session cookie, record the attempt
  ! effects: DBPool, Katip.LogEnv, Error ServerError, IO
  ! rate-limit check runs BEFORE password verification (avoids Argon2 timing oracle)
  ! missing-user case still records a failed attempt (closes one enumeration channel)
  ! always recordLoginAttempt regardless of outcome; success rows exist for audit
  ! User-Agent and X-Real-IP default to 'unknown' if absent
  ! 401 body is GENERIC for both bad-username and bad-password (no enumeration leak)
  ! spec: valid credentials => Headers (Set-Cookie cheeblr_session=...) LoginResponse
  ! spec: wrong password => err401 Invalid username or password
  ! spec: unknown username => err401 Invalid username or password
  ! spec: after 5 (username, ip) failures => err429 with Retry-After: 600
  > consumed by: Servant route /auth/login (POST)
  ? no test references

logoutHandler ::
  DBPool ->
  LogEnv ->
  Maybe Text ->
  Handler (Headers '[Header "Set-Cookie" Text] NoContent)
  ! revokes session by id (not by token); idempotent on repeat
  ! always sets clearSessionCookie even if revoke fails
  > consumed by: Servant route /auth/logout (POST)
  ? no test references

meHandler ::
  DBPool ->
  Maybe Text ->
  Handler SessionResponse
  ! returns capabilities derived from role; no per-user override path exists
  ! side effect: lookupSession bumps last_seen_at
  > consumed by: Servant route /auth/me (GET) — used by frontend for session validation and capability checks
  ? no test references

listUsersHandler ::
  DBPool ->
  LogEnv ->
  Maybe Text ->
  Handler [UserSummary]
  ! STUB: returns [] regardless of state, even when caller is authorized
  ! the authorization check is real; only the result list is fake
  ? no test references

createUserHandler ::
  DBPool ->
  LogEnv ->
  Maybe Text ->
  NewUserRequest ->
  Handler UserSummary
  ! calls hashPassword synchronously (~100ms+ via Argon2)
  ! no transactional guarantee: createUser commits, then a SECOND DB read fetches the row
  ! if the second read fails the user EXISTS in DB but the handler returns 500
  ! no email format validation; accepts any string or Nothing
  ? no test references

authServerImpl :: DBPool -> LogEnv -> Server AuthAPI
  ? no test references

%decision TwoTierLoginRateLimit
  what:    Per-(username, ip) AND per-ip windowed counters in PostgreSQL
  why:     Per-credential limit (5/10min) blocks credential-stuffing on a single account. Per-IP limit (20/10min) blocks credential-stuffing across many accounts from one source. Windows are HARDCODED in this module, NOT taken from cfgRateLimitWindow / cfgRateLimitMax. Config values are dead code; either wire them up or delete them. Cheap at POS scale; would need Redis-backed counters at internet scale.
  affects: perCredentialLimit, perIpLimit, rateLimitWindow, checkLoginRateLimit

%decision FailFirstFastReturn
  what:    Rate limit BEFORE password check, password check BEFORE session creation, recordLoginAttempt on every outcome
  why:     Rate-limit-first prevents using password-verify timing (Argon2 is slow) as a username-enumeration oracle. recordLoginAttempt always means even successful logins show in the audit table. Missing-user case still records a failed attempt (closes one enumeration channel).
  affects: loginHandler, checkLoginRateLimit



%file /home/bismuth/git/cheeblr/frontend/src/UI/Transaction/CreateTransaction.purs
%mod UI.Transaction.CreateTransaction

%uses Prelude
%uses API.Inventory
%uses API.Request
%uses API.Request as Request
%uses API.Sale as SaleApi
%uses Config.LiveView
%uses Data.Array
%uses Data.Either
%uses Data.Tuple.Nested
%uses Data.Validation.Semigroup
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect
%uses Effect.Aff
%uses Effect.Class
%uses Services.CurrentSale as CurrentSale
%uses Services.SaleActions as SaleActions
%uses Types.Inventory
%uses Types.Register
%uses Types.RemoteData
%uses Types.Transaction
%uses Types.Transaction.Sale as Sale
%uses Types.UUID
%uses UI.Form
%uses UI.Remote
%uses UI.Transaction.ActionBar
%uses UI.Transaction.CartView
%uses UI.Transaction.InventoryPicker
%uses UI.Transaction.Model
%uses UI.Transaction.PaymentPanel

%untested formatStatus, statusClass, saleIsStale, createTransaction, saleScreen

formatStatus :: TransactionStatus -> String
  ~ called by: Pages.TransactionHistory.page, UI.Transaction.CreateTransaction.saleScreen

statusClass :: TransactionStatus -> String
  ~ called by: Pages.TransactionHistory.page, UI.Transaction.CreateTransaction.saleScreen

saleIsStale :: ApiError -> Boolean
  ! True for Refused 409 and Refused 404. A 400 and a 403 leave the sale on screen as it is.
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

createTransaction
  :: RemoteData Inventory
  -> Sale.SaleTransaction
  -> Register
  -> Nut
  ~ called by: Pages.CreateTransaction.page

saleScreen
  :: RemoteData Inventory
  -> Sale.SaleTransaction
  -> Register
  -> (Sale.SaleTransaction -> Effect Unit)
  -> Nut
  ! the payment form is run here (runFormWith paymentStyle paymentForm) and passed to paymentPanel so the screen can list its errors
  ! the status panel shows two lists: payment form errors and Model.finalizeBlockers; it reuses the inventory-errors-* CSS classes
  ! A refused action shows 'Error: ' and the backend's text. After a 409 or a 404 (saleIsStale) the sale is read again with API.Sale.getSale.
  ! New Sale calls Services.CurrentSale.startNext with the finished sale
  ! inventory is refreshed on mount and after every action, accepted or refused
  ~ called by: UI.Transaction.CreateTransaction.createTransaction

%decision OneSaleScreenPerSale
  what:    createTransaction holds which sale is on screen; saleScreen is rebuilt from scratch when New Sale swaps it, so filters, the payment form and the message start clean
  why:     saleScreen owns four cells: the sale, the inventory (useRemote), the Activity, and the status message. All actions go through perform, which sets the Activity, runs the request, replaces the sale, and refreshes the inventory.
  affects: createTransaction, saleScreen

%open_issue InventoryOnlyRefreshedAfterOwnActions
  what:     saleScreen refreshes inventory on mount and after each of its own actions; it does not hear about sales, voids or refunds made on other registers
  why:      The server is the source of truth and refuses an add with 400 insufficient inventory, so the result is a refused click on a row that looked available, not a wrong sale. A void or refund may or may not put stock back depending on server configuration; the screen has no signal for that either. Whether the backend relay publishes those changes was deduced, not verified. Wanted: the sale screen subscribes to live inventory the way the live menu view does.
  affects:  saleScreen



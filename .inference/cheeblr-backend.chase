%file /home/bismuth/git/cheeblr/backend/src/Infrastructure/AvailabilityRelay.hs
%mod Infrastructure.AvailabilityRelay

%ext OverloadedStrings

%uses Control.Concurrent.STM
%uses Control.Monad
%uses qualified Data.Map.Strict as Map
%uses Data.Time
%uses qualified Data.Vector as V
%uses qualified DB.Database as DB
%uses qualified DB.Reservation as DBRes
%uses Infrastructure.AvailabilityState
%uses Infrastructure.Broadcast
%uses Server.Env
%uses Types.Events
%uses Types.Events.Availability
%uses Types.Events.Domain
%uses Types.Inventory
%uses qualified Types.Inventory as TI
%uses qualified Types.Transaction as TT

runAvailabilityRelay :: AppEnv -> IO ()
  ! intent: Long-running thread translating DomainEvents into AvailabilityUpdates
  ! effects: DBPool, STM, IO, forever
  ! ORDER on startup: populateFromDb FIRST, then subscribe, then loop
  ! events that arrive between populateFromDb and subscribe are lost (small race window)
  ! loop is forever; on STM exception or DB error the thread dies and App.hs prints to stderr
  ! no supervisor: relay death silently breaks the public feed until process restart
  ! only InventoryEvt and TransactionItemAdded/Removed produce updates; other events are ignored
  ! spec: publish (TransactionItemAdded sku 3) => AvailabilityUpdate with availableQty - 3 published
  ! spec: publish (ItemDeleted sku) => no AvailabilityUpdate published, sku removed from state
  > consumed by: App.runWithEnv (forks this thread once at startup)
  > consumed by: Server.Feed.wsHandler subscribes to the availability broadcaster this populates
  > consumed by: Server.Feed.feedSnapshotHandler reads the same TVar
  ? no test references

populateFromDb :: AppEnv -> IO ()
  ! two queries: getAllMenuItems then getAllActiveReservations
  ! reservation totals aggregated by SKU via Map.fromListWith (+)
  ! called only at relay startup; no periodic re-hydration; trusts the event stream after
  ! if a reservation is mutated by someone bypassing the event emitter, the relay drifts permanently
  ? no test references

updateAvailability ::
  TVar AvailabilityState ->
  DomainEvent ->
  UTCTime ->
  STM (Maybe AvailabilityUpdate)
  ! ItemDeleted clears both asItems AND asReserved entries for the sku; emits Nothing because the item is gone
  ! TransactionItemRemoved decrements reservation; if it drops to 0 the entry is removed (Map.update with Nothing branch)
  ! negative reservations are clamped to 0 by Map.update returning Nothing
  ! publishFor reads asItems for the sku; if missing returns Nothing (no orphan updates)
  ? tested by: Test.Infrastructure.AvailabilityRelaySpec.spec

%decision EventDrivenAvailabilityProjection
  what:    Availability is derived state, populated once from DB then maintained by streaming domain events
  why:     Avoids a second DB round-trip on every transaction-item event. Cost is a startup race window where events between populateFromDb and subscribe are missed; acceptable because the relay only runs at app startup. If the relay dies and is restarted, populateFromDb re-syncs from authoritative DB state.
  affects: runAvailabilityRelay, populateFromDb, updateAvailability

%open_issue VoidAndRestockDoNotReachTheRelay
  what:     By this module's own notes the relay updates only on InventoryEvt and TransactionItemAdded/Removed; a void and a restock change availability with neither
  why:      Service.Transaction.voidTx releases an open sale's reservations and emits only TransactionVoided. A restocking void or refund raises menu_items.quantity and emits no inventory event. Whether clear announces its released lines has not been checked. Deduced from the service code and the notes here; the relay source was not re-read. If right, the public feed under-reports availability after a void until the process restarts.
  blocking: an accurate public availability feed
  affects:  runAvailabilityRelay, updateAvailability



clear ::
  ( TransactionDb :> es
  , Error ServerError :> es
  ) =>
  UUID ->
  Eff es Sale.SaleTransaction
  ! early 409 'Only an open sale can be cleared' unless the loaded sale is Created or InProgress; then clearSale, which re-checks under the lock; a refusal goes through Service.Transaction.refuseWrite
  ! returns the emptied sale, whose status is Created
  ! emits no event and does not cancel stock pulls

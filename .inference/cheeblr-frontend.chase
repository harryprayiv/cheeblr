%file /home/bismuth/git/cheeblr/frontend/src/UI/Remote.purs
%mod UI.Remote

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Data.Either
%uses Data.Tuple.Nested
%uses Deku.Attribute
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Self as Self
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect
%uses Effect.Aff
%uses Effect.Class
%uses FRP.Poll
%uses Types.RemoteData

%untested useRemote, onMount, viewRemote, standardView, quietView

type Remote a =
  { value :: Poll (RemoteData a)
  , reload :: Effect Unit
  , refresh :: Effect Unit
  }

type RemoteView =
  { notAsked :: Nut
  , loading :: Nut
  , failure :: String -> Nut
  }

useRemote
  :: forall a
   . RemoteData a
  -> Aff (Either ApiError a)
  -> (Remote a -> Nut)
  -> Nut
  ! Takes an Aff (Either ApiError a) and holds RemoteData a in a useHot cell.
  ! reload sets Loading and then fetches; refresh fetches and keeps the current value on screen until the answer arrives.
  ! A Left becomes Failure with API.Request.describe of the error.
  ~ called by: Pages.DeleteItem.page, Pages.Manager.Dashboard.page, Pages.Admin.Dashboard.page, Pages.Manager.Panels.ReportsPanel.reportsPanel, Pages.LiveView.page, Pages.EditItem.page, Pages.TransactionHistory.page, Pages.Registers.page, +1 more

onMount :: forall r. Effect Unit -> Poll (Attribute r)
  ! uses Deku.DOM.Self.self_. DL.load_ on a div or span never fires because browsers do not raise load on those elements.
  ! The effect can run before the element's children subscribe, so state it sets must be in a useHot cell, which replays.
  ~ called by: Pages.DeleteItem.page, Pages.Manager.Dashboard.page, Pages.Admin.Dashboard.page, Pages.LiveView.page, Pages.EditItem.page, Pages.Stock.Interface.page, Pages.TransactionHistory.page, Pages.Registers.page, +2 more

viewRemote
  :: forall a
   . RemoteView
  -> (a -> Nut)
  -> Poll (RemoteData a)
  -> Nut
  ! one <#~> over the RemoteData Poll; RemoteView says how to draw NotAsked, Loading and Failure
  ~ called by: Pages.Manager.Panels.StatsPanel.statsPanel, Pages.Manager.Panels.ActivityFeed.activityFeed, Pages.Manager.Panels.AlertsPanel.alertsPanel, Pages.DeleteItem.page, Pages.Admin.Tabs.Overview.overview, Pages.Manager.Panels.ReportsPanel.reportsPanel, Pages.LiveView.page, Pages.EditItem.page, +3 more

standardView :: String -> RemoteView
  ~ called by: Pages.Manager.Panels.ActivityFeed.activityFeed, Pages.Admin.Tabs.Overview.snapshotView, Pages.LiveView.inventoryView, Pages.Manager.Panels.ReportsPanel.reportsPanel, UI.Transaction.InventoryPicker.inventoryPicker, Pages.TransactionHistory.page, Pages.Registers.page

quietView :: RemoteView
  ~ called by: Pages.Manager.Panels.StatsPanel.statsPanel, Pages.Manager.Panels.AlertsPanel.alertsPanel



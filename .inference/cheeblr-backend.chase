  ! idempotent; called from App.runWithEnv after the other create*Tables calls
  ? no test references

getStoredTaxRules :: DBPool -> IO (Either Text [StoredTaxRule])
  ! effects: DBPool, IO
  ! reads every row and sorts by (tax_category, id) for a stable order
  ! one undecodable row makes the whole read Left, with the row id in the message
  > consumed by: Effect.TaxRules.runTaxRulesIO
  ? no test references

decodeTaxRuleRow :: TaxRuleRow Result -> Either Text StoredTaxRule
  ? no test references

%decision TaxRulesAreData
  what:    Tax rules live in the tax_rule table keyed by optional location, optional item category, tax category, rate_ppm, rounding and an effective date range
  why:     Rates and rules change without a deploy. Selection by location and time is done in Haskell (Domain.TaxRule.activeRules), not SQL, so it is pure and tested; the table is tiny.
  affects: getStoredTaxRules, createTaxRuleTables

%open_issue PlaceholderTaxRuleSeed
  what:     createTaxRuleTables inserts one placeholder rule (8% REGULAR_SALES_TAX, all locations and categories, HALF_UP) when the table is empty
  why:      8% is the rate the browser used to hardcode. It is not a real tax rule. There is no admin UI or endpoint for editing rules; they are changed with SQL.
  blocking: real sales, a tax rule admin screen
  affects:  createTaxRuleTables



%file /home/bismuth/git/cheeblr/backend/src/State/SaleTransactionMachine.hs
%mod State.SaleTransactionMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics
%uses qualified Types.Transaction as Legacy
%uses qualified Types.Transaction.Sale as Sale

instance RenderableVertices SaleTxVertex where

type SaleTxTopology =
  'Topology
    '[ '( 'SaleCreated, '[ 'SaleCreated, 'SaleInProgress, 'SaleVoided])
     , '( 'SaleInProgress, '[ 'SaleInProgress, 'SaleCompleted, 'SaleVoided])
     , '( 'SaleCompleted, '[ 'SaleCompleted, 'SaleVoided, 'SaleRefunded])
     , '( 'SaleVoided, '[ 'SaleVoided])
     , '( 'SaleRefunded, '[ 'SaleRefunded])
     ]

data SaleTxState (v :: SaleTxVertex) where
  CreatedState :: Sale.SaleTransaction -> SaleTxState 'SaleCreated
  InProgressState :: Sale.SaleTransaction -> SaleTxState 'SaleInProgress
  CompletedState :: Sale.SaleTransaction -> SaleTxState 'SaleCompleted
  VoidedState :: Sale.SaleTransaction -> SaleTxState 'SaleVoided
  RefundedState :: Sale.SaleTransaction -> SaleTxState 'SaleRefunded

data SomeSaleTxState = forall v. SomeSaleTxState (SSaleTxVertex v) (SaleTxState v)

data SaleTxCommand
  = AddItemCmd Sale.Item
  | RemoveItemCmd UUID
  | AddPaymentCmd Sale.Payment
  | RemovePaymentCmd UUID
  | FinalizeCmd
  | VoidCmd Text
  | RefundCmd Text UUID
  deriving (Show, Eq, Generic)

data SaleTxEvent
  = ItemAdded Sale.Item
  | ItemRemoved UUID
  | PaymentAdded Sale.Payment
  | PaymentRemoved UUID
  | TxFinalized
  | TxWasVoided Text
  | TxWasRefunded Text UUID
  | InvalidTxCommand Text
  deriving (Show, Eq, Generic)

fromSaleTransaction :: Sale.SaleTransaction -> SomeSaleTxState
  ? no test references

toSomeSaleTxState :: SaleTxState v -> SomeSaleTxState
  ? no test references

txAction :: SaleTxState v -> SaleTxCommand -> ActionResult Identity SaleTxTopology SaleTxState v SaleTxEvent
  ! Created     -> {InProgress via AddItemCmd, Voided via VoidCmd}; everything else is InvalidTxCommand
  ! InProgress  -> {InProgress via item/payment add+remove, Completed via FinalizeCmd, Voided via VoidCmd}
  ! Completed   -> {Voided via VoidCmd, Refunded via RefundCmd}; item and payment commands are invalid
  ! Voided and Refunded are absorbing; any command yields InvalidTxCommand ('Sale transaction is voided' / 'is refunded')
  ! FinalizeCmd from InProgress is legal here whatever the payments; the paid-in-full rule is not in the machine
  ? no test references

runTxCommand :: SomeSaleTxState -> SaleTxCommand -> (SaleTxEvent, SomeSaleTxState)
  ! callers look only at the returned event; InvalidTxCommand carries the 409 body
  ! the next state it returns is discarded by every caller
  > consumed by: Service.Transaction.addItem, removeItem, addPayment, removePayment, finalizeTx, voidTx, refundTx
  ? tested by: Test.State.TransactionMachineSpec.spec, Test.Props.StateMachineSpec.spec

cmdLabel :: SaleTxCommand -> Text
  ? no test references

someTxStatus :: SomeSaleTxState -> Legacy.TransactionStatus
  ? no test references

%decision SaleMachineIsAnEarlyCheckOnly
  what:    The crem machine over Sale.SaleTransaction says which command is legal from which status; Service.Transaction uses it for an early 409 and nothing else
  why:     The authoritative check is the status read under the sale row lock in DB.Transaction. The machine and the locked checks must agree. They are two hand-written statements of one rule; the planned formal model would be the single source for both.
  affects: txAction, runTxCommand, fromSaleTransaction


=== BEGIN State/StockPullMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/StockPullMachine.hs
%mod State.StockPullMachine

%ext DataKinds, DeriveGeneric, EmptyCase, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Aeson
%uses Data.Functor.Identity
%uses Data.OpenApi
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics

instance ToJSON PullVertex

instance FromJSON PullVertex

instance ToSchema PullVertex

instance RenderableVertices PullVertex where

type PullTopology =
  'Topology
    '[ '( 'PullPending, '[ 'PullPending, 'PullAccepted, 'PullCancelled])
     , '( 'PullAccepted, '[ 'PullAccepted, 'PullPulling, 'PullCancelled])
     , '( 'PullPulling, '[ 'PullPulling, 'PullFulfilled, 'PullIssue])
     , '( 'PullFulfilled, '[ 'PullFulfilled])
     , '( 'PullCancelled, '[ 'PullCancelled])
     , '( 'PullIssue, '[ 'PullIssue, 'PullAccepted, 'PullCancelled])
     ]

data PullState (v :: PullVertex) where
  PendingState :: PullState 'PullPending
  AcceptedState :: PullState 'PullAccepted
  PullingState :: PullState 'PullPulling
  FulfilledState :: PullState 'PullFulfilled
  CancelledState :: PullState 'PullCancelled
  IssueState :: PullState 'PullIssue

data SomePullState = forall v. SomePullState (SPullVertex v) (PullState v)

data PullCommand
  = AcceptCmd UUID
  | StartPullCmd UUID
  | FulfillCmd UUID
  | ReportIssueCmd Text UUID
  | RetryCmd UUID
  | CancelCmd Text UUID
  deriving (Show, Eq, Generic)

data PullEvent
  = PullWasAccepted UUID
  | PullingWasStarted UUID
  | PullWasFulfilled UUID
  | IssueWasReported Text UUID
  | PullWasRetried UUID
  | PullWasCancelled Text UUID
  | InvalidPullCmd Text
  deriving (Show, Eq, Generic)

fromVertex :: PullVertex -> SomePullState
  ! rebuilds typed state from a database-loaded PullVertex
  ! lossless: every PullVertex maps to exactly one PullState constructor
  ? tested by: Test.State.StockPullMachineSpec.step

toPullVertex :: SomePullState -> PullVertex
  ! pattern-matches the singleton inside SomePullState (SPullPending, SPullAccepted, ...) to its PullVertex; inverse of fromVertex
  ! Service.Stock.transition persists this value after runPullCommand
  ? tested by: Test.State.StockPullMachineSpec.step

toSomePullState :: PullState v -> SomePullState
  ? no test references

pullAction :: PullState v -> PullCommand -> ActionResult Identity PullTopology PullState v PullEvent
  ! Pending  -> {Accepted via AcceptCmd, Cancelled via CancelCmd}; everything else is InvalidPullCmd
  ! Accepted -> {Pulling via StartPullCmd, Cancelled via CancelCmd}
  ! Pulling  -> {Fulfilled via FulfillCmd, Issue via ReportIssueCmd}; cannot be cancelled directly
  ! Issue    -> {Accepted via RetryCmd, Cancelled via CancelCmd}
  ! Fulfilled and Cancelled are absorbing; any further command yields InvalidPullCmd, no state change
  ? no test references

runPullCommand :: SomePullState -> PullCommand -> (PullEvent, SomePullState)
  ! wraps pullAction; existential erasure means callers cannot inspect the new vertex's type
  ! callers pattern-match on the returned PullEvent to know which transition fired
  ! InvalidPullCmd indicates same-state with no transition; the SomePullState is unchanged
  > consumed by: Service.Stock.transition (the only orchestrator that runs commands against this machine)
  ? tested by: Test.State.StockPullMachineSpec.step

%decision StateMachineEnforcedAtTypeLevel
  what:    PullState is GADT-indexed by PullVertex; transitions live in pullAction whose type uses crem ActionResult
  why:     The DSL prevents constructing a transition not in PullTopology. Service.Stock.transition relies on this: it persists the new vertex without re-validating, trusting the machine output. Illegal commands produce a PullEvent with constructor InvalidPullCmd, NOT a Haskell exception, so the service layer can map it to err409.
  affects: pullAction, runPullCommand, fromVertex, toPullVertex


=== BEGIN State/TransactionMachine.hs ===

%file /home/bismuth/git/cheeblr/backend/src/State/TransactionMachine.hs
%mod State.TransactionMachine

%ext DataKinds, DeriveGeneric, EmptyCase, ExistentialQuantification, GADTs, InstanceSigs, LambdaCase, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.Singletons.Base.TH
%uses Data.Text
%uses Data.UUID
%uses GHC.Generics
%uses qualified Types.Transaction as T

instance RenderableVertices TxVertex where

type TxTopology =
  'Topology
    '[ '( 'TxCreated, '[ 'TxCreated, 'TxInProgress, 'TxVoided])
     , '( 'TxInProgress, '[ 'TxInProgress, 'TxCompleted, 'TxVoided])
     , '( 'TxCompleted, '[ 'TxCompleted, 'TxVoided, 'TxRefunded])
     , '( 'TxVoided, '[ 'TxVoided])
     , '( 'TxRefunded, '[ 'TxRefunded])
     ]

data TxState (v :: TxVertex) where
  CreatedState :: T.Transaction -> TxState 'TxCreated
  InProgressState :: T.Transaction -> TxState 'TxInProgress
  CompletedState :: T.Transaction -> TxState 'TxCompleted
  VoidedState :: T.Transaction -> TxState 'TxVoided
  RefundedState :: T.Transaction -> TxState 'TxRefunded

data SomeTxState = forall v. SomeTxState (STxVertex v) (TxState v)

data TxCommand
  = AddItemCmd T.TransactionItem
  | RemoveItemCmd UUID
  | AddPaymentCmd T.PaymentTransaction
  | RemovePaymentCmd UUID
  | FinalizeCmd
  | VoidCmd Text
  | RefundCmd Text UUID
  deriving (Show, Eq, Generic)

data TxEvent
  = ItemAdded T.TransactionItem
  | ItemRemoved UUID
  | PaymentAdded T.PaymentTransaction
  | PaymentRemoved UUID
  | TxFinalized
  | TxWasVoided Text
  | TxWasRefunded Text UUID
  | InvalidTxCommand Text
  deriving (Show, Eq, Generic)

fromTransaction :: T.Transaction -> SomeTxState
  ! dispatches on transactionStatus field to choose the correct SomeTxState constructor
  ? tested by: Test.State.TransactionMachineSpec.spec, Test.Props.StateMachineSpec.someTxState

toSomeTxState :: TxState v -> SomeTxState
  ? no test references

txAction :: TxState v -> TxCommand -> ActionResult Identity TxTopology TxState v TxEvent
  ! Created     -> {InProgress via AddItemCmd, Voided via VoidCmd}; everything else is InvalidTxCommand
  ! InProgress  -> {InProgress via item/payment add+remove, Completed via Finalize, Voided via Void}
  ! Completed   -> {Voided via Void, Refunded via Refund}; further item/payment ops are invalid
  ! Voided and Refunded are absorbing; any further command yields InvalidTxCommand
  ! AddItemCmd from Created sets transactionStatus = InProgress on the carried Transaction value, NOT just the type-level vertex
  ? no test references

runTxCommand :: SomeTxState -> TxCommand -> (TxEvent, SomeTxState)
  ! no module under src imports State.TransactionMachine any more; Service.Transaction uses State.SaleTransactionMachine, which has the same topology over Sale.SaleTransaction
  ! kept for its tests
  > consumed by: tests only
  ? tested by: Test.State.TransactionMachineSpec.spec, Test.Props.StateMachineSpec.spec

cmdLabel :: TxCommand -> Text
  ! human-readable command names used in InvalidTxCommand error messages
  ! MUST stay in sync with TxCommand constructors; partial functions would silently produce 'Cannot ?' messages
  ? no test references

someTxStatus :: SomeTxState -> T.TransactionStatus
  ! extracts TransactionStatus from a SomeTxState by inspecting the singleton tag
  > consumed by: tests only
  ? no test references

%decision CremForLifecycleEnforcement
  what:    crem (singletons-based type-level state machines) for transaction, register, and stock-pull lifecycles
  why:     Transaction, register, and stock-pull state transitions are legally significant for cannabis compliance — an unintended Created -> Completed shortcut is a reportable violation. crem encodes the topology in types via singletons + GADTs; any transition not declared in the Topology fails to compile. All three machines pair (SomeXxxState, fromXxx, toSomeXxxState) so callers handle existential states without leaking type-level vertices.
  affects: txAction, runTxCommand, fromTransaction, toSomeTxState, someTxStatus



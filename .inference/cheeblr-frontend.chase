=== BEGIN Types/Manager.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Types/Manager.purs
%mod Types.Manager

%uses Prelude
%uses Data.DateTime
%uses Foreign
%uses Types.Register
%uses Types.Transaction
%uses Types.UUID
%uses Yoga.JSON

type TransactionSummary =
  { tsId :: UUID
  , tsStatus :: TransactionStatus
  , tsCreated :: DateTime
  , tsElapsedSecs :: Int
  , tsItemCount :: Int
  , tsTotal :: Int
  , tsIsStale :: Boolean
  }

-- Backend Server.Manager.buildDayStats, for the UTC day: ldsTxCount counts
-- sales whose status is Completed or Refunded; ldsRevenue is net of returns;
-- ldsVoidCount counts sales flagged voided; ldsRefundCount counts sales
-- flagged refunded; ldsAvgTxValue is net revenue divided by the sale count.

type LocationDayStats =
  { ldsTxCount :: Int
  , ldsRevenue :: Int
  , ldsVoidCount :: Int
  , ldsRefundCount :: Int
  , ldsAvgTxValue :: Int
  }

-- The backend type is a sum with positional fields and a generic Aeson
-- instance, so an alert arrives as {"tag": <constructor>, "contents": [...]}.
--   LowInventoryAlert      sku, item name, quantity on hand, threshold
--   StaleTransactionAlert  sale id, seconds since the sale was created
--   RegisterVarianceAlert  register id, expected minus counted, in cents

data ManagerAlert
  = LowInventoryAlert
      { sku :: UUID, name :: String, quantity :: Int, threshold :: Int }
  | StaleTransactionAlert { saleId :: UUID, elapsedSecs :: Int }
  | RegisterVarianceAlert { registerId :: UUID, variance :: Int }

derive instance eqManagerAlert :: Eq ManagerAlert

instance showManagerAlert :: Show ManagerAlert where

instance readForeignManagerAlert :: ReadForeign ManagerAlert where

type ActivitySummary =
  { asSummaryTime :: DateTime
  , asOpenRegisters :: Array Register
  , asLiveTransactions :: Array TransactionSummary
  , asTodayStats :: LocationDayStats
  , asAlerts :: Array ManagerAlert
  }

-- The backend reads neither field yet, but it decodes the body, so both
-- must be well formed: an ISO 8601 time and a UUID.

type DailyReportRequest =
  { dailyReportDate :: DateTime
  , dailyReportLocationId :: UUID
  }

-- Only dailyReportTotal and dailyReportTransactions come from sales. The
-- backend does not compute the cash and card figures from payments.

type DailyReportResult =
  { dailyReportCash :: Int
  , dailyReportCard :: Int
  , dailyReportOther :: Int
  , dailyReportTotal :: Int
  , dailyReportTransactions :: Int
  }

%decision ManagerAlertIsTheTaggedSumTheBackendWrites
  what:    ManagerAlert is a sum type decoded from {tag, contents}, the shape Aeson's generic instance writes for the backend type
  why:     LowInventoryAlert: sku, item name, quantity on hand, threshold. StaleTransactionAlert: sale id, seconds open. RegisterVarianceAlert: register id, expected minus counted in cents. The front end used to expect a flat record with a tag and optional fields. The backend never wrote that shape, so every alert lost its details, and the old tests pinned the wrong shape. Decoding is strict: an unknown tag or a contents array of the wrong length fails the whole response. test/Wire.purs holds a backend-shaped activity summary with all three alerts.
  affects: 

%open_issue DayStatsMeaningNotAgreedWithOwner
  what:     LocationDayStats is displayed without saying what the numbers mean; the backend definitions changed when REFUNDED was added
  why:      Backend Server.Manager.buildDayStats: ldsTxCount counts sales whose status is Completed or Refunded; ldsRevenue is net of returns; ldsRefundCount counts sales of the day flagged refunded; ldsAvgTxValue is net revenue divided by the sale count. The average formula was chosen by the implementer and has not been confirmed by the owner. 'Today' is the UTC day.



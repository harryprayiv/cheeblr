=== BEGIN Pages/CreateTransaction.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Pages/CreateTransaction.purs
%mod Pages.CreateTransaction

%uses Prelude
%uses API.Inventory
%uses API.Register as RegisterApi
%uses API.Request as Request
%uses Config.LiveView
%uses Control.Parallel
%uses Data.Either
%uses Data.Maybe
%uses Data.Tuple
%uses Data.Tuple.Nested
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Listeners as DL
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect.Aff
%uses Effect.Class
%uses Services.CurrentSale as CurrentSale
%uses Services.RegisterService as RegisterService
%uses Types.Inventory
%uses Types.Register
%uses Types.RemoteData
%uses Types.Session
%uses Types.Transaction.Sale as Sale
%uses UI.Inventory.ItemForm
%uses UI.Remote
%uses UI.Transaction.CreateTransaction as TransactionUI

%untested load, begin, page

data TxPageStatus
  = TxPageLoading
  | TxPageNeedsRegister String
  | TxPageNoSale (RemoteData Inventory) Register
  | TxPageStarting
  | TxPageReady (RemoteData Inventory) Register Sale.SaleTransaction
  | TxPageError String

-- What the sale page needs before it can show a sale:
--   a register chosen on this device (Services.RegisterService),
--   that register existing on the backend and being open,
--   a sale to work on (Services.CurrentSale).
-- Nothing here creates or opens a register, and nothing here starts a sale.
-- When a register is missing or closed the page says so and links to the
-- registers page. When this user has no open sale on the register the page
-- shows a Start Sale button (TxPageNoSale); the sale is created when that
-- button is pressed.

load :: SessionResponse -> Aff TxPageStatus
  ! Sends no write.
  ! Reads the chosen register id from Services.RegisterService. With none it returns TxPageNeedsRegister without any request.
  ! Fetches the inventory and the register in parallel.
  ! A failed inventory fetch does not stop the page: the status carries Failure 'Inventory unavailable: ...' and the screen can refresh it.
  ! A failed register fetch other than 404 gives TxPageError with the backend's text.
  ! On an open register: a resumable sale gives TxPageReady, none gives TxPageNoSale, and a remembered sale that could not be read gives TxPageError 'Could not load the open sale: ...'.
  ~ called by: Pages.CreateTransaction.page

begin :: RemoteData Inventory -> Register -> Aff TxPageStatus
  ! Calls Services.CurrentSale.startOn. Success gives TxPageReady with the inventory load already fetched; failure gives TxPageError 'Could not start a sale: ...'.
  ~ called by: Pages.CreateTransaction.page

page :: SessionResponse -> Nut
  ! Holds the status in a useHot cell and runs load from onMount.
  ! Start Sale sets TxPageStarting before the request, so the button is gone while the request runs and cannot be pressed twice.
  ~ called by: Main.main

%decision SalePageNeedsAChosenOpenRegister
  what:    load shows the sale screen only when this browser has a chosen register that the backend knows and that is open
  why:     Nothing here creates or opens a register. When one is missing, gone (404) or closed the page says so and links to /#/register. The closed-register rule is the front end's. The backend starts a sale on any register id. With a register in hand, Services.CurrentSale.resume looks for this user's open sale on it.
  affects: load

%decision SaleStartsFromAButton
  what:    Opening the sale page starts no sale. With no resumable sale the page shows TxPageNoSale with a Start Sale button, and begin starts the sale when it is pressed
  why:     load used to call resumeOrStart, so every visit without a resumable sale sent POST /pos/sale. See Services.CurrentSale.NothingHereStartsASaleOnItsOwn. A button was chosen over starting the sale with the first added item because UI.Transaction.CreateTransaction and its four parts all take a sale that exists. Starting with the first item needs a sale-less state in each of them. TxPageStatus has six cases: TxPageLoading, TxPageNeedsRegister, TxPageNoSale, TxPageStarting, TxPageReady, TxPageError. The Start Sale card has the CSS class no-sale and the register message has register-needed; both are styled in the SESSION-ERA PAGES section of app-styles.css.
  affects: load, begin, page



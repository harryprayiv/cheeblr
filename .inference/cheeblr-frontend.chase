  , taxRate        :: Number
  , taxAmount      :: RefundMoney
  , taxDescription :: String
  }

type Payment =
  { paymentId                :: UUID
  , paymentTransactionId     :: UUID
  , paymentMethod            :: PaymentMethod
  , paymentAmount            :: RefundMoney
  , paymentTendered          :: RefundMoney
  , paymentChange            :: RefundMoney

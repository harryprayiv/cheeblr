type PaymentInput =
  { method :: PaymentMethod
  , amount :: Int
  , tendered :: Maybe Int
  , authCode :: Maybe String
  }

-- Only the SKU and quantity are sent. The backend prices the line.

addItem
  :: UUID
  -> MenuItem
  -> Int
  -> Aff (Either ApiError Sale.SaleTransaction)
  ! Sends the sale id, the SKU and the quantity. The backend prices the line.
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

removeItem :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

addPayment
  :: UUID
  -> PaymentInput
  -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

removePayment :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

clear :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

finalize :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen

%decision ServerIsTheOnlyPricer
  what:    Every action sends ids and quantities only and replaces the sale on screen with the SaleTransaction the backend returns
  why:     The backend decides each sale write under a row lock on the sale and may refuse it; the front end never computes a price, tax, change or stock level that is then trusted.
  affects: addItem, removeItem, addPayment, removePayment, clear, finalize



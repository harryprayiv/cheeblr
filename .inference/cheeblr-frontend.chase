  ! Does NOT handle currency symbols, commas, or whitespace within the number; caller is responsible for normalization.
  ~ no callers in scanned roots
  ? tested by: Test.Money.spec


=== BEGIN Utils/SSE.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Utils/SSE.purs
%mod Utils.SSE

%uses Prelude
%uses Data.Maybe
%uses Effect
%uses Effect.Ref as Ref
%uses FRP.Poll
%uses FRP.Poll as Poll
%uses Control.Alt
%uses Control.Monad.ST.Class

%untested openSSE, openSSEImpl

data SSEStatus
  = SSEConnecting
  | SSEConnected
  | SSEReconnecting
  | SSEClosed

derive instance eqSSEStatus :: Eq SSEStatus

instance showSSEStatus :: Show SSEStatus where

type SSEConnection =
  { status  :: Poll SSEStatus
  , close   :: Effect Unit
  }

%foreign
foreign import openSSEImpl
  :: String
  -> (String -> Effect Unit)
  -> (String -> Effect Unit)
  -> Effect (Effect Unit)
  ~ called by: Utils.SSE.openSSE

openSSE
  :: String
  -> (String -> Effect Unit)
  -> Effect SSEConnection
  ! intent: Open an EventSource, return a connection object with a status Poll and a close action
  ! effects: IO (foreign import openSSEImpl)
  ! Status starts as SSEConnecting (via the pure SSEConnecting <|> statusRef.poll combinator).
  ! Unknown status strings from the JS layer fall through to SSEConnecting; this is permissive by design so future JS-side status types don't break the type checker.
  ~ called by: Pages.Admin.Tabs.LogViewer.logViewer, Pages.Stock.Interface.page

%decision SSEStatusViaForeignImportPushedIntoPoll
  what:    openSSEImpl is a foreign import that takes both an onMessage and an onStatus callback; the PureScript wrapper translates status strings into SSEStatus and pushes them into a Poll
  why:     EventSource lifecycle events (open, error, close, reconnecting) need to be exposed to the UI for the SSEStatus indicator widget. A Poll lets multiple consumers subscribe to status changes (the SSEStatus component, plus potentially logging or analytics). Mapping status strings in the foreign import boundary keeps the JS side simple (it just stringifies); typed mapping happens on the PS side.
  affects: openSSE

%decision EventSourceIsOpenedWithCredentials
  what:    The foreign openSSEImpl creates the EventSource with withCredentials: true
  why:     The streams are on the API origin and authenticate with the session cookie. A cross-origin EventSource sends cookies only with this option. Stream URLs used to carry the user id as a query parameter, which the backend never read.
  affects: openSSE



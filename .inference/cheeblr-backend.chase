%mod Server.Feed

%ext OverloadedStrings, ScopedTypeVariables

%uses Control.Concurrent.STM
%uses Control.Exception
%uses Control.Monad.IO.Class
%uses qualified Data.Aeson as Aeson
%uses qualified Data.ByteString.Lazy as LBS
%uses Data.Foldable
%uses Data.Int
%uses Data.Maybe
%uses Data.Time

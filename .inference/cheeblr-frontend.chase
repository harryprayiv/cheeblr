%file /home/bismuth/git/cheeblr/frontend/src/API/Sale.purs
%mod API.Sale

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Data.Either
%uses Effect.Aff
%uses Types.Transaction.Refund as Refund
%uses Types.Transaction.Sale as Sale
%uses Types.UUID

%untested getAllSales, getSale, voidSale, refundSale

getAllSales :: Aff (Either ApiError (Array Sale.SaleTransaction))
  ! GET /sale returns every sale of every status. Refund rows are not included.
  ! Any signed-in user may call it.
  ~ called by: Pages.TransactionHistory.page

getSale :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: UI.Transaction.CreateTransaction.saleScreen, Services.CurrentSale.resume

voidSale :: UUID -> String -> Aff (Either ApiError Sale.SaleTransaction)
  ! POST /sale/void/<id> with the reason as a JSON string.
  ! Refused 403 without capCanVoidTransaction. Refused 409 for a sale already voided or refunded. The backend checks no ownership.
  ~ called by: Pages.TransactionHistory.page

refundSale :: UUID -> String -> Aff (Either ApiError Refund.RefundTransaction)
  ! POST /sale/refund/<id> with the reason as a JSON string. The answer is the refund row.
  ! Refused 403 without capCanRefundTransaction. Refused 409 unless the sale is completed and not yet refunded.
  ~ called by: Pages.TransactionHistory.page

%decision ReadsAndManagerOpsOnly
  what:    Only getAllSales, getSale, voidSale and refundSale are here; sale building is in API.SaleCommand
  why:     Callers: Pages.TransactionHistory (getAllSales, voidSale, refundSale), UI.Transaction.CreateTransaction and Services.CurrentSale (getSale).
  affects: getAllSales, getSale, voidSale, refundSale

%open_issue SaleListIsUnbounded
  what:     getAllSales loads every sale ever made in one response
  why:      The backend route has no paging or date filter. Pages.TransactionHistory sorts and draws the whole list. Needs a backend change first.
  affects:  getAllSales


=== BEGIN API/SaleCommand.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/API/SaleCommand.purs
%mod API.SaleCommand

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Data.Either
%uses Data.Maybe
%uses Effect.Aff
%uses Types.Transaction
%uses Types.Transaction.Sale as Sale
%uses Types.UUID

%untested startSale, addItem, removeItem, addPayment, removePayment, clear, finalize

type StartSaleRequest =
  { startSaleRegisterId :: UUID
  , startSaleLocationId :: UUID
  }

type AddItemRequest =
  { addItemSaleId :: UUID
  , addItemSku :: UUID
  , addItemQuantity :: Int
  }

-- Amounts are cents. With no tendered amount the payment is exact.

type AddPaymentRequest =
  { addPaymentSaleId :: UUID
  , addPaymentMethod :: PaymentMethod
  , addPaymentAmount :: Int
  , addPaymentTendered :: Maybe Int
  , addPaymentReference :: Maybe String
  }

-- Refusals the sale writes below can return:
--   400  insufficient inventory, or a line the pricing rules reject
--   403  the sale belongs to another employee
--   404  the sale, item, line or payment is not found
--   409  the sale is no longer open, or finalize was refused

startSale :: StartSaleRequest -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.CurrentSale.start

addItem :: AddItemRequest -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.addItem

removeItem :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.removeItem

addPayment :: AddPaymentRequest -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.addPayment

removePayment :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.removePayment

clear :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.clear

finalize :: UUID -> Aff (Either ApiError Sale.SaleTransaction)
  ~ called by: Services.SaleActions.finalize

%decision MirrorsBackendRequestTypes
  what:    Request record field names match backend Types.Transaction.Request exactly; every command returns Sale.SaleTransaction
  why:     Routes are under /pos/sale and are served by backend Server.SaleCommand. StartSaleRequest names a register and a location and no employee. The backend records the session user as the opener. Every command returns Either ApiError. The refusals are: 400 insufficient inventory or a line the pricing rules reject, 403 the sale belongs to another employee, 404 not found, 409 the sale is no longer open or finalize was refused.
  affects: startSale, addItem, addPayment

%open_issue NoIdempotencyKeyOnWrites
  what:     addItem and addPayment carry no client-generated request id; a retry after a lost response adds a second line or a second payment
  why:      The backend has no idempotency handling either; this is an open backend item and needs a field on both request types.
  blocking: safe retry of add item and add payment
  affects:  addItem, addPayment

%open_issue NoSetQuantityCommand
  what:     There is no command to change the quantity of a line; the only way is removeItem followed by addItem
  why:      Between the two calls the stock is back on the shelf and another register can take it. Missing on the backend as well.
  affects:  addItem, removeItem



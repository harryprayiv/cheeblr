%file /home/bismuth/git/cheeblr/backend/src/Domain/StockPolicy.hs
%mod Domain.StockPolicy

%ext OverloadedStrings

%uses Data.Text
%uses qualified Data.Text as T

data RestockPolicy
  = ReturnToStock
  | DoNotRestock
  deriving (Show, Eq)

data StockPolicy = StockPolicy
  { restockOnVoid   :: RestockPolicy
  , restockOnRefund :: RestockPolicy
  }
  deriving (Show, Eq)

parseRestockPolicy :: Text -> Either Text RestockPolicy
  ! accepts exactly 'restock' and 'no-restock', ignoring case and surrounding spaces; anything else is Left naming the value
  ? no test references

restockPolicyText :: RestockPolicy -> Text
  ? no test references

%decision RestockIsConfigurationWithNoDefault
  what:    Whether a void or a refund of a COMPLETED sale puts its quantities back in stock is a setting, one for void and one for refund, each restock or no-restock
  why:     Owner decision 2026-10-08: some goods can go back on the shelf and some cannot, so both behaviours exist and the deployer is forced to choose. Read from RESTOCK_ON_VOID and RESTOCK_ON_REFUND by Config.App. Every other setting has a default; these two stop the backend at startup when missing or unreadable. A void of a sale that was never completed is not affected; it only releases reservations. The dev shell exports both from nix/stock-policy.nix (void: restock, refund: no-restock; the author's guess for cannabis retail, not confirmed by the owner). Per-line restock (one item back on the shelf, another destroyed) is not expressible.
  affects: parseRestockPolicy, restockPolicyText



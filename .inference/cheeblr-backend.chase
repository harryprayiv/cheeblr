=== BEGIN Infrastructure/Broadcast.hs ===

%file /home/bismuth/git/cheeblr/backend/src/Infrastructure/Broadcast.hs
%mod Infrastructure.Broadcast

%uses Control.Concurrent.STM
%uses Data.Int
%uses Data.Sequence
%uses qualified Data.Sequence as Seq

data Broadcaster a = Broadcaster
  { bChan :: TChan a
  , bHistory :: TVar (Seq (Int64, a))
  , bMaxHistory :: Int
  , bNextSeq :: TVar Int64
  }

data Subscription a = Subscription
  { subChan :: TChan a
  , subInitSeq :: Int64
  }

newBroadcaster :: Int -> IO (Broadcaster a)
  ! TChan is a broadcast channel; subscribers each get an independent dup
  ! bMaxHistory is fixed at construction; cannot be resized at runtime
  ! bNextSeq starts at 0; first published event has seq 0
  ? no test references

publish :: Broadcaster a -> a -> IO ()
  ! intent: Atomically bump seq, write to channel, append to bounded history
  ! effects: STM, IO
  ! ORDER inside the STM transaction: read seq, write seq+1, write to chan, trim history
  ! history is dropped FIFO when length exceeds bMaxHistory (Seq.drop 1)
  ! spec: pre <- currentSeq bc; publish bc evt; post <- currentSeq bc => post == pre + 1
  ! spec: replicateM_ (bMaxHistory + n) (publish bc evt); historyDepth bc => bMaxHistory bc
  > consumed by: Effect.EventEmitter.runEventEmitterProd (every domain event)
  > consumed by: Katip.BroadcastScribe (every log line at or above the configured severity)
  > consumed by: Infrastructure.AvailabilityRelay (publishes AvailabilityUpdate frames)
  ? no test references

subscribe :: Broadcaster a -> IO (Subscription a)
  ! subInitSeq is the seq at the moment of subscribe; events with that seq or later flow through subChan
  ! subscribers DO NOT see history automatically; sseStream and wsHandler replay history themselves before reading subChan
  ! no unsubscribe operation; channels are GC-cleaned when subscribers drop their reference
  > consumed by: Server.Feed.wsHandler (live-tail)
  > consumed by: Server.SSE / admin live event tail
  > consumed by: Infrastructure.AvailabilityRelay's own subscribe to the domain broadcaster
  ? no test references

historyFrom :: Broadcaster a -> Int64 -> IO (Seq (Int64, a))
  ! returns all (seq, event) pairs with seq strictly greater than cursor
  ! uses Seq.filter; O(n) over current history
  ! result is bounded by bMaxHistory regardless of cursor value
  > consumed by: Server.Feed.wsHandler cursor-replay path
  ? no test references

historyDepth :: Broadcaster a -> IO Int
  ? no test references

currentSeq :: Broadcaster a -> IO Int64
  ! next seq value that publish would assign (NOT the just-published one)
  ! uses readTVarIO (no STM transaction); cheaper than subscribe for a snapshot
  ? no test references

%decision BoundedInMemoryReplay
  what:    TChan plus bounded Data.Sequence history per stream
  why:     Late SSE/WS subscribers need to catch up without scanning domain_events for every connect. O(1) publish and O(history) replay. Anything older than the bound is unreachable from this broadcaster; clients fall back to /admin/domain-events with a cursor for deeper history. Bound is per-broadcaster from cfgLogBroadcastSize / cfgDomainBroadcastSize / cfgStockBroadcastSize / cfgAvailabilityBroadcastSize.
  affects: newBroadcaster, publish, historyFrom



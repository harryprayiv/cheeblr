%file /home/bismuth/git/cheeblr/frontend/src/GraphQL/Inventory.purs
%mod GraphQL.API.Inventory

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Data.Either
%uses Effect.Aff
%uses Types.Inventory
%uses Yoga.JSON

%untested gqlPost, inventoryQuery, readInventoryGql, writeInventoryGql, updateInventoryGql, deleteInventoryGql

type GqlResponse a = { data :: a }

gqlPost :: forall a. ReadForeign a => String -> Aff (Either ApiError a)
  ~ called by: GraphQL.API.Inventory.readInventoryGql, GraphQL.API.Inventory.writeInventoryGql, GraphQL.API.Inventory.updateInventoryGql, GraphQL.API.Inventory.deleteInventoryGql

inventoryQuery :: String
  ! Hardcoded query string requesting every field on every menu item; no field selection or pagination.
  ! Fine because inventories are small; would need rework for thousands of items.
  ~ called by: GraphQL.API.Inventory.readInventoryGql

readInventoryGql :: Aff (Either ApiError Inventory)
  ~ called by: Pages.LiveView.page, API.Inventory.fetchInventory

writeInventoryGql :: MenuItem -> Aff (Either ApiError MutationResponse)
  ~ no callers in scanned roots

updateInventoryGql :: MenuItem -> Aff (Either ApiError MutationResponse)
  ~ no callers in scanned roots

deleteInventoryGql :: String -> Aff (Either ApiError MutationResponse)
  ~ no callers in scanned roots

%decision GqlPostUsesTheSharedRequestCore
  what:    gqlPost is API.Request.post to /graphql/inventory with {query}, and returns the data field of the answer
  why:     Authentication is the session cookie, as for every other request. A GraphQL error answer has no data field and arrives as Undecodable.
  affects: gqlPost

%decision RawGraphqlQueryStringNoSchemaCodegen
  what:    Queries and mutations are raw string templates with no codegen or type-safe builder
  why:     Yoga.JSON's writeJSON handles serializing MenuItem into the mutation input. No PureScript GraphQL schema codegen exists in this project; a mismatch between the query string and the schema would only surface at runtime. Acceptable because there are only four operations (read/write/update/delete inventory); a larger surface would justify codegen.
  affects: inventoryQuery, readInventoryGql, writeInventoryGql, updateInventoryGql, deleteInventoryGql

%open_issue DeleteMutationUsesStringInterpolationForSku
  what:     deleteInventoryGql interpolates sku into the GraphQL query string with manual quoting: deleteMenuItem(sku: \"" <> sku <> "\")
  why:      If sku ever contains a backslash, double-quote, or newline, the mutation breaks (best case) or becomes injection-shaped (worst case). GraphQL parsers do escape-handle string literals, but the client-side interpolation here doesn't escape anything. Currently safe because parseUUID guarantees the input matches [0-9a-f-]+ only, but the guarantee is implicit and easily lost. Fix: use a variables block: { query: 'mutation D($sku: ID!) { deleteMenuItem(sku: $sku) { ... } }', variables: { sku } }.
  affects:  deleteInventoryGql


=== BEGIN Main.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Main.purs
%mod Main

%uses Prelude
%uses API.Auth as Auth
%uses API.Request as Request
%uses Control.Alt
%uses Control.Monad.ST.Class
%uses Data.Either
%uses Data.Tuple
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.Hooks
%uses Deku.Toplevel
%uses Effect
%uses Effect.Aff
%uses Effect.Class
%uses Effect.Class.Console as Console
%uses Effect.Ref as Ref
%uses FRP.Poll as Poll
%uses Pages.Admin.Dashboard as Pages.Admin.Dashboard
%uses Pages.CreateItem as Pages.CreateItem
%uses Pages.CreateTransaction as Pages.CreateTransaction
%uses Pages.DeleteItem as Pages.DeleteItem
%uses Pages.EditItem as Pages.EditItem
%uses Pages.Feed.Monitor as Pages.Feed.Monitor
%uses Pages.LiveView as Pages.LiveView
%uses Pages.Login as Pages.Login
%uses Pages.Manager.Dashboard as Pages.Manager.Dashboard
%uses Pages.Registers as Pages.Registers
%uses Pages.Stock.Interface as Pages.Stock.Interface
%uses Pages.TransactionHistory as Pages.TransactionHistory
%uses Route
%uses Routing.Duplex
%uses Routing.Hash
%uses Services.AuthService
%uses Types.Session
%uses Types.UUID

%untested main

main :: Effect Unit
  ! authPoll starts as SignedOut. setAuth writes the Ref and pushes the Poll.
  ! The auth push comes before the route push. Route.nav rebuilds on an auth change and its links learn the current route from the route push that follows.
  ! pageFor draws a fresh SKU for the Create route on every render of that route.
  ! The Login route while signed in shows the live view.
  ~ no callers in scanned roots

%decision SessionDecidesWhatIsRendered
  what:    Every render reads the auth state first: signed out shows the login page whatever the route says; signed in shows the page for the route
  why:     The session is asked for once at boot (GET /auth/me). Until the answer arrives nothing is rendered; the route matcher only records the route. After boot the route in the URL is rendered, so a reload on /#/transaction/create returns to the sale page. Signing in or out renders the current route again. Signing in on the /#/login route goes to /#/ instead. A session that cannot be read (no cookie, an expired cookie, a response that does not decode, an unknown role) is signed out. No dev user stands in for a real one.
  affects: main

%decision PagesLoadTheirOwnData
  what:    main starts no data loads; each page reads what it needs when it is mounted
  why:     Main used to launch a loader and push its result into a Poll the page subscribed to. A loader that finished before the page subscribed lost its result, because a plain Poll does not replay. Pages now hold their data in useHot or UI.Remote.useRemote cells, which do replay, and start loading from UI.Remote.onMount.
  affects: main

%decision PagesRegisterCleanupThroughOnLeave
  what:    A page that opens a stream or socket hands its close action to onLeave; main runs every registered action before each render
  why:     Deku has no unmount hook in the version used here. Without this each visit to the stock room would leave an EventSource open. Browsers allow about six connections per host over HTTP/1.1.
  affects: main

%open_issue NoRouteGuardByCapability
  what:     A signed-in user who types a URL for a page their role cannot use still gets that page's shell
  why:      Route.nav hides the link, and the backend refuses the page's requests with 403, which the page shows as text. Wanted: pageFor checks the same capability Route.navLinks uses and shows a plain refusal.
  affects:  main



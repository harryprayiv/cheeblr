%mod Domain.SaleRules

%ext DerivingStrategies, OverloadedStrings

%uses Data.Text
%uses qualified Data.Text as T

data PaymentError
  = NonPositiveAmount Int
  | TenderedBelowAmount Int Int
  -- ^ amount, then tendered
  deriving stock (Eq, Show)

paymentErrorText :: PaymentError -> Text
  ? tested by: Test.Domain.SaleRulesSpec.spec

changeDue
  :: Int
  -- ^ payment amount
  -> Int
  -- ^ tendered
  -> Either PaymentError Int
  ! Left for amount <= 0 or tendered < amount; otherwise tendered - amount
  ! amounts are cents
  > consumed by: Service.Sale.addPayment
  ? tested by: Test.Domain.SaleRulesSpec.spec

finalizeProblems
  :: Int
  -- ^ number of items on the sale
  -> Int
  -- ^ sale total
  -> Int
  -- ^ sum of payments
  -> [Text]
  ! returns every reason a sale cannot be completed; empty list means it can
  ! arguments: number of lines, total, amount paid
  ! the shortfall message is only produced when the sale has lines
  ! paid > total is allowed
  ! the frontend has a parallel function UI.Transaction.Model.finalizeBlockers that must agree with this one
  > consumed by: DB.Transaction.finalizeTransaction (under the sale row lock)
  > consumed by: Effect.TransactionDb.finalizeProblemsFor (in-memory interpreter)
  ? tested by: Test.Domain.SaleRulesSpec.spec

formatCents :: Int -> Text
  ! for messages only: 1999 -> "$19.99"
  ? tested by: Test.Domain.SaleRulesSpec.spec



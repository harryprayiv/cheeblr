=== BEGIN Pages/Admin/Tabs/FeedMonitor.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Pages/Admin/Tabs/FeedMonitor.purs
%mod Pages.Admin.Tabs.FeedMonitor

%uses Prelude
%uses Config.Network
%uses Data.Array
%uses Data.Int
%uses Data.Maybe
%uses Data.Number.Format
%uses Data.Tuple.Nested
%uses Deku.Control
%uses Deku.Core
%uses Deku.DOM as D
%uses Deku.DOM.Attributes as DA
%uses Deku.DOM.Listeners as DL
%uses Deku.Do as Deku
%uses Deku.Hooks
%uses Effect
%uses Effect.Class.Console as Console
%uses Effect.Ref as Ref
%uses Types.Feed
%uses UI.Leave
%uses Utils.WebSocket
%uses Yoga.JSON

%untested maxFrames, formatPrice, feedMonitor, renderFrame

maxFrames :: Int
  ~ called by: Pages.Admin.Tabs.FeedMonitor.feedMonitor

formatPrice :: Int -> String
  ~ called by: Pages.Admin.Tabs.FeedMonitor.renderFrame

feedMonitor :: OnLeave -> Nut
  ! intent: Subscribe to the public inventory feed via WebSocket, render frames as they arrive
  ! effects: IO (WebSocket connection, JSON parsing)
  ! WebSocket URL derives from currentConfig.apiBaseUrl by toWsUrl rewriting https:// to wss://.
  ! Frame parsing failures are logged (Console.warn) but not surfaced to the UI.
  ! No automatic reconnect; user must click Connect again if the connection drops.
  ! Each connection's close action is registered with onLeave, so leaving the page closes the socket.
  ! Pressing Connect twice opens two sockets. Both are closed on leave.
  ~ called by: Pages.Feed.Monitor.page, Pages.Admin.Dashboard.page

renderFrame :: FeedFrame -> Nut
  ~ called by: Pages.Admin.Tabs.FeedMonitor.feedMonitor

%decision InMemoryFeedFrameRingBuffer
  what:    Feed frames are accumulated in component state up to maxFrames (100); older frames are dropped
  why:     Feed traffic can be high-volume; unbounded growth would exhaust browser memory. 100 is large enough to inspect recent activity but small enough to render without slowdown. If durable inspection is needed, the backend's feed history endpoints are the right path.
  affects: feedMonitor

%decision ConnRefSentinelForRaceCondition
  what:    connRef holds Just conn while the WebSocket is intended to be open; the onMessage handler checks this Ref before pushing frames
  why:     Without the check, a message that arrives in flight after disconnect would still update component state, causing stale UI. setting connRef to Nothing in onClose / disconnect button breaks the race window. PureScript's WebSocket API doesn't synchronously cancel pending callbacks on close; this Ref-based gate is the manual fix.
  affects: feedMonitor



=== BEGIN Server/Middleware/Tracing.hs ===

%file /home/bismuth/git/cheeblr/backend/src/Server/Middleware/Tracing.hs
%mod Server.Middleware.Tracing

%ext OverloadedStrings

%uses qualified Data.Text.Encoding as TE
%uses qualified Data.Vault.Lazy as Vault
%uses Network.Wai
%uses System.IO.Unsafe
%uses Types.Trace

traceIdKey :: Vault.Key TraceId
  ! process-global Vault key for stashing the per-request TraceId
  ! NOINLINE pragma is REQUIRED; without it GHC may inline and create distinct Vault keys per call site
  ! documented WAI pattern; do not duplicate this trick elsewhere without thinking it through
  > consumed by: Server.Middleware.Tracing.tracingMiddleware (writes)
  > consumed by: Server.Middleware.Tracing.getTraceId (reads)
  ? no test references

tracingMiddleware :: Middleware
  ! intent: Ensure every request has a TraceId in the WAI vault and on the response
  ! ORDER: read X-Trace-Id header, parse OR generate fresh, insert in vault, run app, append response header
  ! header parse: Types.Trace.parseTraceId requires a UUID-shaped string; malformed headers fall back to a fresh ID
  ! client-supplied traces are TRUSTED; spoofing has no security impact (trace IDs are never used for authorization)
  ! response header X-Trace-Id is APPENDED, not replaced; if a downstream layer set it, both will appear
  ! spec: request without X-Trace-Id => fresh TraceId in vault, X-Trace-Id present on response
  ! spec: request with valid X-Trace-Id => same TraceId in vault and response
  ! spec: request with malformed X-Trace-Id => fresh TraceId in vault, malformed value DISCARDED
  > consumed by: App.runWithEnv (outermost middleware, runs on every request)
  ? tested by: Test.Server.Middleware.TracingSpec.wrappedApp, Test.Server.Middleware.TracingSpec.wrappedEchoApp

getTraceId :: Request -> Maybe TraceId
  ! Nothing if tracingMiddleware did not run before this handler (programmer error, not a runtime case)
  ! callers should treat Nothing as 'tracing disabled' rather than failing the request
  > consumed by: Effect.EventEmitter.runEventEmitterProd (stamps trace_id on every domain event)
  > consumed by: Katip log enrichment (every log line gets the trace_id)
  > consumed by: any handler that wants to surface trace_id in a response body or error
  ? tested by: Test.Server.Middleware.TracingSpec.traceEchoApp

%decision TraceIdViaWaiVault
  what:    Per-request TraceId stored in WAI Vault under a NOINLINE unsafePerformIO key
  why:     Servant handlers run in Handler with no convenient place to thread per-request context. Vault is the canonical mechanism in the WAI ecosystem. The same TraceId can be stamped on the outbound response and on every domain event written during the request, giving end-to-end traceability without changing handler signatures. traceIdKey is created via unsafePerformIO with a NOINLINE pragma. This is the documented WAI pattern but it's a global mutable resource — only ever create one per process.
  affects: traceIdKey, tracingMiddleware, getTraceId



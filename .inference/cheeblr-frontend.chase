%mod Types.Transaction.Sale

%uses Prelude
%uses Data.DateTime
%uses Data.Maybe
%uses Foreign
%uses Types.Primitives.Money
%uses Types.Primitives.Quantity
%uses Types.Transaction
%uses Types.UUID
%uses Yoga.JSON

data SaleType
  = StandardSale
  | Exchange
  | InventoryAdjustment
  | ManagerComp
  | Administrative

derive instance eqSaleType :: Eq SaleType

derive instance ordSaleType :: Ord SaleType

instance showSaleType :: Show SaleType where

instance writeForeignSaleType :: WriteForeign SaleType where

instance readForeignSaleType :: ReadForeign SaleType where

type Item =
  { itemId            :: UUID
  , itemTransactionId :: UUID
  , itemMenuItemSku   :: UUID
  , itemQuantity      :: SaleQuantity
  , itemPricePerUnit  :: SaleMoney
  , itemDiscounts     :: Array Discount
  , itemTaxes         :: Array Tax
  , itemSubtotal      :: SaleMoney
  , itemTotal         :: SaleMoney
  }

type Discount =
  { discountType       :: DiscountType
  , discountAmount     :: SaleMoney
  , discountReason     :: String
  , discountApprovedBy :: Maybe UUID
  }

type Tax =
  { taxCategory    :: TaxCategory
  , taxRate        :: Number
  , taxAmount      :: SaleMoney
  , taxDescription :: String
  }

type Payment =
  { paymentId                :: UUID
  , paymentTransactionId     :: UUID
  , paymentMethod            :: PaymentMethod
  , paymentAmount            :: SaleMoney
  , paymentTendered          :: SaleMoney
  , paymentChange            :: SaleMoney
  , paymentReference         :: Maybe String
  , paymentApproved          :: Boolean
  , paymentAuthorizationCode :: Maybe String
  }

type SaleTransaction =
  { saleId            :: UUID
  , saleStatus        :: TransactionStatus
  , saleCreated       :: DateTime
  , saleCompleted     :: Maybe DateTime
  , saleCustomerId    :: Maybe UUID
  , saleEmployeeId    :: UUID
  , saleRegisterId    :: UUID
  , saleLocationId    :: UUID
  , saleItems         :: Array Item
  , salePayments      :: Array Payment
  , saleSubtotal      :: SaleMoney
  , saleDiscountTotal :: SaleMoney
  , saleTaxTotal      :: SaleMoney
  , saleTotal         :: SaleMoney
  , saleKind          :: SaleType
  , saleIsVoided      :: Boolean
  , saleVoidReason    :: Maybe String
  , saleIsRefunded    :: Boolean
  , saleRefundReason  :: Maybe String
  , saleNotes         :: Maybe String
  }

%decision SaleSpecificMoneyAndQuantityTypes
  what:    Sale.Item uses SaleMoney and SaleQuantity rather than raw Discrete USD / Int; payments and totals likewise use SaleMoney
  why:     SaleMoney is a smart-constructor newtype that requires non-negative cents; refunds use the inverted RefundMoney type. Compile-time prevents accidentally placing refund amounts into a sale record or vice versa. All field-level money/qty types in Sale.* are SaleMoney/SaleQuantity; converting to refund is an explicit operation via Types.Primitives.Money.negateToRefund. See Types.Primitives.Money and Types.Primitives.Quantity for the smart constructor invariants. Alongside the money types, SaleType is an enum of StandardSale/Exchange/InventoryAdjustment/ManagerComp/Administrative (serialized as PascalCase via WriteForeign). It distinguishes the business purpose of a sale transaction: StandardSale drives the normal POS flow, the others are special-purpose. The backend sets the kind; every sale it starts is a StandardSale.
  affects: 



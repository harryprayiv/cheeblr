%file /home/bismuth/git/cheeblr/frontend/src/API/Auth.purs
%mod API.Auth

%uses Prelude
%uses API.Request
%uses API.Request as Request
%uses Data.Either
%uses Data.Maybe
%uses Effect.Aff
%uses Types.Session
%uses Types.UUID

%untested login, logout, validateSession

type LoginRequest =
  { loginUsername :: String
  , loginPassword :: String
  , loginRegisterId :: Maybe UUID
  }

type LoginResponse =
  { loginExpiresAt :: String
  , loginUser :: SessionResponse
  }

-- A successful login sets the HttpOnly session cookie. The page never sees
-- the token.

login :: LoginRequest -> Aff (Either ApiError LoginResponse)
  ! POST /auth/login. A successful answer sets the HttpOnly session cookie and returns the session (user id, name, role, capabilities).
  ! A wrong username or password is Refused 401 with the text 'Invalid username or password'. Too many attempts is refused with its own text.
  ! loginRegisterId is always sent as Nothing by Pages.Login.
  ~ called by: Pages.Login.page

logout :: Aff (Either ApiError Unit)
  ! POST /auth/logout, which answers with no body. Main.signOut ignores the result and signs the browser out locally either way.
  ~ called by: Main.main

validateSession :: Aff (Either ApiError SessionResponse)
  ! GET /auth/me. Refused 401 when the browser holds no valid session cookie.
  ! Called once, by Main at boot.
  ~ called by: Main.main

%decision AuthCallsUseTheSharedRequestCore
  what:    login, logout and validateSession go through API.Request like every other call
  why:     They used raw fetch while API.Request required a user id for its Bearer header. That requirement is gone. credentials: Include, set in API.Request, is what lets the browser store the Set-Cookie from login and send the cookie afterwards.
  affects: login, logout, validateSession



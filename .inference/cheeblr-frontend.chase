getRegisters :: Aff (Either ApiError (Array Register))
  ! GET /register returns every register. Any signed-in user may call it.
  ~ called by: Pages.Registers.page

getRegister :: UUID -> Aff (Either ApiError Register)
  ! Refused 404 'Register not found' for an unknown id.
  ~ called by: Pages.CreateTransaction.load

createRegister :: Register -> Aff (Either ApiError Register)
  ! POST /register with a whole Register record. Refused 403 without capCanManageRegisters.
  ~ called by: Pages.Registers.page

openRegister :: UUID -> OpenRegisterRequest -> Aff (Either ApiError Register)
  ! POST /register/open/<id> with the starting cash in cents. The opener is the session user.
  ! Refused 409 'Register is already open' for an open register.
  ~ called by: Pages.Registers.page

closeRegister
  :: UUID -> CloseRegisterRequest -> Aff (Either ApiError CloseRegisterResult)
  ! POST /register/close/<id> with the counted cash in cents.
  ! The result's variance is the expected drawer amount minus the counted cash. A positive variance means cash is missing.
  ! Refused 409 for a register that is already closed.
  ~ called by: Pages.Registers.page

%decision RegisterCallsHaveOneCallerEach
  what:    createRegister, openRegister and closeRegister are called only by Pages.Registers; getRegister only by Pages.CreateTransaction.load
  why:     Nothing creates or opens a register as a side effect any more. The backend requires capCanManageRegisters for create and update, capCanOpenRegister for open and capCanCloseRegister for close. Pages.Registers shows each control by the same capability.
  affects: createRegister, openRegister, closeRegister, getRegister


=== BEGIN API/Request.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/API/Request.purs
%mod API.Request

%uses Prelude
%uses Config.Network
%uses Data.Either
%uses Data.Maybe
%uses Effect.Aff
%uses Effect.Exception
%uses Fetch
%uses Fetch.Yoga.Json
%uses Foreign
%uses Yoga.JSON

%untested request, url, get, getAbsolute, post, postEmpty, postUnit, put
%untested delete, deleteUnit

type URL = String

-- What can go wrong with one request.
--   Refused:     the server answered with a status outside 200 to 299. Carries
--                the status and the response body as text.
--   Unreachable: fetch itself failed (network, CORS, TLS).
--   Undecodable: the server answered 2xx and the body did not decode.

data ApiError
  = Refused Int String
  | Unreachable String
  | Undecodable String

derive instance eqApiError :: Eq ApiError

instance showApiError :: Show ApiError where

status :: ApiError -> Maybe Int
  ! Just the HTTP status for Refused, Nothing for Unreachable and Undecodable.
  ~ called by: API.Request.isRefusal
  ? tested by: Test.Wire.spec

isRefusal :: Int -> ApiError -> Boolean
  ! True only for Refused with exactly the given status. Unreachable and Undecodable are never a refusal.
  ~ called by: Pages.CreateTransaction.load, UI.Transaction.CreateTransaction.saleIsStale, Services.CurrentSale.resume
  ? tested by: Test.Wire.spec

describe :: ApiError -> String
  ! A refusal shows the response body as the backend wrote it. A refusal with an empty body names the HTTP status instead.
  ! Used for every error message the screens show.
  ~ called by: UI.Inventory.DeleteItem.deleteItem, UI.Remote.useRemote, Pages.Stock.Interface.page, Pages.CreateTransaction.load, Main.main, Pages.TransactionHistory.page, Pages.Login.page, Pages.Registers.page, +3 more
  ? tested by: Test.Wire.spec

request
  :: forall a
   . Method
  -> String
  -> Maybe String
  -> (Aff Foreign -> Aff a)
  -> Aff (Either ApiError a)
  ~ called by: API.Request.get, API.Request.getAbsolute, API.Request.post, API.Request.postEmpty, API.Request.postUnit, API.Request.put, API.Request.delete, API.Request.deleteUnit

url :: URL -> String
  ~ called by: API.Request.get, API.Request.post, API.Request.postEmpty, API.Request.postUnit, API.Request.put, API.Request.delete, API.Request.deleteUnit

get :: forall a. ReadForeign a => URL -> Aff (Either ApiError a)
  ~ called by: API.Register.getRegisters, API.Refund.getAllRefunds, API.Sale.getAllSales, API.Manager.getActivity, API.Admin.getSnapshot, API.Refund.getRefund, API.Register.getRegister, API.Sale.getSale, +10 more

getAbsolute :: forall a. ReadForeign a => String -> Aff (Either ApiError a)
  ! Takes a full URL instead of a path under apiBaseUrl. Used for the configured inventory endpoint in HttpMode.
  ~ called by: API.Inventory.fetchInventoryFromHttp

post
  :: forall req res
   . WriteForeign req
  => ReadForeign res
  => URL
  -> req
  -> Aff (Either ApiError res)
  ~ called by: API.Inventory.writeInventory, GraphQL.API.Inventory.gqlPost, API.Manager.getDailyReport, API.Sale.voidSale, API.Register.createRegister, API.Stock.cancelPull, API.Manager.overrideVoid, API.Auth.login, +9 more

postEmpty :: forall a. ReadForeign a => URL -> Aff (Either ApiError a)
  ! POST with no request body and a decoded response. Used by clear, finalize and the stock pull actions.
  ~ called by: API.Stock.acceptPull, API.Stock.startPull, API.Stock.fulfillPull, API.Stock.retryPull, API.SaleCommand.clear, API.SaleCommand.finalize

postUnit :: URL -> Aff (Either ApiError Unit)
  ! For routes that answer with no body (POST /auth/logout answers 204). The response body is not read.
  ~ called by: API.Auth.logout

put
  :: forall req res
   . WriteForeign req
  => ReadForeign res
  => URL
  -> req
  -> Aff (Either ApiError res)
  ~ called by: API.Inventory.updateInventory

delete :: forall a. ReadForeign a => URL -> Aff (Either ApiError a)
  ~ called by: API.Inventory.deleteInventory, API.SaleCommand.removeItem, API.SaleCommand.removePayment

deleteUnit :: URL -> Aff (Either ApiError Unit)
  ~ called by: API.Admin.revokeSession

%decision OneStatusCheckingCore
  what:    Every request goes through one private function, request, which checks the HTTP status before decoding the body
  why:     It replaced ten near-identical helpers, most of which decoded the body whatever the status was. A refusal from the backend is usually plain text. Decoding it as JSON turned the backend's message into a parse error. The public helpers (get, getAbsolute, post, postEmpty, postUnit, put, delete, deleteUnit) differ only in method, body and whether a response body is read.
  affects: get, getAbsolute, post, postEmpty, postUnit, put, delete, deleteUnit

%decision ErrorsAreTyped
  what:    Every helper returns Either ApiError a. ApiError is Refused status body, Unreachable message or Undecodable message
  why:     The backend answers 400, 403, 404 and 409 with different meanings on sale writes. Screens branch on the status with isRefusal and show the backend's own text with describe. Unreachable means fetch itself failed (network, CORS, TLS). Undecodable means a 2xx answer whose body did not decode. UI.Remote.useRemote takes these values and stores describe of the error in RemoteData's Failure.
  affects: status, isRefusal, describe

%decision CookieIsTheOnlyCredential
  what:    Requests are sent with credentials: Include and no Authorization header. No API function takes a user id
  why:     The backend authenticates by the HttpOnly session cookie. Its cookie middleware puts the session token into the Authorization header itself. The backend refuses a user id in the Authorization header with 401 (nix/sale-checks/auth.sh checks this). A GET sends only Accept. Content-Type is sent only with a body.
  affects: get, post, put, delete

%open_issue SessionExpiryIsNotNoticed
  what:     A 401 in the middle of a session is shown as an error message on the page that made the request; the app stays in the signed-in state
  why:      Main asks for the session once at boot. Nothing watches later responses for 401. Wanted: a Refused 401 from any request signs the browser out and shows the login page.
  affects:  describe



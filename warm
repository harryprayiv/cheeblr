#!/usr/bin/env bash
# Build here and push the closure into blade's attic cache, so blade's CI runner
# finds everything already built rather than compiling GHC output on two cores.
#
# This is the inverse of nix.buildMachines: blade depends on nothing and never
# delegates. A warm cache is an optimisation. If winsmuth is off, blade builds
# slowly rather than failing.
set -euo pipefail

CACHE="${CACHE:-neoblade}"
targets=("${@:-.#backend .#frontend}")

echo "building: ${targets[*]}"
# shellcheck disable=SC2068
paths=$(nix build --no-link --print-out-paths ${targets[@]})

echo "pushing $(wc -l <<<"$paths") closures to ${CACHE}"
# --jobs 4: the default is conservative and this is a LAN transfer, not an
# upload to a CDN.
attic push --jobs 4 "$CACHE" $paths

echo "done"
%file /home/bismuth/git/cheeblr/frontend/src/Config/LiveView.purs
%mod Config.LiveView

%uses Prelude
%uses Data.Tuple
%uses Data.Tuple.Nested
%uses Config.Network

%untested defaultConfig

data QueryMode = JsonMode | HttpMode | GqlMode

derive instance eqQueryMode :: Eq QueryMode

derive instance ordQueryMode :: Ord QueryMode

instance Show QueryMode where

type FetchConfig =
  { apiEndpoint :: String
  , jsonPath :: String
  , corsHeaders :: Boolean
  }

-- | Unified configuration for LiveView

type LiveViewConfig =
  { sortFields :: Array (Tuple SortField SortOrder)
  , hideOutOfStock :: Boolean
  , mode :: QueryMode
  , refreshRate :: Int
  , screens :: Int
  , fetchConfig :: FetchConfig
  }

-- | Sorting types

data SortField
  = SortByOrder
  | SortByName
  | SortByCategory
  | SortBySubCategory
  | SortBySpecies
  | SortBySKU
  | SortByPrice
  | SortByQuantity

data SortOrder = Ascending | Descending

type SortConfig =
  { sortFields :: Array (Tuple SortField SortOrder)
  }

defaultConfig :: FetchConfig
  ~ called by: Config.LiveView.defaultViewConfig

defaultViewConfig :: LiveViewConfig
  ! Default sort: Quantity descending, then Category ascending, then Species descending. Multi-field comparator from Types.Inventory.compareMenuItems.
  ! hideOutOfStock defaults to false (out-of-stock items rendered, marked as 0 stock).
  ! refreshRate is 5000ms but is not currently used anywhere; LiveView relies on poll updates, not polling.
  ~ called by: Pages.LiveView.page, Pages.CreateTransaction.load, UI.Transaction.CreateTransaction.saleScreen
  ? tested by: Test.Inventory.spec

%decision GqlModeAsDefaultQueryMode
  what:    defaultViewConfig.mode = GqlMode; the LiveView page reaches for GraphQL by default rather than REST or static JSON
  why:     GraphQL is the most expressive of the three (lets the UI pick exactly the fields it needs). JsonMode is the offline fallback (reads ./inventory.json); HttpMode is the REST path. Changing mode currently requires editing defaultViewConfig source; no runtime switch. See API.Inventory.QueryModeDispatchInFetchInventory for the dispatch logic.
  affects: defaultViewConfig


=== BEGIN Config/Network.purs ===

%file /home/bismuth/git/cheeblr/frontend/src/Config/Network.purs
%mod Config.Network

%untested localConfig, networkConfig, currentConfig

type EnvironmentConfig =
  { apiBaseUrl :: String
  , appOrigin :: String
  }

-- Local development configuration (localhost)

localConfig :: EnvironmentConfig
  ~ called by: Config.Network.currentConfig

networkConfig :: EnvironmentConfig
  ~ no callers in scanned roots

currentConfig :: EnvironmentConfig
  ! Always returns localConfig in the current source. Edit this binding to switch environments.
  ! Other modules import currentConfig and use it for apiBaseUrl and appOrigin (sent as the CORS Origin header).
  ~ called by: Config.LiveView.defaultConfig, Config.LiveView.defaultViewConfig, API.Manager.activityStreamUrl, Pages.Admin.Tabs.FeedMonitor.feedMonitor, API.Admin.logStreamUrl, API.Admin.eventStreamUrl, API.Stock.queueStreamUrl, API.Request.url

%open_issue CurrentConfigIsHardcodedNoEnvSelection
  what:     currentConfig = localConfig is a hardcoded source-level binding; switching to networkConfig requires editing this file
  why:      No build-time or runtime mechanism for environment selection. When deploying to a non-localhost target, currentConfig must be edited by hand and the bundle rebuilt. A clean fix would inject the config via a foreign import from a generated JS module, or sniff via window.location.host. Symptom of getting it wrong: API calls go to the wrong host, CORS rejects everything, login fails silently with confusing 'network error' messages.
  blocking: clean multi-environment deploy
  affects:  currentConfig

%open_issue HttpsRequiredForLocalhost
  what:     localConfig hardcodes https:// for both apiBaseUrl and appOrigin, which requires a working dev certificate for localhost
  why:      localConfig sets apiBaseUrl and appOrigin to https://localhost URLs. With an untrusted dev certificate the browser drops the Set-Cookie from /auth/login and refuses to send cookies cross-origin, and the console stays silent. Symptom: login returns 2xx, then /auth/me returns 401. Mixing http and https between apiBaseUrl and appOrigin also breaks CORS preflight. The repo's mkcert-style tooling creates the certificate, and a fresh clone has to run it before login works.
  blocking: a clean first-time-clone dev experience
  affects:  localConfig, networkConfig



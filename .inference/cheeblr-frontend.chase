%file /home/bismuth/git/cheeblr/frontend/src/UI/Transaction/Model.purs
%mod UI.Transaction.Model

%uses Prelude
%uses Data.Array
%uses Data.Foldable
%uses Data.Maybe
%uses Data.String
%uses Types.Inventory
%uses Types.Primitives.Money
%uses Types.Primitives.Quantity
%uses Types.Transaction
%uses Types.UUID
%uses Utils.Formatting

data Activity
  = Idle
  | AddingItem
  | RemovingItem
  | AddingPayment
  | RemovingPayment
  | Clearing
  | Finalizing
  | StartingSale

derive instance Eq Activity

type Filters =
  { search :: String
  , category :: Maybe ItemCategory
  }

type Totals =
  { subtotal :: Int
  , discount :: Int
  , tax :: Int
  , total :: Int
  }

isBusy :: Activity -> Boolean
  ! any Activity other than Idle; every button on the screen is disabled while busy
  ~ called by: UI.Transaction.ActionBar.actionBar, UI.Transaction.CartView.cartView, UI.Transaction.InventoryPicker.inventoryPicker, UI.Transaction.PaymentPanel.paymentPanel
  ? tested by: Test.TransactionModel.spec

activityLabel :: Activity -> String
  ~ called by: UI.Transaction.CreateTransaction.saleScreen
  ? tested by: Test.TransactionModel.spec

categoriesIn :: Inventory -> Array ItemCategory
  ~ called by: UI.Transaction.InventoryPicker.inventoryPicker
  ? tested by: Test.TransactionModel.spec

visibleItems :: Filters -> Inventory -> Array MenuItem
  ~ called by: UI.Transaction.InventoryPicker.inventoryPicker
  ? tested by: Test.TransactionModel.spec

quantityInCart
  :: forall r
   . UUID
  -> Array { itemMenuItemSku :: UUID, itemQuantity :: SaleQuantity | r }
  -> Int
  ! sums across lines with the same SKU
  ~ called by: UI.Transaction.InventoryPicker.inventoryPicker
  ? tested by: Test.TransactionModel.spec

availableToAdd :: MenuItem -> Int
  ! returns the item's quantity as reported. The backend inventory endpoints already subtract every open reservation, including this cart's, so nothing is subtracted here.
  ~ called by: UI.Transaction.Model.addBlocker
  ? tested by: Test.TransactionModel.spec

addBlocker :: Int -> MenuItem -> Maybe String
  ! checks in order: requested <= 0 gives "Quantity must be greater than 0"; availableToAdd <= 0 gives "Out of stock"; requested > available gives "Only N available"
  ! client-side hint only: backend DB.Transaction.addTransactionItem makes the real decision and answers 400 on InsufficientInventory
  ~ called by: UI.Transaction.InventoryPicker.inventoryPicker
  ? tested by: Test.TransactionModel.spec

totals
  :: forall r
   . { saleSubtotal :: SaleMoney
     , saleDiscountTotal :: SaleMoney
     , saleTaxTotal :: SaleMoney
     , saleTotal :: SaleMoney
     | r
     }
  -> Totals
  ~ no callers in scanned roots
  ? tested by: Test.TransactionModel.spec

paidCents :: forall r. Array { paymentAmount :: SaleMoney | r } -> Int
  ~ called by: UI.Transaction.Model.remainingCents
  ? tested by: Test.TransactionModel.spec

remainingCents
  :: forall r rp
   . { saleTotal :: SaleMoney
     , salePayments :: Array { paymentAmount :: SaleMoney | rp }
     | r
     }
  -> Int
  ~ called by: UI.Transaction.ActionBar.actionBar, UI.Transaction.Model.finalizeBlockers
  ? tested by: Test.TransactionModel.spec

isOpen :: TransactionStatus -> Boolean
  ~ called by: UI.Transaction.ActionBar.actionBar, UI.Transaction.PaymentPanel.paymentPanel, UI.Transaction.Model.canResume, UI.Transaction.Model.finalizeBlockers
  ? tested by: Test.TransactionModel.spec

canResume
  :: forall r
   . UUID
  -> UUID
  -> { saleStatus :: TransactionStatus
     , saleEmployeeId :: UUID
     , saleRegisterId :: UUID
     | r
     }
  -> Boolean
  ! True when the sale is open, was opened by the given user and is on the given register. Used by Services.CurrentSale.
  ~ called by: Services.CurrentSale.resume
  ? tested by: Test.TransactionModel.spec

voidable :: TransactionStatus -> Boolean
  ! True for Created, InProgress and Completed. Mirrors the backend, which refuses to void a voided or refunded sale.
  ~ called by: Pages.TransactionHistory.page
  ? tested by: Test.TransactionModel.spec

refundable :: TransactionStatus -> Boolean
  ! True for Completed only. Mirrors the backend.
  ~ called by: Pages.TransactionHistory.page
  ? tested by: Test.TransactionModel.spec

finalizeBlockers
  :: forall r ri rp
   . { saleStatus :: TransactionStatus
     , saleItems :: Array { | ri }
     , salePayments :: Array { paymentAmount :: SaleMoney | rp }
     , saleTotal :: SaleMoney
     | r
     }
  -> Array String
  ! must agree with the backend's Domain.SaleRules.finalizeProblems; an empty array enables Process Payment
  ~ called by: UI.Transaction.ActionBar.actionBar, UI.Transaction.CreateTransaction.saleScreen
  ? tested by: Test.TransactionModel.spec

%decision SaleIsNeverEditedLocally
  what:    The pure functions here only read the sale the backend returned; the screen has no local cart, no local totals and no tax arithmetic
  why:     Every action returns the whole SaleTransaction from the backend and the screen replaces its copy. Functions take open record rows so tests can pass small records.
  affects: totals, remainingCents, finalizeBlockers, quantityInCart

%decision RefundedIsAClosedStatus
  what:    isOpen is false for Refunded, and finalizeBlockers reports 'Transaction has been refunded'
  why:     Matches the backend: a refunded sale keeps its row with status REFUNDED, accepts no further writes, and cannot be voided.
  affects: isOpen, finalizeBlockers

%open_issue FinalizeBlockersNotTiedToBackendRules
  what:     finalizeBlockers is a hand-kept copy of backend Domain.SaleRules.finalizeProblems; no shared fixture or test makes the two agree
  why:      The backend is the authority and refuses finalize with 409 and its own reasons. If the two lists differ, the button is enabled and the request is refused, or the button is disabled for a sale the backend would accept. Wanted: golden JSON cases (sale in, reasons out) checked by both the Haskell and the PureScript suites.
  affects:  finalizeBlockers, isOpen

%open_issue OverpaymentIsInvisible
  what:     remainingCents clamps at 0, so a sale whose payments exceed the total looks the same as one paid exactly
  why:      The backend does not record or refuse an overpayment either; what should happen (refuse, or record change due) is an undecided sale rule.
  affects:  remainingCents, paidCents, finalizeBlockers

%open_issue VoidAndRefundRulesAreAClientCopy
  what:     voidable and refundable are hand-kept copies of the backend's void and refund rules
  why:      The backend decides and answers 409; a wrong copy shows a button whose request is refused, or hides one that would work. They belong in the same golden fixtures as finalizeBlockers.
  affects:  voidable, refundable



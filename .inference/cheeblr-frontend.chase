data UserRole
  = Customer
  | Cashier
  | Manager
  | Admin

derive instance eqUserRole      :: Eq UserRole

derive instance ordUserRole     :: Ord UserRole

derive instance genericUserRole :: Generic UserRole _

instance showUserRole :: Show UserRole where

instance Enum UserRole where

instance Bounded UserRole where

instance BoundedEnum UserRole where

instance writeForeignUserRole :: WriteForeign UserRole where

instance readForeignUserRole :: ReadForeign UserRole where

type AuthenticatedUser =
  { auUserId     :: UUID
  , auUserName   :: String
  , auEmail      :: Maybe String
  , auRole       :: UserRole
  , auLocationId :: Maybe UUID
  , auCreatedAt  :: DateTime
  }

type UserCapabilities =
  { capCanViewInventory       :: Boolean
  , capCanCreateItem          :: Boolean
  , capCanEditItem            :: Boolean
  , capCanDeleteItem          :: Boolean
  , capCanProcessTransaction  :: Boolean
  , capCanVoidTransaction     :: Boolean
  , capCanRefundTransaction   :: Boolean
  , capCanApplyDiscount       :: Boolean
  , capCanManageRegisters     :: Boolean
  , capCanOpenRegister        :: Boolean
  , capCanCloseRegister       :: Boolean
  , capCanViewReports         :: Boolean
  , capCanViewAllLocations    :: Boolean
  , capCanManageUsers         :: Boolean
  , capCanViewCompliance      :: Boolean
  -- New in Phase 1
  , capCanFulfillOrders       :: Boolean
  , capCanViewAdminDashboard  :: Boolean
  , capCanPerformAdminActions :: Boolean
  }

emptyCapabilities :: UserCapabilities
  ! All boolean fields are false; Services.AuthService.capabilities returns it for a signed-out browser.
  ! Also the base for the *Capabilities records via record update syntax.
  ~ called by: Services.AuthService.capabilities, Types.Auth.customerCapabilities, Types.Auth.cashierCapabilities, Types.Auth.managerCapabilities
  ? tested by: Test.Auth.spec

customerCapabilities :: UserCapabilities
  ~ called by: Types.Auth.capabilitiesForRole

cashierCapabilities :: UserCapabilities
  ~ called by: Types.Auth.capabilitiesForRole

managerCapabilities :: UserCapabilities
  ~ called by: Types.Auth.capabilitiesForRole

adminCapabilities :: UserCapabilities
  ~ called by: Types.Auth.capabilitiesForRole

capabilitiesForRole :: UserRole -> UserCapabilities
  ! Total function over UserRole; no Maybe or Either needed.
  ! Each branch returns the corresponding *Capabilities top-level value, not a fresh record. Modifying *Capabilities propagates.
  ~ no callers in scanned roots
  ? tested by: Test.Auth.sessionFor, Test.Auth.spec, Test.JsonContract.spec

hasCapability :: (UserCapabilities -> Boolean) -> UserCapabilities -> Boolean
  ~ no callers in scanned roots

%decision FourRoleHierarchyWithMonotonicCapabilities
  what:    UserRole has a strict ordering Customer < Cashier < Manager < Admin; each higher role's capabilities are a strict superset of the next-lower role's
  why:     Models the typical retail hierarchy where higher roles can do everything lower roles can plus more. Allows whenRoleAtLeast in UI.Components.AuthGuard to gate features by minimum role. Capabilities are explicit per-role rather than computed from the ordering, so the table-of-truth is searchable in source. Adding a new capability requires touching all four *Capabilities records, which forces an explicit choice about which roles get it.
  affects: customerCapabilities, cashierCapabilities, managerCapabilities, adminCapabilities, capabilitiesForRole

%open_issue CapabilityTableIsAClientCopy
  what:     capabilitiesForRole and the four per-role records are a hand-kept copy of the backend's capability table, and the app no longer reads them
  why:      The app takes capabilities from the session the backend sends. Only the tests use this table, to build sessions per role. No fixture ties the copy to the backend table.
  affects:  capabilitiesForRole, cashierCapabilities, managerCapabilities, adminCapabilities



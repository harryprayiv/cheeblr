%uses GraphQL.Schema
%uses Types.Auth
%uses qualified Types.Inventory as TI

%untested resolveInventory, resolveMenuItem, resolveCreateMenuItem, resolveUpdateMenuItem, resolveDeleteMenuItem, rootResolver

data Query (m :: * -> *) = Query
  { inventory :: m [MenuItemGql]
  , menuItem :: MenuItemArgs -> m (Maybe MenuItemGql)
  }
  deriving (Generic)

instance (Typeable m) => GQLType (Query m)

data Mutation (m :: * -> *) = Mutation
  { createMenuItem :: CreateMenuItemArgs -> m MutationResponseGql
  , updateMenuItem :: UpdateMenuItemArgs -> m MutationResponseGql
  , deleteMenuItem :: DeleteMenuItemArgs -> m MutationResponseGql
  }
  deriving (Generic)

instance (Typeable m) => GQLType (Mutation m)

menuItemToGql :: TI.MenuItem -> MenuItemGql
  ~ clause: TI.MenuItem {TI.sort = s, TI.sku = u, TI.brand = b, TI.name = n, TI.price = p, TI.measure_unit = mu, TI.per_package =...
  ~ called by: GraphQL.Resolvers.resolveInventory, GraphQL.Resolvers.resolveMenuItem
  ? tested by: Test.GraphQL.IntegrationSpec.spec, Test.GraphQL.ResolversSpec.spec

strainLineageToGql :: TI.StrainLineage -> StrainLineageGql
  ~ clause: TI.StrainLineage {TI.thc = a, TI.cbg = b, TI.strain = st, TI.creator = cr, TI.species = sp, TI.dominant_terpene = dt,...
  ~ called by: GraphQL.Resolvers.menuItemToGql
  ? tested by: Test.GraphQL.IntegrationSpec.spec, Test.GraphQL.ResolversSpec.spec

gqlInputToMenuItem :: MenuItemInputGql -> Either Text TI.MenuItem
  ~ clause: MenuItemInputGql {sku = skuTxt, sort = srt, brand = br, name = nm, price = pr, measure_unit = mu, per_package = pp, q...
  ~ fails: "Invalid UUID: "
  ~ called by: GraphQL.Resolvers.resolveCreateMenuItem, GraphQL.Resolvers.resolveUpdateMenuItem
  ? tested by: Test.GraphQL.IntegrationSpec.spec, Test.GraphQL.ResolversSpec.spec, Test.GraphQL.ResolversSpec.expectRight

gqlInputToStrainLineage :: StrainLineageInputGql -> TI.StrainLineage
  ~ clause: StrainLineageInputGql {thc = a, cbg = b, strain = st, creator = cr, species = sp, dominant_terpene = dt, terpenes = t...
  ~ called by: GraphQL.Resolvers.gqlInputToMenuItem
  ? tested by: Test.GraphQL.ResolversSpec.spec

resolveInventory :: DBPool -> UserCapabilities -> ResolverQ () IO [MenuItemGql]
  ~ called by: GraphQL.Resolvers.rootResolver

resolveMenuItem :: DBPool -> UserCapabilities -> MenuItemArgs -> ResolverQ () IO (Maybe MenuItemGql)
  ~ clause: pool _caps MenuItemArgs {sku = skuTxt}
  ~ called by: GraphQL.Resolvers.rootResolver

resolveCreateMenuItem :: DBPool -> UserCapabilities -> CreateMenuItemArgs -> ResolverM () IO MutationResponseGql
  ~ clause: pool caps CreateMenuItemArgs {input = inp}
  ~ called by: GraphQL.Resolvers.rootResolver

resolveUpdateMenuItem :: DBPool -> UserCapabilities -> UpdateMenuItemArgs -> ResolverM () IO MutationResponseGql
  ~ clause: pool caps UpdateMenuItemArgs {input = inp}
  ~ called by: GraphQL.Resolvers.rootResolver

resolveDeleteMenuItem :: DBPool -> UserCapabilities -> DeleteMenuItemArgs -> ResolverM () IO MutationResponseGql
  ~ clause: pool caps DeleteMenuItemArgs {sku = skuTxt}
  ~ called by: GraphQL.Resolvers.rootResolver

rootResolver :: DBPool -> AuthenticatedUser -> RootResolver IO () Query Mutation Undefined
  ~ called by: Server.inventoryServer



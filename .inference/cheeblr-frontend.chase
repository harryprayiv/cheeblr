%file /home/bismuth/git/cheeblr/frontend/src/Types/UUID.purs
%mod Types.UUID

%uses Prelude
%uses Data.Array
%uses Data.Either
%uses Data.Generic.Rep
%uses Data.Int as Int
%uses Data.Int
%uses Data.Int.Bits
%uses Data.Maybe
%uses Data.Newtype
%uses Data.String
%uses Data.String as String
%uses Data.String.Regex
%uses Data.String.Regex.Flags
%uses Effect
%uses Effect.Random
%uses Foreign
%uses Yoga.JSON
%uses Data.Validation.Semigroup

%untested randomInt, padStart

newtype UUID = UUID String

derive instance genericUUID :: Generic UUID _

derive instance newtypeUUID :: Newtype UUID _

derive instance eqUUID :: Eq UUID

derive instance ordUUID :: Ord UUID

instance showUUID :: Show UUID where

instance writeForeignUUID :: WriteForeign UUID where

instance readForeignUUID :: ReadForeign UUID where

randomInt :: Int -> Int -> Effect Int
  ~ called by: Types.UUID.genUUID

padStart :: Int -> String -> String
  ~ called by: Types.UUID.genUUID

uuidToString :: UUID -> String
  ~ no callers in scanned roots
  ? tested by: Test.UUID.spec

parseUUID :: String -> Maybe UUID
  ! Strict regex match: 8-4-4-4-12 lowercase hex with hyphens. Uppercase hex is rejected (would need a flag change).
  ! Returns Nothing on any deviation from the canonical form; the regex doesn't validate version/variant bits.
  ! Used by ReadForeign instance and form validators.
  ~ called by: Types.Location.parseLocationId, Services.RegisterService.chosenRegisterId, Services.CurrentSale.remembered, Types.UUID.validateUUID, UI.Form.Parser.uuid
  ? tested by: Test.UUID.spec

emptyUUID :: UUID
  ~ no callers in scanned roots
  ? tested by: Test.UUID.spec

genUUID :: Effect UUID
  ! Sets version 4 (random) by ORing 0x4000 into the time_hi field.
  ! Sets variant 10xx by ORing 0x8000 into clock_seq.
  ! Output format matches parseUUID's expected pattern (lowercase hex, hyphens at standard positions).
  ! See openIssue GenUUIDNotCryptographicallySecure.
  ~ called by: Pages.CreateItem.page, Services.RegisterService.newRegister, Main.main
  ? tested by: Test.UUID.spec

validateUUID :: String -> String -> V (Array String) UUID
  ! Trims input before parsing; returns V (Array String) UUID with field-name-prefixed error.
  ! Used by Types.Inventory.validateMenuItem and similar form validators.
  ~ no callers in scanned roots
  ? tested by: Test.UUID.spec

%decision ManualUUIDv4ImplementationNotCryptoRandomUUID
  what:    genUUID is a manual UUIDv4 builder using Effect.Random.random, NOT crypto.randomUUID or any cryptographically secure source
  why:     Effect.Random.random is Math.random under the hood; not suitable for cryptographic purposes. For inventory item UUIDs, transaction UUIDs, and similar non-secret identifiers, this is fine. A safer implementation would foreign import crypto.randomUUID() from the browser's WebCrypto API (available in all modern browsers since ~2022). Switching is a one-line foreign import; the only reason it hasn't happened is nobody has needed cryptographic UUIDs yet.
  affects: genUUID, randomInt

%open_issue GenUUIDNotCryptographicallySecure
  what:     genUUID's randomness comes from Math.random; an attacker observing some UUIDs could in principle predict subsequent ones
  why:      PRNG predictability matters if UUIDs are ever used as authorization tokens, password reset links, or share-link nonces. Currently genUUID is used for transaction IDs, item IDs, payment IDs, register IDs - all server-validated, so predictability is not currently a vulnerability vector. Becomes a problem the moment a future feature uses a UUID as a capability token.
  blocking: any future use of genUUID for security-sensitive identifiers
  affects:  genUUID



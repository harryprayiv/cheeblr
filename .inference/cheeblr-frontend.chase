%file /home/bismuth/git/cheeblr/frontend/src/Utils/WebSocket.purs
%mod Utils.WebSocket

%uses Prelude
%uses Data.String as S
%uses Effect

%untested openWebSocket, closeWebSocket, WSConnection, _openWebSocket, _closeWebSocket

type WSCallbacks =
  { onMessage :: String -> Effect Unit
  , onOpen    :: Effect Unit
  , onClose   :: Effect Unit
  , onError   :: Effect Unit
  }

%foreign
foreign import data WSConnection :: Type
  ~ no callers in scanned roots

foreign import _openWebSocket
  :: String                  -- URL
  -> (String -> Effect Unit) -- onMessage
  -> Effect Unit             -- onOpen
  -> Effect Unit             -- onClose
  -> Effect Unit             -- onError
  -> Effect WSConnection
  ~ called by: Utils.WebSocket.openWebSocket

foreign import _closeWebSocket :: WSConnection -> Effect Unit
  ~ called by: Utils.WebSocket.closeWebSocket

openWebSocket :: String -> WSCallbacks -> Effect WSConnection
  ! Foreign import _openWebSocket takes individual callbacks (onMessage, onOpen, onClose, onError); the PS wrapper bundles them as WSCallbacks for ergonomics.
  ! WSConnection is opaque (foreign import data); the only operation is closeWebSocket.
  ! No automatic reconnect; consumers must observe onClose / onError and reopen if desired.
  ~ called by: Pages.Admin.Tabs.FeedMonitor.feedMonitor

closeWebSocket :: WSConnection -> Effect Unit
  ~ called by: Pages.Admin.Tabs.FeedMonitor.feedMonitor

toWsUrl :: String -> String
  ! Rewrites https:// -> wss:// and http:// -> ws://; otherwise passes through unchanged.
  ! Used to derive WS endpoints from the same currentConfig.apiBaseUrl that REST uses, so dev/prod switches automatically.
  ~ called by: Pages.Admin.Tabs.FeedMonitor.feedMonitor
  ? tested by: Test.WebUtils.spec

